<!-- Dark colour theme. Every key must also exist in the other theme file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window and content background -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1E2227" />
    <!-- Side panels, status bar, tool bar -->
    <SolidColorBrush x:Key="PanelBrush" Color="#252A30" />
    <!-- Text boxes, combo boxes, lists -->
    <SolidColorBrush x:Key="ControlBrush" Color="#2D333B" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#353C45" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#414A55" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#4D5866" />
    <!-- Borders of inputs and buttons -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A525D" />
    <!-- Splitters and separators -->
    <SolidColorBrush x:Key="BorderBrushLight" Color="#3A414A" />
    <!-- Focus, progress, check marks -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
    <!-- Selected list and menu items -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
    <!-- Items under the mouse -->
    <SolidColorBrush x:Key="HoverBrush" Color="#2F3A47" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EB" />
    <!-- Hints and secondary text -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA4AF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#646C76" />
    <!-- Menu bar -->
    <SolidColorBrush x:Key="MenuBrush" Color="#252A30" />
    <!-- Drop-downs, menus, tool tips -->
    <SolidColorBrush x:Key="PopupBrush" Color="#2B3138" />
    <!-- Unselected tab headers -->
    <SolidColorBrush x:Key="TabHeaderBrush" Color="#2B3138" />
    <!-- Arrows and check marks -->
    <SolidColorBrush x:Key="GlyphBrush" Color="#D0D4DA" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#23282E" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A525D" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5D6774" />
    <!-- Selected text in text boxes -->
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#3D7BD9" />

    <!-- System colours used by the stock control templates that are not restyled -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D333B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252A30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#353C45" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#4A525D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#646C76" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#264F78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B3138" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#252A30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2B3138" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E6E8EB" />
</ResourceDictionary>
