<Window x:Class="PathForge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PathForge.App.ViewModels"
        xmlns:controls="clr-namespace:PathForge.App.Controls"
        xmlns:l="clr-namespace:PathForge.App.Localization"
        Title="{Binding Title}"
        Icon="/Assets/PathForge.ico"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportDrawingCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportGcodeCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
        <KeyBinding Key="Home" Command="{Binding ZoomToFitCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <!-- Shared fields of every operation -->
        <DataTemplate x:Key="CommonOperationFields" DataType="{x:Type vm:OperationViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Название', En='Name'}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'Название операции — только для вас; в G-code оно не попадает', En='Operation name — just for you; it is not written to the G-code'}" />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Включена', En='Enabled'}" IsChecked="{Binding Enabled}" ToolTip="{l:Tr 'Выключенные операции не попадают в G-code и не участвуют в симуляции', En='Disabled operations are skipped in the G-code and in the simulation'}" />
                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Инструмент', En='Tool'}" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding DataContext.Tools, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ToolId}" ToolTip="{l:Tr 'Инструмент этой операции: фреза, гравёр или лазер; его параметры задают траекторию', En='The tool of this operation: a mill, V-bit or laser; its parameters shape the toolpath'}" />
                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Глубина, мм', En='Depth, mm'}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Depth}" ToolTip="{l:Tr 'Глубина обработки: на сколько фреза опускается ниже Z0 заготовки', En='Machining depth: how far the tool goes below the work Z0'}" />
                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Начало (Z), мм', En='Start (Z), mm'}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StartZ}" ToolTip="{l:Tr 'Высота начала обработки: 0 — верх заготовки, отрицательное — ниже поверхности', En='Height where machining starts: 0 — stock top, negative — below the surface'}" />
                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Контуры', En='Contours'}" />
                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,3">
                    <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Назначить выделенные', En='Assign selected'}"
                            ToolTip="{l:Tr 'Заменяет контуры этой операции на те, что сейчас выделены на чертеже. Выделите нужные контуры кликом (Ctrl — несколько) и нажмите кнопку.', En='Replaces the contours of this operation with the ones currently selected on the drawing. Select contours with a click (Ctrl adds more), then press the button.'}"
                            Command="{Binding DataContext.AssignSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding ContourCount, Mode=OneWay}" /> <Run Text="{l:Tr 'шт.', En='pcs'}" /></TextBlock>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryFields" DataType="{x:Type vm:OperationViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Врезание', En='Entry'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Способ', En='Method'}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.EntryModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Entry}" ToolTip="{l:Tr 'Как фреза входит в материал на глубину: вертикально или по наклонной рампе', En='How the tool enters the material: straight down or along a gentle ramp'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Угол рампы, °', En='Ramp angle, °'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RampAngle}" ToolTip="{l:Tr 'Для 3018: 2–5°', En='For a 3018: 2–5°'}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Контур', En='Profile'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Сторона', En='Side'}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.ProfileSides}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Side}" ToolTip="{l:Tr 'С какой стороны контура резать: снаружи, внутри или по самой линии', En='Which side of the contour to cut: outside, inside or right on the line'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Припуск, мм', En='Allowance, mm'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Allowance}" ToolTip="{l:Tr 'Припуск: сколько материала остаётся; отрицательный — резать глубже контура', En='Allowance: how much material to leave; a negative value cuts past the contour'}" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,3,0,0" Content="{l:Tr 'Дообработка по симуляции', En='Rest machining by simulation'}" IsChecked="{Binding RestFromStock}"
                              ToolTip="{l:Tr 'PathForge симулирует операции выше по списку и режет контур только там, где фреза ещё встретит материал: проходы глубже, чем прорезала прошлая операция, припуск, оставленный черновым проходом, места, куда крупная фреза не пролезла. Перемычки сохраняются, подвод по дуге не используется.', En='PathForge simulates the operations above in the list and cuts the contour only where the tool still meets material: passes deeper than the previous operation went, the allowance a roughing pass left, places the larger cutter could not get into. Tabs are kept, arc lead-ins are not used.'}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Допуск остатков, мм', En='Rest tolerance, mm'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RestTolerance}" IsEnabled="{Binding RestFromStock}"
                             ToolTip="{l:Tr 'Только для дообработки по симуляции: остаток тоньше этого не обрабатывается заново (0,03–0,1 мм).', En='Rest machining by simulation only: material thinner than this is not machined again (0.03–0.1 mm).'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Подрезка углов', En='Corner relief'}" />
                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CornerReliefs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CornerRelief}"
                              ToolTip="{l:Tr 'Круглая фреза оставляет во внутренних углах скругление своего радиуса, и квадратный шип не входит в паз. Dogbone — фреза заходит в угол по биссектрисе, T-bone — вдоль длинной стороны (ухо спрятано в ней). Подрезаются только углы, куда фреза не достаёт: углы отверстий при «Внутри», углы пазов детали при «Снаружи». Для шипов, пазов и вставок.', En='A round cutter leaves a fillet of its radius in inner corners, and a square finger does not go into the slot. Dogbone — the cutter goes into the corner along the bisector, T-bone — along the longer side (the ear hides in it). Only the corners the cutter cannot reach are relieved: corners of holes with “Inside”, corners of notches in the part with “Outside”. For fingers, slots and inlays.'}" />

                </Grid>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EntryFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Перемычки (удерживают деталь)', En='Tabs (hold the part)'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Количество', En='Count'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TabCount}" ToolTip="{l:Tr 'Сколько перемычек удержат вырезанную деталь', En='How many tabs hold the cut-out part'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина, мм', En='Width, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TabWidth}" ToolTip="{l:Tr 'Ширина каждой перемычки, мм', En='Width of each tab, mm'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Высота, мм', En='Height, mm'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TabHeight}" ToolTip="{l:Tr 'Высота перемычки над дном реза: тоньше — легче отломить деталь', En='Tab height above the cut bottom: thinner is easier to break off'}" />
                </Grid>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Подвод и отвод', En='Lead-in and lead-out'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Подвод', En='Lead-in'}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.LeadModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Lead}" ToolTip="{l:Tr 'Как фреза подходит к контуру: прямо или по касательной дуге без следа', En='How the tool approaches the contour: straight or along a tangent arc without a mark'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Радиус дуги, мм', En='Arc radius, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LeadRadius}" ToolTip="{l:Tr 'Радиус дуги подвода и отвода, мм', En='Radius of the lead-in and lead-out arc, mm'}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{l:Tr 'Фреза заходит на контур и уходит с него по касательной дуге со стороны отхода — без следа в месте врезания. Только для «Снаружи» и «Внутри».', En='The tool enters and leaves the contour along a tangent arc from the waste side — no mark at the entry point. Only for “Outside” and “Inside”.'}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VCarveOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'V-карвинг', En='V-carving'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг, мм', En='Step, mm'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StepMm}" ToolTip="{l:Tr 'Меньше — чище середина буквы, но дольше расчёт. Обычно 0,05–0,1', En='Smaller gives a cleaner letter centre but takes longer to compute. Usually 0.05–0.1'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг по дну, мм', En='Flat bottom step, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlatStepMm}" ToolTip="{l:Tr 'Расстояние между проходами на плоском дне; 0 — 80 % кончика фрезы', En='Distance between passes on the flat bottom; 0 — 80 % of the tip'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{l:Tr 'Нужна V-фреза. Глубина в каждой точке зависит от ширины буквы: края остаются острыми, по середине получается «V». «Глубина» ограничивает погружение — широкие места получают плоское дно. Шаг по глубине берётся из инструмента.', En='Needs a V-bit. The depth at each point depends on the letter width: edges stay sharp, the middle gets a “V”. “Depth” limits the plunge — wide areas get a flat bottom. The step-down comes from the tool.'}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Текст', En='Text'}" VerticalAlignment="Top" />
                <TextBox Grid.Row="0" Grid.Column="1" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="{l:Tr 'Текст надписи: буквы станут контурами, к которым можно добавить операцию', En='The text: the letters become contours that can get an operation'}" />
                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шрифт', En='Font'}" />
                <ComboBox Grid.Row="1" Grid.Column="1" ToolTip="{l:Tr 'Шрифт надписи; начните печатать название, чтобы найти', En='The font of the text; start typing its name to find it'}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          ItemsSource="{Binding DataContext.Fonts, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedItem="{Binding Font}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding FontStatus}" />
                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Высота букв, мм', En='Letter height, mm'}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HeightMm}" ToolTip="{l:Tr 'Высота заглавных букв', En='Height of capital letters'}" />
                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'X, мм', En='X, mm'}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding X}" ToolTip="{l:Tr 'Начало базовой линии первой строки (в чертеже)', En='Start of the baseline of the first line (in the drawing)'}" />
                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Y, мм', En='Y, mm'}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Y}" ToolTip="{l:Tr 'Базовая линия первой строки', En='Baseline of the first line'}" />
                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Выравнивание', En='Alignment'}" />
                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{x:Static vm:Choices.TextAlignments}" ToolTip="{l:Tr 'Выравнивание строк относительно начальной точки (X, Y)', En='Alignment of the lines relative to the start point (X, Y)'}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Alignment}" />
                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Между буквами, мм', En='Letter spacing, mm'}" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LetterSpacing}" ToolTip="{l:Tr 'Дополнительный зазор между буквами, мм', En='Extra gap between letters, mm'}" />
                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Между строками, ×', En='Line spacing, ×'}" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding LineSpacing}" ToolTip="{l:Tr 'Межстрочный интервал в долях высоты букв', En='Line spacing as a fraction of the letter height'}" />
                <StackPanel Grid.Row="9" Grid.Column="1">
                    <CheckBox Content="{l:Tr 'Кернинг (пары вроде «AV» ближе)', En='Kerning (pairs like “AV” closer)'}" IsChecked="{Binding Kerning}" ToolTip="{l:Tr 'Сдвигать пары букв вроде «AV» ближе друг к другу', En='Move letter pairs like “AV” closer together'}" />
                    <CheckBox Content="{l:Tr 'Зеркально (низ платы, штамп)', En='Mirrored (board bottom, stamp)'}" IsChecked="{Binding Mirrored}" ToolTip="{l:Tr 'Зеркальная надпись — для нижнего слоя платы или штампа', En='Mirrored text — for a board bottom layer or a stamp'}" />
                </StackPanel>
                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Слой', En='Layer'}" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Layer}" ToolTip="{l:Tr 'Слой чертежа, в который попадут буквы', En='The drawing layer the letters go to'}" />
                <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'По дуге, радиус мм', En='On an arc, radius mm'}" />
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ArcRadius}"
                         ToolTip="{l:Tr 'Текст по окружности этого радиуса; 0 — по прямой. Плюс — по верху окружности, буквы наружу (центр на радиус ниже точки X, Y). Минус — по низу, буквы стоят прямо и смотрят к центру (центр выше точки). Так делают круглые печати и надписи по краю тарелки; с выравниванием «по центру» надпись симметрична.', En='Text along a circle of this radius; 0 — straight. Plus — over the top of the circle, letters outwards (the centre is the radius below X, Y). Minus — along the bottom, letters upright facing the centre (the centre is above the point). This is how round stamps and plate rims are lettered; with “centre” alignment the text is symmetric.'}" />
                <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Visibility="{Binding IsVariable, Converter={StaticResource BoolToVisible}}" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Вариативный шрифт', En='Variable font'}" />
                    <DockPanel Margin="0,0,0,3">
                        <TextBlock Width="130" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Начертание', En='Style'}" />
                        <ComboBox ItemsSource="{Binding Instances}" DisplayMemberPath="Name" SelectedItem="{Binding Instance}"
                                  ToolTip="{l:Tr 'Готовые начертания шрифта (Light, Bold…): выставляют все оси разом. Оси ниже можно двигать и между ними.', En='Ready-made styles of the font (Light, Bold…): set every axis at once. The axes below can also be moved in between.'}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Width="130" DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                    <TextBox Width="60" DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding Value, Delay=300}" ToolTip="{l:Tr 'Значение оси', En='Axis value'}" />
                                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Delay=300}" VerticalAlignment="Center"
                                            ToolTip="{l:Tr 'Положение на оси вариативного шрифта: например, насыщенность (wght) или ширина (wdth) букв', En='Position on the variable font axis: for example the weight (wght) or width (wdth) of the letters'}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PocketOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Карман', En='Pocket'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Припуск, мм', En='Allowance, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Allowance}" ToolTip="{l:Tr 'Припуск: сколько материала остаётся; отрицательный — резать глубже контура', En='Allowance: how much material to leave; a negative value cuts past the contour'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Стратегия', En='Strategy'}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.PocketStrategies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Strategy}"
                              ToolTip="{l:Tr 'Кольцами — обычная выборка с перекрытием инструмента: в начале и в углах фреза режет почти всей шириной. Адаптивный — сначала трохоидами (петлями) прорезается канал по середине кармана, потом кольца расходятся от него маленьким шагом: фреза всё время снимает одинаково узкую полосу, без полного погружения по ширине даже в углах. Для слабого шпинделя 775 — меньше поломок фрез; шаг по глубине можно увеличить в 2–3 раза, а подачу — поднять.', En='Rings — classic clearing with the tool step-over: at the start and in corners the cutter cuts with almost its full width. Adaptive — first a channel along the middle of the pocket is opened with trochoids (loops), then rings spread from it by a small step: the cutter always takes an equally narrow strip, never its full width, not even in corners. For a weak 775 spindle — fewer broken cutters; the step-down can be 2–3 times larger and the feed higher.'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Нагрузка, % Ø', En='Load, % Ø'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AdaptiveStepOverPercent}"
                             ToolTip="{l:Tr 'Только для адаптивного кармана: ширина полосы, которую фреза снимает за проход, в процентах диаметра. 10–20 % — обычно; меньше — легче фрезе, но дольше. На изгибах шаг автоматически уменьшается, чтобы нагрузка не росла.', En='Adaptive pocket only: width of the strip the cutter takes per pass, percent of the diameter. 10–20 % is usual; less is easier on the cutter but takes longer. On bends the step is reduced automatically so that the load does not grow.'}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Дообработка после Ø', En='Rest after Ø'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RestFromDiameter}"
                             ToolTip="{l:Tr 'Дообработка: диаметр крупной фрезы, которая уже выбрала этот карман (0 — выключено). Тогда эта, меньшая, фреза проходит только там, куда крупная не достала: углы и узкие места, а не весь контур заново. Глубина — как у кармана крупной фрезы.', En='Rest machining: diameter of the larger cutter that already cleared this pocket (0 — off). This smaller cutter then goes only where the larger one could not reach: corners and narrow places, not the whole contour again. The depth is the same as for the larger cutter.'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Её припуск, мм', En='Its allowance, mm'}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RestFromAllowance}"
                             ToolTip="{l:Tr 'Припуск, который оставила крупная фреза (черновая с припуском): тогда мелкая пройдёт и вдоль всех стенок.', En='Allowance the larger cutter left (roughing with an allowance): the small cutter then also runs along all the walls.'}" />
                    <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,3,0,0" Content="{l:Tr 'Дообработка по симуляции', En='Rest machining by simulation'}" IsChecked="{Binding RestFromStock}"
                              ToolTip="{l:Tr 'PathForge симулирует операции выше по списку и выбирает карман только там, где материал ещё остался: углы и узкие места после крупной фрезы, припуск на стенках, глубина ниже, чем дошла прошлая операция. Не нужно вписывать диаметр крупной фрезы — поля «Дообработка после Ø» и «Её припуск» тогда не используются.', En='PathForge simulates the operations above in the list and clears the pocket only where material is still left: corners and narrow places after the larger cutter, allowance on the walls, depth below where the previous operation went. No need to enter the larger cutter diameter — “Rest after Ø” and “Its allowance” are not used then.'}" />
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Допуск остатков, мм', En='Rest tolerance, mm'}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding RestTolerance}" IsEnabled="{Binding RestFromStock}"
                             ToolTip="{l:Tr 'Только для дообработки по симуляции: остаток тоньше этого не обрабатывается заново (0,03–0,1 мм).', En='Rest machining by simulation only: material thinner than this is not machined again (0.03–0.1 mm).'}" />
                </Grid>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EntryFields}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Контуры внутри выбранных контуров становятся островами и не обрабатываются. Адаптивный карман всегда входит в материал по спирали.', En='Contours inside the selected contours become islands and are not machined. An adaptive pocket always enters the material with a helix.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DrillOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Сверление', En='Drilling'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг, мм (0 — сразу)', En='Peck, mm (0 — at once)'}" />
                    <TextBox Grid.Column="1" Text="{Binding PeckDepth}" ToolTip="{l:Tr 'Опускание за один раз (вывод стружки); 0 — сверлить сразу на всю глубину', En='Plunge per peck (chip clearing); 0 — drill the whole depth at once'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Пазы: шаг, % Ø', En='Slots: pitch, % Ø'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SlotPitchPercent}"
                             ToolTip="{l:Tr 'Пазы (овальные отверстия, G85 в сверловке) сверлятся рядом отверстий вдоль оси: расстояние между ними в процентах диаметра сверла. 30–50 % — стенки получаются ровнее. Сначала сверлится каждое второе отверстие, потом промежуточные — сверло не уводит в соседнее.', En='Slots (oblong holes, G85 in the drill file) are drilled as a row of holes along the axis: the distance between them in percent of the drill diameter. 30–50 % gives smoother walls. Every other hole is drilled first, then the ones between — the drill does not walk into the next hole.'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Сверлится центр каждой выбранной окружности и ряд отверстий вдоль каждого выбранного паза. Кнопка «Выбрать окружности» на панели инструментов выделяет все окружности. Паз ровнее фрезеровать: «+ Контур», сторона «Внутри»; если фреза равна ширине паза, она пройдёт по его оси.', En='The centre of every selected circle is drilled, and a row of holes along every selected slot. The “Select circles” button on the tool bar selects all circles. A slot is cleaner when milled: “+ Profile”, side “Inside”; a cutter as wide as the slot runs along its axis.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IsolationOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Изоляция дорожек', En='Trace isolation'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Проходов', En='Passes'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Passes}" ToolTip="{l:Tr 'Больше проходов — шире зазор вокруг меди', En='More passes — a wider gap around the copper'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Перекрытие, %', En='Overlap, %'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlapPercent}" ToolTip="{l:Tr 'Насколько проходы заходят друг на друга — меньше непрорезанных перемычек меди', En='How much the passes overlap — fewer un-cut copper bridges'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Выберите контуры меди (слой Gerber). Глубина для текстолита обычно 0,05–0,1 мм; ширина реза гравёра зависит от глубины. Неровность заготовки компенсируйте картой высот («Пульт» → «Карта высот»). Подробно — docs/pcb-milling.md.', En='Select the copper contours (Gerber layer). The depth for FR4 is usually 0.05–0.1 mm; the engraver cut width depends on the depth. Compensate an uneven board with a height map (“Control” → “Height map”). Details: docs/pcb-milling.md.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CopperClearingOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Удаление лишней меди', En='Removing excess copper'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Контур платы', En='Board outline'}" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Назначить выделенный', En='Assign selected'}"
                                ToolTip="{l:Tr 'Выделите на чертеже замкнутый контур платы (слой Edge_Cuts, GKO, GM1) и нажмите: медь снимается только внутри него (плюс поля). Без контура очищается прямоугольник вокруг меди.', En='Select the closed board outline on the drawing (Edge_Cuts, GKO, GM1 layer) and press: the copper is removed only inside it (plus the margin). Without an outline the rectangle around the copper is cleared.'}"
                                Command="{Binding DataContext.AssignBoardOutlineCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding BoardContourCount, Mode=OneWay}" /> <Run Text="{l:Tr 'шт.', En='pcs'}" /></TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Поля, мм', En='Margin, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Margin}" ToolTip="{l:Tr 'Насколько очищать за контуром платы (или за крайней медью): 1–2 мм, чтобы при обрезке платы по краю не осталось меди.', En='How far to clear beyond the board outline (or the outermost copper): 1–2 mm so that no copper is left at the edge when the board is cut out.'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Не ближе к меди, мм', En='Keep from copper, mm'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepDistance}"
                             ToolTip="{l:Tr 'Край фрезы не подходит к дорожкам ближе этого: эту полосу прорезает изоляция гравёром. Ставится сам — ширина изоляции минус 0,05 мм перекрытия. Больше ширины изоляции — между ними останется кольцо меди.', En='The mill edge comes no closer to the tracks than this: the engraver isolation cuts this band. Set by itself — the isolation width minus a 0.05 mm overlap. More than the isolation width leaves a ring of copper between them.'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Концевая фреза Ø1–2 мм снимает медь кольцами со всей платы, кроме полосы вокруг дорожек — её прорезает изоляция гравёром. В узких местах, куда фреза не пролезает, остаются островки меди: они отделены от дорожек. Глубина — как у изоляции (0,05–0,1 мм), неровность компенсируйте картой высот. Подробно — docs/pcb-milling.md.', En='An Ø1–2 mm end mill removes the copper in rings from the whole board except a band around the tracks — the engraver isolation cuts it. In narrow places the mill cannot get into, copper islands stay: they are separated from the tracks. The depth is as for the isolation (0.05–0.1 mm); compensate an uneven board with a height map. Details: docs/pcb-milling.md.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChamferOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Фаска V-фрезой', En='V-bit chamfer'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина фаски, мм', En='Chamfer width, mm'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ChamferWidth}"
                             ToolTip="{l:Tr 'Ширина скоса на поверхности. Глубина считается сама из угла V-фрезы: у 90° она равна ширине. Потай под винт: (Ø головки − Ø отверстия) / 2, V-фреза 90°.', En='Width of the bevel on the surface. The depth follows from the V-bit angle: with 90° it equals the width. Countersink for a screw: (head Ø − hole Ø) / 2, 90° V-bit.'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Где', En='Where'}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.ChamferSides}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Side}"
                              ToolTip="{l:Tr 'Снаружи — кромка детали (панели); внутри — край отверстия, потай под винт.', En='Outside — the edge of a part (panel); inside — the edge of a hole, a countersink for a screw.'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Поле «Глубина» не используется: глубина = ширина / tg(половины угла фрезы), за проходы по шагу инструмента. Кончик фрезы идёт на половину своей ширины от кромки. Фаску делайте до вырезки детали — пока заготовка закреплена.', En='The “Depth” field is not used: depth = width / tan(half the bit angle), in passes of the tool step-down. The tip runs half its width off the edge. Chamfer before cutting the part out — while the stock is still clamped.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HelixHoleOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Отверстия по спирали', En='Helical holes'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ø отверстия, мм', En='Hole Ø, mm'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HoleDiameter}" ToolTip="{l:Tr '0 — диаметр каждой выделенной окружности. Иначе все отверстия этого диаметра в центрах окружностей.', En='0 — the diameter of each selected circle. Otherwise all holes of this diameter at the circle centres.'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ø цековки, мм', En='Counterbore Ø, mm'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CounterboreDiameter}" ToolTip="{l:Tr 'Цековка под головку винта (0 — нет): M3 — 6,5 мм, M4 — 8 мм, M5 — 10 мм. Фрезеруется первой.', En='Counterbore for the screw head (0 — none): M3 — 6.5 mm, M4 — 8 mm, M5 — 10 mm. Milled first.'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Глубина цековки, мм', En='Counterbore depth, mm'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CounterboreDepth}" ToolTip="{l:Tr 'Высота головки винта + 0,3 мм: M3 — 3,3, M4 — 4,3.', En='Screw head height + 0.3 mm: M3 — 3.3, M4 — 4.3.'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Угол спирали, °', En='Helix angle, °'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RampAngle}" ToolTip="{l:Tr 'Наклон спирали: за виток фреза опускается на 2πR·tg(угла), но не больше шага инструмента. Для 3018: 2–5°.', En='Slope of the helix: per turn the cutter goes down 2πR·tan(angle), but no more than the tool step-down. For a 3018: 2–5°.'}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование', En='Cut direction'}" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Фреза опускается по спирали вдоль стенки — без вертикального врезания; отверстия больше двух диаметров фрезы выбираются кольцами от центра наружу, последнее кольцо чистовое. Быстрее и круглее кармана. Глубина — насквозь: толщина + 0,2 мм.', En='The cutter goes down along a helix by the wall — no straight plunge; holes larger than two cutter diameters are cleared in rings from the centre out, the last ring finishes. Faster and rounder than a pocket. Depth for a through hole: thickness + 0.2 mm.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FacingOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonOperationFields}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Торцовка (выравнивание поверхности)', En='Facing (surfacing)'}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'X, мм (левый край)', En='X, mm (left edge)'}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X}" ToolTip="{l:Tr 'Левый край области в координатах чертежа. Используется, когда контуры не назначены. В проекте без контуров (только выравнивание стола) этот угол и есть ноль X0 Y0.', En='Left edge of the area in drawing coordinates. Used when no contours are assigned. In a project without contours (surfacing only) this corner is the X0 Y0 zero.'}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Y, мм (нижний край)', En='Y, mm (bottom edge)'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Y}" ToolTip="{l:Tr 'Нижний край области в координатах чертежа (когда контуры не назначены).', En='Bottom edge of the area in drawing coordinates (when no contours are assigned).'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина, мм', En='Width, mm'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Width}" ToolTip="{l:Tr 'Размер области по X (когда контуры не назначены).', En='Size of the area in X (when no contours are assigned).'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Высота, мм', En='Height, mm'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Height}" ToolTip="{l:Tr 'Размер области по Y (когда контуры не назначены).', En='Size of the area in Y (when no contours are assigned).'}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Поля вокруг, мм', En='Margin, mm'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Margin}" ToolTip="{l:Tr 'Когда назначены контуры: на сколько область больше их габарита с каждой стороны.', En='When contours are assigned: how much larger than their bounding box the area is on each side.'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Строки', En='Lines'}" />
                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:Choices.RasterAxes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Axis}"
                              ToolTip="{l:Tr 'Направление проходов. Вдоль длинной стороны — меньше разворотов.', En='Direction of the passes. Along the long side — fewer turns.'}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Выход за край, % Ø', En='Overhang, % Ø'}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OverhangPercent}"
                             ToolTip="{l:Tr 'На сколько край фрезы выходит за область, в процентах диаметра. 50 — центр фрезы доходит до края (край и углы обработаны). Меньше 21 % — углы останутся. Больше 100 % — фреза полностью выходит за край перед разворотом.', En='How far the cutter edge goes past the area, percent of the diameter. 50 — the cutter centre reaches the edge (edges and corners are done). Below 21 % the corners stay. Above 100 % the cutter leaves the area completely before turning.'}" />
                    <Button Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3" Content="{l:Tr 'Всё поле станка', En='Whole machine area'}"
                            ToolTip="{l:Tr 'Область = всё рабочее поле станка из профиля (для 3018 — 300×180 мм), контуры снимаются. Для выравнивания жертвенного стола: ноль X0 Y0 — в левом нижнем углу хода станка.', En='Area = the whole work area from the machine profile (300×180 mm for a 3018), contours are cleared. For spoil board surfacing: X0 Y0 at the lower-left corner of the machine travel.'}"
                            Command="{Binding DataContext.FacingFromMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EntryFields}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Зигзагом снимается слой на «Глубину» за проходы по шагу инструмента. Перекрытие строк — из инструмента (40–70 %). Для стола: фреза для выравнивания или концевая Ø6, 0,1–0,3 мм за проход.', En='The zigzag removes the “Depth” in passes of the tool step-down. The line overlap comes from the tool (40–70 %). For a spoil board: a surfacing bit or a Ø6 end mill, 0.1–0.3 mm per pass.'}" />
            </StackPanel>
        </DataTemplate>

        <!-- Laser operations have no depth: name, tool and focus height only -->
        <DataTemplate x:Key="LaserCommonFields" DataType="{x:Type vm:OperationViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Название', En='Name'}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'Название операции — только для вас; в G-code оно не попадает', En='Operation name — just for you; it is not written to the G-code'}" />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Включена', En='Enabled'}" IsChecked="{Binding Enabled}" ToolTip="{l:Tr 'Выключенные операции не попадают в G-code и не участвуют в симуляции', En='Disabled operations are skipped in the G-code and in the simulation'}" />
                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Инструмент', En='Tool'}" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding DataContext.Tools, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ToolId}" ToolTip="{l:Tr 'Инструмент этой операции: фреза, гравёр или лазер; его параметры задают траекторию', En='The tool of this operation: a mill, V-bit or laser; its parameters shape the toolpath'}" />
                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фокус Z, мм', En='Focus Z, mm'}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartZ}" ToolTip="{l:Tr '0 — фокус выставлен на поверхности', En='0 — focused on the surface'}" />
                <CheckBox Grid.Row="4" Grid.Column="1" Content="{l:Tr 'Обдув (M8/M7)', En='Air assist (M8/M7)'}" IsChecked="{Binding AirAssist}"
                          ToolTip="{l:Tr 'Включить воздух на эту операцию: перед ней в G-code пишется M8 (или M7 — выбирается на вкладке «Станок»), после — M9. Обдув нужен при резке: сдувает дым и пламя, кромка не обугливается, линза не закапчивается. При гравировке обычно выключен: поток воздуха разносит копоть по поверхности. У лазерной операции включается сам при режиме «По линии» и выключается при заливке. Компрессор подключите к выходу охлаждения платы (Coolant / Flood).', En='Turn the air on for this operation: M8 (or M7 — chosen on the “Machine” tab) is written before it in the G-code, M9 after it. Air assist is for cutting: it blows away smoke and flames, the edge does not char, the lens stays clean. For engraving it is usually off: the air flow spreads soot over the surface. A laser operation switches it on by itself in the “On the line” mode and off for filling. Connect the pump to the coolant output of the board (Coolant / Flood).'}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LaserVectorOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LaserCommonFields}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Контуры', En='Contours'}" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Назначить выделенные', En='Assign selected'}"
                                ToolTip="{l:Tr 'Заменяет контуры этой операции на те, что сейчас выделены на чертеже. Выделите нужные контуры кликом (Ctrl — несколько) и нажмите кнопку.', En='Replaces the contours of this operation with the ones currently selected on the drawing. Select contours with a click (Ctrl adds more), then press the button.'}"
                                Command="{Binding DataContext.AssignSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding ContourCount, Mode=OneWay}" /> <Run Text="{l:Tr 'шт.', En='pcs'}" /></TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Режим', En='Mode'}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.LaserVectorModes}" ToolTip="{l:Tr 'Режим: рез по линии, заливка штриховкой или и то и другое', En='Mode: cutting on the line, hatch filling or both'}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Мощность, %', En='Power, %'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PowerPercent}" ToolTip="{l:Tr 'Мощность лазера в процентах от максимума', En='Laser power as a percentage of the maximum'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Скорость, мм/мин', En='Speed, mm/min'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Speed}" ToolTip="{l:Tr 'Скорость движения лазера: медленнее — глубже рез', En='Laser travel speed: slower cuts deeper'}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Проходов', En='Passes'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Passes}" ToolTip="{l:Tr 'Сколько раз повторить проход', En='How many times to repeat the pass'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Опускать Z за проход', En='Lower Z per pass'}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ZStepPerPass}" ToolTip="{l:Tr 'Для резки толстой фанеры: 0,3–0,5 мм; 0 — не опускать', En='For cutting thick plywood: 0.3–0.5 mm; 0 — do not lower'}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг заливки, мм', En='Fill spacing, mm'}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FillSpacing}" ToolTip="{l:Tr 'Расстояние между линиями штриховки: меньше — плотнее гравировка', En='Distance between hatch lines: smaller means a denser engraving'}" />
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Угол заливки, °', En='Fill angle, °'}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding FillAngle}" ToolTip="{l:Tr 'Угол линий штриховки в градусах', En='Angle of the hatch lines in degrees'}" />
                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина реза', En='Kerf'}" />
                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{x:Static vm:Choices.KerfCompensations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kerf}"
                              ToolTip="{l:Tr 'Луч выжигает полоску шириной 0,1–0,3 мм, и деталь выходит меньше, а отверстие больше. «Детали в размер» — наружные контуры отодвигаются наружу, отверстия внутрь на половину ширины реза; «Отверстия в размер» — наоборот (вставки, пазы под шип). Только для замкнутых контуров при резке по линии.', En='The beam burns away a strip 0.1–0.3 mm wide, so a part comes out smaller and a hole larger. “Parts to size” moves outer contours out and holes in by half the kerf; “Openings to size” does the opposite (inlays, slots for tenons). Only for closed contours burned on the line.'}" />
                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина реза, мм', En='Kerf width, mm'}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding KerfWidth}"
                             ToolTip="{l:Tr 'Вырежьте квадрат 20 мм, измерьте его: ширина реза = 20 − размер. Обычно 0,1–0,2 мм для диодного лазера.', En='Cut a 20 mm square and measure it: kerf = 20 − size. Usually 0.1–0.2 mm for a diode laser.'}" />
                    <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Микроперемычки', En='Micro-tabs'}" />
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TabCount}" IsEnabled="{Binding IsLine}"
                             ToolTip="{l:Tr 'Сколько перемычек оставить на каждом наружном контуре (0 — нет). На перемычке луч гаснет, и вырезанная деталь держится в листе: не выпадает сквозь решётку стола и не встаёт на ребро под соплом. Отверстия режутся без перемычек. После работы деталь выламывается, остаток зачищается шкуркой или ножом. 2–4 на деталь обычно хватает.', En='How many tabs to leave on each outer contour (0 — none). On a tab the beam goes off, so the cut part stays held in the sheet: it does not fall through the bed grid or tilt up under the nozzle. Holes are cut without tabs. After the job the part is broken out and the rest is sanded or trimmed with a knife. 2–4 per part is usually enough.'}" />
                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина перемычки, мм', En='Tab width, mm'}" />
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding TabWidth}" IsEnabled="{Binding IsLine}"
                             ToolTip="{l:Tr 'Сколько материала остаётся в перемычке; к разрыву в резе добавляется пятно лазера (диаметр инструмента). Фанера 3 мм: 0,3–0,5 мм; акрил: 0,2–0,3 мм.', En='How much material stays in a tab; the laser spot (tool diameter) is added to the gap in the cut. 3 mm plywood: 0.3–0.5 mm; acrylic: 0.2–0.3 mm.'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Начните с пробы на обрезке: фанера 3 мм режется лазером 5 Вт примерно за 3–6 проходов при 100 % и 150–250 мм/мин, лазером 10 Вт — за 1–2 прохода при 100 % и 200–300 мм/мин (с обдувом). Работайте в защитных очках и с вытяжкой.', En='Start with a test on scrap: 3 mm plywood is cut by a 5 W laser in about 3–6 passes at 100 % and 150–250 mm/min, by a 10 W laser in 1–2 passes at 100 % and 200–300 mm/min (with air assist). Wear safety glasses and use an exhaust.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LaserPcbOperationViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LaserCommonFields}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Медь', En='Copper'}" Visibility="{Binding ClearsAround, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Контуры', En='Contours'}" Visibility="{Binding ClearsInside, Converter={StaticResource BoolToVisible}}" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Назначить выделенные', En='Assign selected'}"
                                ToolTip="{l:Tr 'Заменяет контуры меди этой операции на выделенные на чертеже. Над ними краска останется, вокруг — будет выжжена. Отверстия внутри площадок тоже можно выделить: в их центре вытравится точка, по ней удобно сверлить.', En='Replaces the copper contours of this operation with the ones selected on the drawing. The paint stays over them and is burned around them. Holes inside pads may be selected too: an etched dot in their centre guides the drill.'}"
                                Command="{Binding DataContext.AssignSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding ContourCount, Mode=OneWay}" /> <Run Text="{l:Tr 'шт.', En='pcs'}" /></TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Что выжигать', En='What to burn'}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.LaserPcbClearings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Clearing}"
                              ToolTip="{l:Tr 'Полоса вокруг меди — как изоляция фрезой: быстро, остальная медь остаётся (меньше травить, меньше расход раствора). Вся лишняя медь — краска снимается со всей платы, кроме дорожек и площадок: дольше, но плата чище и легче паять. Внутри контуров — для платы с маской: выжечь маску в окнах над площадками (слой маски) или надписи по слою шелкографии.', En='Strip around the copper — like milled isolation: fast, the rest of the copper stays (less to etch, less etchant used). All excess copper — the paint is removed from the whole board except tracks and pads: slower, but the board is cleaner and easier to solder. Inside the contours — for a board with solder mask: burn the mask away in the openings over the pads (mask layer) or the markings of the silk screen layer.'}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина полосы, мм', En='Strip width, mm'}"
                               Visibility="{Binding ClearsStrip, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IsolationWidth}" Visibility="{Binding ClearsStrip, Converter={StaticResource BoolToVisible}}"
                             ToolTip="{l:Tr 'Ширина выжигаемой полосы вокруг меди (зазор между дорожкой и остальной медью). 0,5–1 мм: шире — меньше риск, что медь замкнётся, но дольше.', En='Width of the burned strip around the copper (the gap between a track and the rest of the copper). 0.5–1 mm: wider means less risk of shorts, but takes longer.'}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Контур платы', En='Board outline'}"
                               Visibility="{Binding ClearsAll, Converter={StaticResource BoolToVisible}}" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3" Visibility="{Binding ClearsAll, Converter={StaticResource BoolToVisible}}">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Назначить выделенный', En='Assign selected'}"
                                ToolTip="{l:Tr 'Выделите на чертеже замкнутый контур платы (слой Edge_Cuts, GKO, GM1) и нажмите: краска снимется только внутри него (плюс поля). Без контура очищается прямоугольник вокруг меди.', En='Select the closed board outline on the drawing (Edge_Cuts, GKO, GM1 layer) and press: the paint is removed only inside it (plus the margin). Without an outline the rectangle around the copper is cleared.'}"
                                Command="{Binding DataContext.AssignBoardOutlineCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding BoardContourCount, Mode=OneWay}" /> <Run Text="{l:Tr 'шт.', En='pcs'}" /></TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Поля, мм', En='Margin, mm'}"
                               Visibility="{Binding ClearsAll, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Margin}" Visibility="{Binding ClearsAll, Converter={StaticResource BoolToVisible}}"
                             ToolTip="{l:Tr 'Насколько очищать за контуром платы (или за крайней медью): 1–2 мм, чтобы при обрезке платы по краю не осталось меди.', En='How far to clear beyond the board outline (or the outermost copper): 1–2 mm so that no copper is left at the edge when the board is cut out.'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Мощность, %', En='Power, %'}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PowerPercent}" ToolTip="{l:Tr 'Мощность лазера. Краску снимают обычно на 80–100 %: чем быстрее скорость, тем больше нужна мощность. Подберите тест-сеткой на окрашенном обрезке.', En='Laser power. Paint is usually removed at 80–100 %: the faster the speed, the more power it needs. Find it with the test card on a painted scrap.'}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Скорость, мм/мин', En='Speed, mm/min'}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Speed}" ToolTip="{l:Tr 'Скорость движения луча. Для 5–10 Вт обычно 800–2000 мм/мин. Слишком медленно — краска спекается и перегревается текстолит, слишком быстро — краска остаётся.', En='Beam travel speed. For 5–10 W usually 800–2000 mm/min. Too slow — the paint bakes and the board overheats; too fast — paint is left behind.'}" />
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Проходов', En='Passes'}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Passes}" ToolTip="{l:Tr 'Сколько раз выжечь всё заново. 2 прохода надёжнее одного: второй снимает остатки и копоть.', En='How many times to burn everything again. 2 passes are safer than one: the second removes leftovers and soot.'}" />
                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг линий, мм', En='Line spacing, mm'}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding LineSpacing}" ToolTip="{l:Tr 'Расстояние между соседними линиями луча. Должно быть меньше пятна лазера (диаметр инструмента): 0,05–0,08 мм. Больше — между линиями останутся полоски краски.', En='Distance between neighbouring beam lines. Must be smaller than the laser spot (tool diameter): 0.05–0.08 mm. Larger — stripes of paint stay between the lines.'}" />
                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Угол штриховки, °', En='Hatch angle, °'}"
                               Visibility="{Binding Hatches, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding FillAngle}" Visibility="{Binding Hatches, Converter={StaticResource BoolToVisible}}"
                             ToolTip="{l:Tr 'Направление линий штриховки в градусах от оси X. 0 — вдоль X (обычно у 3018 ось X легче и быстрее).', En='Direction of the hatch lines in degrees from the X axis. 0 — along X (on a 3018 the X axis is usually lighter and faster).'}" />
                    <CheckBox Grid.Row="10" Grid.Column="1" Content="{l:Tr 'Крест-накрест (каждый 2-й проход под 90°)', En='Cross-hatch (every 2nd pass at 90°)'}" IsChecked="{Binding CrossHatch}"
                              Visibility="{Binding Hatches, Converter={StaticResource BoolToVisible}}"
                              ToolTip="{l:Tr 'Второй проход идёт поперёк первого: не остаётся полосок краски между линиями. Нужно 2 прохода и больше.', En='The second pass runs across the first: no stripes of paint between the lines. Needs 2 passes or more.'}" />
                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Расширить медь, мм', En='Grow copper, mm'}" Visibility="{Binding ClearsAround, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Расширить, мм', En='Grow, mm'}" Visibility="{Binding ClearsInside, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding CopperOffset}" ToolTip="{l:Tr 'Сделать медь шире (плюс) или уже (минус). Раствор подъедает дорожки с боков примерно на 0,02–0,05 мм — можно заранее расширить их на столько же. Если дорожки вышли тоньше нужного — увеличьте. Внутри контуров: плюс расширяет окна маски и линии шелкографии — тонкие линии уже пятна иначе не выжигаются.', En='Make the copper wider (plus) or narrower (minus). The etchant eats the tracks from the sides by about 0.02–0.05 mm — you can widen them by as much in advance. If the tracks came out too thin, increase it. Inside the contours: plus widens the mask openings and the silk screen lines — lines thinner than the spot are not burned otherwise.'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Плата покрывается чёрной матовой краской, лазер выжигает её там, где медь нужно стравить. Размер пятна — диаметр лазера в инструменте: луч не подходит к меди ближе половины пятна. Медь сверху не зеркалится, нижний слой — зеркалить. Подробно — docs/pcb-laser.md; маска и шелкография («Внутри контуров») — docs/pcb-stencil-mask.md. Работайте в очках и с вытяжкой: дым краски вреден.', En='The board is painted black matte, the laser burns the paint away where the copper must be etched. The spot size is the laser tool diameter: the beam keeps half a spot away from the copper. The top layer is not mirrored, the bottom one is. Details: docs/pcb-laser.md; mask and silk screen (“Inside the contours”): docs/pcb-stencil-mask.md. Wear safety glasses and use an exhaust: paint fumes are harmful.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LaserRasterOperationViewModel}">
