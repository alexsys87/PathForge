                    <TextBlock Grid.Row="15" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Чистовая', En='Finishing'}" />
                    <ComboBox Grid.Row="15" Grid.Column="1" ItemsSource="{x:Static vm:Choices.ReliefFinishings}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Finishing}"
                              ToolTip="{l:Tr 'Строки хороши на пологих местах, уровни — на крутых стенках', En='Lines work well on gentle slopes, levels on steep walls'}" />
                    <TextBlock Grid.Row="16" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг уровней Z, мм', En='Z level step, mm'}" />
                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding WaterlineStepZ}" ToolTip="{l:Tr 'Расстояние между уровнями waterline', En='Distance between waterline levels'}" />
                    <TextBlock Grid.Row="17" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Фрезерование уровней', En='Level cut direction'}" />
                    <ComboBox Grid.Row="17" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CutDirections}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction}" ToolTip="{l:Tr 'Направление движения фрезы: попутное режет чище, встречное надёжнее на рыхлом материале', En='Tool travel direction: climb cuts cleaner, conventional is safer on soft material'}" />
                    <TextBlock Grid.Row="18" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Уровни круче, °', En='Levels steeper than, °'}" />
                    <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding SteepAngle}" ToolTip="{l:Tr 'Waterline только там, где поверхность круче этого угла (от горизонтали); пологие места остаются строкам. 0 — уровни везде. Обычно 30–45° вместе с чистовой «Строки и уровни».', En='Waterline only where the surface is steeper than this angle (from the horizontal); gentle areas are left to the lines. 0 — levels everywhere. Usually 30–45° with the “Lines and levels” finishing.'}" />
                    <CheckBox Grid.Row="19" Grid.Column="1" Content="{l:Tr 'Только внутри контуров', En='Only inside the contours'}" IsChecked="{Binding LimitToContours}"
                              ToolTip="{l:Tr 'Обрабатывать рельеф только внутри назначенных операции замкнутых контуров (центр фрезы не выходит за контур, вложенные контуры — отверстия). Выделите контуры и нажмите «Назначить выделенные».', En='Machine the relief only inside the closed contours assigned to the operation (the tool centre stays inside, nested contours are holes). Select contours and press “Assign selected”.'}" />
                    <CheckBox Grid.Row="20" Grid.Column="1" Content="{l:Tr 'Дообработка остатков (меньшей фрезой)', En='Rest machining (smaller tool)'}" IsChecked="{Binding RestMachining}"
                              ToolTip="{l:Tr 'PathForge симулирует все операции перед этой и сравнивает остаток заготовки с моделью: эта фреза (обычно меньшая) проходит только там, где над моделью остался материал — узкие впадины, углы, ступени, куда крупная фреза не достала. Шаг и стратегия — как у обычного рельефа. Кнопка «+ Дообработка остатков» на вкладке «3D-симуляция» создаёт такую операцию сама.', En='PathForge simulates all operations before this one and compares the remaining stock with the model: this (usually smaller) tool goes only where material is left above the model — narrow valleys, corners, steps the larger tool could not reach. Step and strategy are those of a normal relief. The “+ Rest machining” button on the “3D simulation” tab creates such an operation for you.'}" />
                    <TextBlock Grid.Row="21" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Допуск остатков, мм', En='Rest tolerance, mm'}" />
                    <TextBox Grid.Row="21" Grid.Column="1" Text="{Binding RestTolerance}"
                             ToolTip="{l:Tr 'Только для дообработки: остаток тоньше этого не обрабатывается заново (0,03–0,1 мм). Меньше — дольше, но чище.', En='Rest machining only: material thinner than this is not machined again (0.03–0.1 mm). Smaller takes longer but is cleaner.'}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:Tr 'Расчёт учитывает форму фрезы (сферическая, гравёр, концевая), поэтому она не врезается в соседние склоны. Черновые проходы идут по уровням шага по глубине инструмента.', En='The calculation takes the tool shape into account (ball nose, V-bit, end mill), so it does not gouge neighbouring slopes. Roughing passes follow the levels of the tool step-down.'}" />
            </StackPanel>
        </DataTemplate>

