                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding StepDown}" ToolTip="{l:Tr 'На сколько опускаться за один проход по Z', En='How far to go down per Z pass'}" />
                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Перекрытие, % Ø', En='Step-over, % Ø'}" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding StepOverPercent}" ToolTip="{l:Tr 'Перекрытие соседних проходов, % от диаметра', En='Overlap between adjacent passes, % of the diameter'}" />
                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Гравёр: кончик, мм', En='V-bit: tip, mm'}" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TipDiameter}" IsEnabled="{Binding IsVBit}" ToolTip="{l:Tr 'Ширина кончика гравёра, мм: от неё зависит глубина V-реза', En='V-bit tip width, mm: the V-cut depth depends on it'}" />
                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Гравёр: угол, °', En='V-bit: angle, °'}" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TipAngle}" IsEnabled="{Binding IsVBit}" ToolTip="{l:Tr 'Угол заточки гравёра, ° (обычно 20–90)', En='V-bit included angle, ° (usually 20–90)'}" />
                <TextBlock Grid.Row="11" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CutWidthHint}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Tr '_Файл', En='_File'}">
                <MenuItem Header="{l:Tr '_Новый проект', En='_New project'}" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="{l:Tr '_Открыть проект…', En='_Open project…'}" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="{l:Tr '_Сохранить', En='_Save'}" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="{l:Tr 'Сохранить _как…', En='Save _as…'}" Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Импорт чертежа (DXF, SVG)…', En='_Import drawing (DXF, SVG)…'}" InputGestureText="Ctrl+I" Command="{Binding ImportDrawingCommand}" />
                <MenuItem Header="{l:Tr '_Добавить чертёж (DXF, SVG)…', En='A_dd drawing (DXF, SVG)…'}" Command="{Binding AddDrawingCommand}" />
                <MenuItem Header="{l:Tr '3D-_рельеф', En='3D _relief'}">
                    <MenuItem Header="{l:Tr 'Импорт STL…', En='Import STL…'}" Command="{Binding ImportStlCommand}" />
                    <MenuItem Header="{l:Tr 'Рельеф из картинки…', En='Relief from a picture…'}" Command="{Binding AddImageReliefCommand}" />
                </MenuItem>
                <MenuItem Header="{l:Tr 'Печатная _плата', En='_PCB'}">
                    <MenuItem Header="{l:Tr 'Добавить Gerber: медь…', En='Add Gerber: copper…'}" Command="{Binding ImportGerberCopperCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить Gerber: контур платы…', En='Add Gerber: board outline…'}" Command="{Binding ImportGerberOutlineCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить сверловку (Excellon)…', En='Add drill file (Excellon)…'}" Command="{Binding ImportExcellonCommand}" />
                    <Separator />
                    <MenuItem Header="{l:Tr 'Зеркалить по X (нижний слой)', En='Mirror X (bottom layer)'}" Command="{Binding MirrorXCommand}" />
                </MenuItem>
                <MenuItem Header="{l:Tr '_Экспорт G-code…', En='_Export G-code…'}" InputGestureText="Ctrl+E" Command="{Binding ExportGcodeCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Выход', En='E_xit'}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Правка', En='_Edit'}">
                <MenuItem Header="{l:Tr '_Отменить', En='_Undo'}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="{l:Tr '_Повторить', En='_Redo'}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Выделение', En='_Selection'}">
                <MenuItem Header="{l:Tr 'Выделить всё', En='Select all'}" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="{l:Tr 'Выделить окружности', En='Select circles'}" Command="{Binding SelectCirclesCommand}" />
                <MenuItem Header="{l:Tr 'Выделить отверстия того же диаметра', En='Select holes of the same diameter'}" Command="{Binding SelectSameDiameterCommand}" />
                <MenuItem Header="{l:Tr 'Снять выделение', En='Clear selection'}" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Вид', En='_View'}">
                <MenuItem Header="{l:Tr 'Показать всё', En='Zoom to fit'}" InputGestureText="Home" Command="{Binding ZoomToFitCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Язык', En='_Language'}">
                    <!-- Language names are always shown in their own language -->
                    <MenuItem Header="Русский" IsChecked="{Binding IsRussian, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuItem Header="English" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                </MenuItem>
                <MenuItem Header="{l:Tr '_Тема', En='_Theme'}">
                    <MenuItem Header="{l:Tr 'Светлая', En='Light'}" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="{l:Tr 'Тёмная', En='Dark'}" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Импорт DXF/SVG', En='Import DXF/SVG'}" ToolTip="{l:Tr 'Открыть чертёж DXF или SVG (Ctrl+I). Текущий чертёж заменяется, контуры операций нужно будет выбрать заново. Файл можно и просто перетащить в окно.', En='Open a DXF or SVG drawing (Ctrl+I). It replaces the current drawing; the contours of the operations have to be selected again. You can also drop the file onto the window.'}" Command="{Binding ImportDrawingCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="STL" ToolTip="{l:Tr 'Загрузить 3D-модель STL и создать операцию «Рельеф 3D»: обработка поверхности строками сферической фрезой с черновыми проходами.', En='Load an STL 3D model and create a “3D relief” operation: surface machining in lines with a ball nose, with roughing passes.'}" Command="{Binding ImportStlCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Открыть', En='Open'}" ToolTip="{l:Tr 'Открыть сохранённый проект PathForge (*.pfproj, Ctrl+O): чертёж, инструменты, операции, настройки станка и карту высот.', En='Open a saved PathForge project (*.pfproj, Ctrl+O): drawing, tools, operations, machine settings and height map.'}" Command="{Binding OpenProjectCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Сохранить', En='Save'}" ToolTip="{l:Tr 'Сохранить проект (Ctrl+S). Сохраняется всё: чертёж, тексты, инструменты, операции, настройки станка и карта высот.', En='Save the project (Ctrl+S). Everything is saved: drawing, texts, tools, operations, machine settings and height map.'}" Command="{Binding SaveProjectCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="↶" FontSize="15" ToolTip="{l:Tr 'Отменить последнее изменение проекта (Ctrl+Z).', En='Undo the last change to the project (Ctrl+Z).'}" Command="{Binding UndoCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="↷" FontSize="15" ToolTip="{l:Tr 'Повторить отменённое изменение (Ctrl+Y или Ctrl+Shift+Z).', En='Redo the undone change (Ctrl+Y or Ctrl+Shift+Z).'}" Command="{Binding RedoCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Контур', En='+ Profile'}" ToolTip="{l:Tr 'Добавить операцию «Контур»: фреза идёт вдоль выделенных контуров снаружи, внутри или по линии, в несколько проходов по глубине, с перемычками. Для вырезания деталей и отверстий.', En='Add a “Profile” operation: the tool follows the selected contours outside, inside or on the line, in several depth passes, with tabs. For cutting out parts and holes.'}" Command="{Binding AddProfileCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Карман', En='+ Pocket'}" ToolTip="{l:Tr 'Добавить операцию «Карман»: выборка материала внутри выделенных замкнутых контуров на заданную глубину. Вложенные контуры остаются островами.', En='Add a “Pocket” operation: clears the material inside the selected closed contours to the given depth. Nested contours stay as islands.'}" Command="{Binding AddPocketCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Сверление', En='+ Drill'}" ToolTip="{l:Tr 'Добавить операцию «Сверление»: сверлится центр каждой выделенной окружности, сразу или с шагом (выводом стружки).', En='Add a “Drilling” operation: drills the centre of every selected circle, at once or with pecking.'}" Command="{Binding AddDrillCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Изоляция', En='+ Isolation'}" ToolTip="{l:Tr 'Добавить операцию «Изоляция» для печатных плат: гравёр обходит контуры меди в несколько проходов, отделяя дорожки друг от друга.', En='Add an “Isolation” operation for PCBs: the engraver goes around the copper contours in several passes, separating the tracks.'}" Command="{Binding AddIsolationCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Текст', En='+ Text'}" ToolTip="{l:Tr 'Добавить надпись любым установленным шрифтом. Буквы становятся контурами, к ним можно применить контур, карман, V-карвинг или лазер.', En='Add text in any installed font. The letters become contours that can be profiled, pocketed, V-carved or lasered.'}" Command="{Binding AddTextCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Лазер', En='+ Laser'}" ToolTip="{l:Tr 'Добавить лазерную операцию по выделенным контурам: резка или обводка по линии, заливка штриховкой или и то и другое. Нужен профиль станка с лазером.', En='Add a laser operation on the selected contours: cutting or outlining on the line, hatch fill, or both. Needs a machine profile with a laser.'}" Command="{Binding AddLaserVectorCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Картинка', En='+ Picture'}" ToolTip="{l:Tr 'Добавить лазерную гравировку картинки (PNG, JPG, BMP…): оттенки серого, дизеринг или порог, строка за строкой.', En='Add a laser engraving of a picture (PNG, JPG, BMP…): grayscale, dithering or threshold, line by line.'}" Command="{Binding AddLaserRasterCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Выбрать окружности', En='Select circles'}" ToolTip="{l:Tr 'Выделить все окружности на видимых слоях — например, все отверстия под сверление.', En='Select all circles on visible layers — for example, all holes to drill.'}" Command="{Binding SelectCirclesCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Показать всё', En='Zoom to fit'}" ToolTip="{l:Tr 'Показать весь чертёж и траектории в окне (Home).', En='Fit the whole drawing and toolpaths in the view (Home).'}" Command="{Binding ZoomToFitCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Экспорт G-code', En='Export G-code'}" FontWeight="SemiBold" ToolTip="{l:Tr 'Сохранить G-code всех включённых операций в файл .nc (Ctrl+E) для запуска в Candle, GRBLControl или на другом станке.', En='Save the G-code of all enabled operations to an .nc file (Ctrl+E) to run it in Candle, GRBLControl or on another machine.'}" Command="{Binding ExportGcodeCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Width="190">
                <TextBlock Text="{Binding CursorText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Statistics}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <TabItem Header="{l:Tr 'Операции', En='Operations'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <Button Content="{l:Tr '+ Контур', En='+ Profile'}" ToolTip="{l:Tr 'Добавить операцию «Контур»: фреза идёт вдоль выделенных контуров снаружи, внутри или по линии, в несколько проходов по глубине, с перемычками. Для вырезания деталей и отверстий.', En='Add a “Profile” operation: the tool follows the selected contours outside, inside or on the line, in several depth passes, with tabs. For cutting out parts and holes.'}" Command="{Binding AddProfileCommand}" />
                            <Button Content="{l:Tr '+ Карман', En='+ Pocket'}" ToolTip="{l:Tr 'Добавить операцию «Карман»: выборка материала внутри выделенных замкнутых контуров на заданную глубину. Вложенные контуры остаются островами.', En='Add a “Pocket” operation: clears the material inside the selected closed contours to the given depth. Nested contours stay as islands.'}" Command="{Binding AddPocketCommand}" />
                            <Button Content="{l:Tr '+ Сверление', En='+ Drill'}" ToolTip="{l:Tr 'Добавить операцию «Сверление»: сверлится центр каждой выделенной окружности, сразу или с шагом (выводом стружки).', En='Add a “Drilling” operation: drills the centre of every selected circle, at once or with pecking.'}" Command="{Binding AddDrillCommand}" />
                            <Button Content="{l:Tr '+ Изоляция', En='+ Isolation'}" ToolTip="{l:Tr 'Добавить операцию «Изоляция» для печатных плат: гравёр обходит контуры меди в несколько проходов, отделяя дорожки друг от друга.', En='Add an “Isolation” operation for PCBs: the engraver goes around the copper contours in several passes, separating the tracks.'}" Command="{Binding AddIsolationCommand}" />
                            <Button Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                            <Button Content="{l:Tr '+ Лазер', En='+ Laser'}" ToolTip="{l:Tr 'Добавить лазерную операцию по выделенным контурам: резка или обводка по линии, заливка штриховкой или и то и другое. Нужен профиль станка с лазером.', En='Add a laser operation on the selected contours: cutting or outlining on the line, hatch fill, or both. Needs a machine profile with a laser.'}" Command="{Binding AddLaserVectorCommand}" />
                            <Button Content="{l:Tr '+ Картинка', En='+ Picture'}" ToolTip="{l:Tr 'Добавить лазерную гравировку картинки (PNG, JPG, BMP…): оттенки серого, дизеринг или порог, строка за строкой.', En='Add a laser engraving of a picture (PNG, JPG, BMP…): grayscale, dithering or threshold, line by line.'}" Command="{Binding AddLaserRasterCommand}" />
                            <Button Content="{l:Tr '+ Рельеф (картинка)', En='+ Relief (picture)'}" ToolTip="{l:Tr 'Создать 3D-рельеф из картинки: светлое — выше, тёмное — глубже (можно инвертировать). Обработка сферической фрезой.', En='Create a 3D relief from a picture: light is high, dark is deep (can be inverted). Machined with a ball nose.'}" Command="{Binding AddImageReliefCommand}" />
                            <Button Content="{l:Tr '+ Рельеф (STL)', En='+ Relief (STL)'}" ToolTip="{l:Tr 'Загрузить 3D-модель STL и создать операцию «Рельеф 3D»: обработка поверхности строками сферической фрезой с черновыми проходами.', En='Load an STL 3D model and create a “3D relief” operation: surface machining in lines with a ball nose, with roughing passes.'}" Command="{Binding ImportStlCommand}" />
                        </WrapPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" ToolTip="{l:Tr 'Список операций: галочка включает/выключает операцию, клик открывает её настройки', En='List of operations: the check box enables or disables an operation, a click opens its settings'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OperationViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,6,0" ToolTip="{l:Tr 'Включить/выключить операцию', En='Enable or disable the operation'}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                            <Button Content="▲" ToolTip="{l:Tr 'Переместить операцию выше: она выполнится раньше. Обычно сначала карманы и отверстия, наружный контур — последним.', En='Move the operation up: it runs earlier. Usually pockets and holes first, the outer profile last.'}" Command="{Binding MoveOperationUpCommand}" />
                            <Button Content="▼" ToolTip="{l:Tr 'Переместить операцию ниже: она выполнится позже.', En='Move the operation down: it runs later.'}" Command="{Binding MoveOperationDownCommand}" />
                            <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранную операцию. Чертёж и инструменты не меняются; отменить — Ctrl+Z.', En='Delete the selected operation. The drawing and tools stay; undo with Ctrl+Z.'}" Command="{Binding RemoveOperationCommand}" />
                        </WrapPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedOperation}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:Tr 'Слои', En='Layers'}">
                    <DockPanel Margin="6">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Content="{l:Tr 'Показать все', En='Show all'}" ToolTip="{l:Tr 'Сделать видимыми все слои чертежа.', En='Make all drawing layers visible.'}" Command="{Binding ShowAllLayersCommand}" />
                            <Button Content="{l:Tr 'Добавить чертёж…', En='Add drawing…'}" ToolTip="{l:Tr 'Добавить ещё один чертёж DXF или SVG к текущему, не удаляя его (например, логотип к детали). Новые контуры сразу выделяются.', En='Add another DXF or SVG drawing to the current one without removing it (for example, a logo on a part). The new contours are selected right away.'}" Command="{Binding AddDrawingCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{l:Tr 'Скрытые слои не показываются и не выделяются. «Выделить» заменяет выделение, «+» добавляет к нему.', En='Hidden layers are neither shown nor selected. “Select” replaces the selection, “+” adds to it.'}" />
                        <ListBox ItemsSource="{Binding Layers}" HorizontalContentAlignment="Stretch" ToolTip="{l:Tr 'Слои чертежа: галочка показывает/скрывает слой', En='Drawing layers: the check box shows or hides a layer'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="+"
                                                ToolTip="{l:Tr 'Добавить все контуры этого слоя к текущему выделению.', En='Add all contours of this layer to the current selection.'}"
                                                Command="{Binding DataContext.AddLayerToSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="{l:Tr 'Выделить', En='Select'}"
                                                ToolTip="{l:Tr 'Выделить все контуры этого слоя (предыдущее выделение снимается). Скрытый слой станет видимым.', En='Select all contours of this layer (the previous selection is cleared). A hidden layer becomes visible.'}"
                                                Command="{Binding DataContext.SelectLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:Tr 'Видимость', En='Visibility'}" />
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Текст', En='Text'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="110" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <Button Content="{l:Tr '+ Текст', En='+ Text'}" ToolTip="{l:Tr 'Добавить надпись любым установленным шрифтом. Буквы становятся контурами, к ним можно применить контур, карман, V-карвинг или лазер.', En='Add text in any installed font. The letters become contours that can be profiled, pocketed, V-carved or lasered.'}" Command="{Binding AddTextCommand}" />
                            <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранную надпись вместе с её буквами-контурами.', En='Delete the selected text together with its letter contours.'}" Command="{Binding RemoveTextCommand}" />
                            <Button Content="{l:Tr 'Выделить буквы', En='Select letters'}" ToolTip="{l:Tr 'Выделить на чертеже все буквы выбранной надписи, чтобы добавить для них операцию.', En='Select all letters of the chosen text on the drawing to add an operation for them.'}" Command="{Binding SelectTextContoursCommand}" />
                            <Button Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                        </WrapPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Texts}" SelectedItem="{Binding SelectedText}" DisplayMemberPath="Display" ToolTip="{l:Tr 'Список надписей: клик открывает настройки', En='List of texts: a click opens the settings'}" />
                        <TextBlock Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding FontScanStatus}" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedText}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:Tr 'Пульт', En='Control'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,6,12,6" DataContext="{Binding Control}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Подключение (GRBL)', En='Connection (GRBL)'}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right" Content="↻" Padding="8,0"
                                        ToolTip="{l:Tr 'Заново найти COM-порты — после подключения станка по USB.', En='Look for COM ports again — after plugging the machine in by USB.'}"
                                        Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding IsDisconnected}" />
                                <ComboBox Width="90" DockPanel.Dock="Right" Margin="4,0" ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding BaudRate}" IsEnabled="{Binding IsDisconnected}" ToolTip="{l:Tr 'Скорость порта (обычно 115200)', En='Port speed (usually 115200)'}" />
                                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding IsDisconnected}" ToolTip="{l:Tr 'COM-порт станка; появляется после подключения USB', En='The machine COM port; it appears after plugging in the USB'}" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="{l:Tr 'Подключить', En='Connect'}" ToolTip="{l:Tr 'Открыть выбранный COM-порт и подключиться к GRBL. Плата перезагрузится и ответит версией прошивки. Закройте другие программы, которые держат порт.', En='Open the selected COM port and connect to GRBL. The board restarts and answers with its firmware version. Close other programs that hold the port.'}" Command="{Binding ConnectCommand}" IsEnabled="{Binding IsDisconnected}" />
                                <Button Content="{l:Tr 'Отключить', En='Disconnect'}" ToolTip="{l:Tr 'Закрыть соединение со станком или отменить автоматическое восстановление связи. Если программа выполняется, станок доработает уже принятые команды.', En='Close the connection to the machine or cancel automatic reconnection. If a program is running, the machine finishes the commands it has already received.'}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Состояние', En='State'}" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                <Setter Property="Foreground" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" Foreground="IndianRed" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkX}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" Foreground="MediumSeaGreen" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkY}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Z" Foreground="SteelBlue" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkZ}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MachineText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding FeedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr 'Разблокировать', En='Unlock'}"
                                        ToolTip="{l:Tr '$X — снять аварию (Alarm) и разрешить движения. Сначала убедитесь, что станок ни во что не упёрся.', En='$X — clear the alarm and allow motion. First make sure the machine is not jammed against anything.'}"
                                        Command="{Binding UnlockCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Домой', En='Home'}"
                                        ToolTip="{l:Tr '$H — поиск дома по концевикам. Работает только если концевики установлены и включены ($22=1).', En='$H — homing on the limit switches. Works only if limit switches are installed and enabled ($22=1).'}"
                                        Command="{Binding HomeCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Сброс', En='Reset'}"
                                        ToolTip="{l:Tr 'Ctrl-X — немедленный сброс контроллера: движение и шпиндель останавливаются. Во время движения положение может сбиться — заново выставьте ноль.', En='Ctrl-X — immediate controller reset: motion and spindle stop. Resetting while moving may lose the position — set zero again.'}"
                                        Command="{Binding SoftResetCommand}" IsEnabled="{Binding IsConnected}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Перемещение', En='Jog'}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Tr 'Шаг, мм', En='Step, mm'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding JogSteps}" SelectedItem="{Binding JogStep}" ToolTip="{l:Tr 'На сколько миллиметров сдвигает одна команда перемещения', En='How many millimetres one jog command moves'}" />
                                <TextBlock Grid.Column="2" Text="{l:Tr 'Подача XY / Z', En='Feed XY / Z'}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="50" Text="{Binding JogFeed}" ToolTip="{l:Tr 'Подача перемещения по XY, мм/мин', En='Jog feed on XY, mm/min'}" />
                                    <TextBox Width="45" Margin="2,0,0,0" Text="{Binding JogFeedZ}" ToolTip="{l:Tr 'Подача перемещения по Z, мм/мин', En='Jog feed on Z, mm/min'}" />
                                </StackPanel>
                            </Grid>
                            <Grid HorizontalAlignment="Left" IsEnabled="{Binding CanControl}">
                                <Grid.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Width" Value="52" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Content="Y+" ToolTip="{l:Tr 'Переместить фрезу назад (Y+) на выбранный шаг: на 3018 стол едет к вам.', En='Move the tool back (Y+) by the selected step: on a 3018 the table moves towards you.'}" Command="{Binding JogCommand}" CommandParameter="Y+" />
                                <Button Grid.Row="1" Grid.Column="0" Content="X−" ToolTip="{l:Tr 'Переместить фрезу влево (X−) на выбранный шаг.', En='Move the tool left (X−) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="X-" />
                                <Button Grid.Row="1" Grid.Column="1" Content="■" ToolTip="{l:Tr 'Остановить перемещение кнопками сразу, не дожидаясь конца шага.', En='Stop jogging immediately without waiting for the end of the step.'}" Command="{Binding JogCancelCommand}" />
                                <Button Grid.Row="1" Grid.Column="2" Content="X+" ToolTip="{l:Tr 'Переместить фрезу вправо (X+) на выбранный шаг.', En='Move the tool right (X+) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="X+" />
                                <Button Grid.Row="2" Grid.Column="1" Content="Y−" ToolTip="{l:Tr 'Переместить фрезу вперёд (Y−) на выбранный шаг: на 3018 стол едет от вас.', En='Move the tool forward (Y−) by the selected step: on a 3018 the table moves away from you.'}" Command="{Binding JogCommand}" CommandParameter="Y-" />
                                <Button Grid.Row="0" Grid.Column="4" Content="Z+" ToolTip="{l:Tr 'Поднять фрезу (Z+) на выбранный шаг.', En='Raise the tool (Z+) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="Z+" />
                                <Button Grid.Row="2" Grid.Column="4" Content="Z−" ToolTip="{l:Tr 'Опустить фрезу (Z−) на выбранный шаг. Возле заготовки берите шаг 0,1 или 0,01 мм.', En='Lower the tool (Z−) by the selected step. Near the stock use a 0.1 or 0.01 mm step.'}" Command="{Binding JogCommand}" CommandParameter="Z-" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Ноль заготовки', En='Work zero'}" />
                            <WrapPanel IsEnabled="{Binding CanControl}">
                                <Button Content="X0" ToolTip="{l:Tr 'Принять текущее положение фрезы за X0 заготовки (G10 L20).', En='Set the current tool position as work X0 (G10 L20).'}" Command="{Binding ZeroCommand}" CommandParameter="X" />
                                <Button Content="Y0" ToolTip="{l:Tr 'Принять текущее положение фрезы за Y0 заготовки (G10 L20).', En='Set the current tool position as work Y0 (G10 L20).'}" Command="{Binding ZeroCommand}" CommandParameter="Y" />
                                <Button Content="Z0" ToolTip="{l:Tr 'Принять текущую высоту фрезы за Z0. Обычно фреза касается верха заготовки (проверка бумажкой).', En='Set the current tool height as Z0. Usually the tool just touches the stock top (paper test).'}" Command="{Binding ZeroCommand}" CommandParameter="Z" />
                                <Button Content="X0 Y0" ToolTip="{l:Tr 'Принять текущее положение фрезы за X0 Y0 — угол или центр заготовки, выбранный на вкладке «Станок».', En='Set the current tool position as X0 Y0 — the stock corner or centre chosen on the “Machine” tab.'}" Command="{Binding ZeroCommand}" CommandParameter="XY" />
                                <Button Content="{l:Tr 'Все', En='All'}" ToolTip="{l:Tr 'Принять текущее положение фрезы за ноль по всем осям: X0 Y0 Z0.', En='Set the current tool position as zero on all axes: X0 Y0 Z0.'}" Command="{Binding ZeroCommand}" CommandParameter="XYZ" />
                                <Button Content="{l:Tr 'К нулю X Y', En='Go to X0 Y0'}" ToolTip="{l:Tr 'Поднять фрезу на безопасную высоту и переехать в X0 Y0 — проверить, где у заготовки ноль.', En='Raise the tool to the safe height and move to X0 Y0 — to check where the work zero is.'}" Command="{Binding GoToZeroCommand}" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0" IsEnabled="{Binding CanControl}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'Щуп: толщина пластины, мм', En='Probe: plate thickness, mm'}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Width="60" Text="{Binding ProbePlate}" ToolTip="{l:Tr 'Толщина пластины щупа: вычтется при установке Z0', En='Probe plate thickness: subtracted when Z0 is set'}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Ход вниз, мм / подача, мм/мин', En='Travel down, mm / feed, mm/min'}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="40" Text="{Binding ProbeTravel}" ToolTip="{l:Tr 'На сколько фреза может опуститься в поисках касания', En='How far the tool may go down while searching for contact'}" />
                                    <TextBox Width="40" Margin="2,0,0,0" Text="{Binding ProbeFeed}" ToolTip="{l:Tr 'Скорость опускания при поиске касания, мм/мин', En='Feed while probing down, mm/min'}" />
                                </StackPanel>
                                <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="{l:Tr 'Найти Z щупом', En='Probe Z'}" ToolTip="{l:Tr 'G38.2: фреза опускается до касания пластины щупа, затем Z0 ставится на поверхность заготовки с учётом толщины пластины. Зажим щупа — на фрезе.', En='G38.2: the tool goes down until it touches the probe plate, then Z0 is set on the stock surface, taking the plate thickness into account. Probe clip on the tool.'}" Command="{Binding ProbeZCommand}" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Карта высот (платы)', En='Height map (PCB)'}" />
                            <Grid IsEnabled="{Binding IsConnected}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'X от / до', En='X from / to'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LevelMinX}" ToolTip="{l:Tr 'Левый край сетки карты высот', En='Left edge of the height map grid'}" />
                                <TextBox Grid.Row="0" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelMaxX}" ToolTip="{l:Tr 'Правый край сетки карты высот', En='Right edge of the height map grid'}" />
                                <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Margin="4,0,0,0" Content="{l:Tr 'Из программы', En='From program'}" ToolTip="{l:Tr 'Взять область карты высот из траекторий проекта (все резы + 1 мм).', En='Take the height map area from the project toolpaths (all cuts + 1 mm).'}" Command="{Binding LevelAreaFromProgramCommand}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Y от / до', En='Y from / to'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LevelMinY}" ToolTip="{l:Tr 'Нижний край сетки карты высот', En='Bottom edge of the height map grid'}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelMaxY}" ToolTip="{l:Tr 'Верхний край сетки карты высот', En='Top edge of the height map grid'}" />
                                <TextBlock Grid.Row="2" Text="{l:Tr 'Шаг / подача', En='Step / feed'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LevelStep}" ToolTip="{l:Tr 'Расстояние между точками, мм (5–15)', En='Distance between points, mm (5–15)'}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelFeed}" ToolTip="{l:Tr 'Скорость щупа, мм/мин', En='Probe speed, mm/min'}" />
                                <TextBlock Grid.Row="3" Text="{l:Tr 'Подъём / глубина', En='Clearance / depth'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LevelClearance}" ToolTip="{l:Tr 'Высота переездов между точками, мм', En='Travel height between points, mm'}" />
                                <TextBox Grid.Row="3" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelDepth}" ToolTip="{l:Tr 'Насколько ниже Z0 искать поверхность, мм', En='How far below Z0 to search for the surface, mm'}" />
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr 'Снять карту', En='Probe map'}" ToolTip="{l:Tr 'Снять карту высот: щуп обходит сетку точек змейкой и измеряет неровность платы. В первой точке ставится Z0.', En='Probe the height map: the probe visits a grid of points and measures how uneven the board is. Z0 is set at the first point.'}" Command="{Binding ProbeMapCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Удалить карту', En='Delete map'}" ToolTip="{l:Tr 'Удалить снятую карту высот из проекта.', En='Delete the measured height map from the project.'}" Command="{Binding ClearMapCommand}" IsEnabled="{Binding HasLevelingMap}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LevelingText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding LevelingTable}" FontFamily="Consolas" FontSize="11" Margin="0,2" />
                            <CheckBox Content="{l:Tr 'Учитывать карту высот при запуске', En='Apply the height map when running'}" IsChecked="{Binding UseLeveling}" IsEnabled="{Binding HasLevelingMap}"
                                      ToolTip="{l:Tr 'Каждая линия делится на отрезки по 1 мм, к Z добавляется высота платы в этой точке', En='Every line is split into 1 mm segments, the board height at that point is added to Z'}" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Программа', En='Program'}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Файл…', En='File…'}" ToolTip="{l:Tr 'Выбрать готовый файл G-code (.nc, .gcode, .tap…) и запускать его вместо G-code проекта.', En='Choose an existing G-code file (.nc, .gcode, .tap…) to run instead of the project G-code.'}" Command="{Binding LoadFileCommand}" />
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Проект', En='Project'}" ToolTip="{l:Tr 'Снова запускать G-code текущего проекта вместо выбранного файла.', En='Run the G-code of the current project again instead of the chosen file.'}" Command="{Binding UseProjectCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding ProgramSource}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr '▶ Старт', En='▶ Start'}" FontWeight="SemiBold" ToolTip="{l:Tr 'Запустить программу на станке. Перед стартом проверьте: заготовка закреплена, ноль X/Y/Z выставлен, в шпинделе нужная фреза.', En='Start the program on the machine. Before starting check: the stock is clamped, X/Y/Z zero is set, the right tool is in the spindle.'}" Command="{Binding StartJobCommand}" IsEnabled="{Binding CanStartJob}" />
                                <Button Content="{l:Tr '❚❚ Пауза', En='❚❚ Pause'}" ToolTip="{l:Tr 'Плавно остановить подачу (feed hold). Положение сохраняется, «Продолжить» — ехать дальше.', En='Stop the feed smoothly (feed hold). The position is kept; “Resume” continues.'}" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" />
                                <Button Content="{l:Tr 'Продолжить', En='Resume'}" ToolTip="{l:Tr 'Продолжить программу после паузы, смены инструмента (M0) или ошибки в строке (ошибочная строка пропускается).', En='Continue the program after a pause, a tool change (M0) or a line error (the failed line is skipped).'}" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" />
                                <Button Content="{l:Tr '■ Стоп', En='■ Stop'}" ToolTip="{l:Tr 'Прервать программу: станок плавно тормозит, затем GRBL сбрасывается и шпиндель останавливается. Положение не теряется.', En='Abort the program: the machine decelerates, then GRBL is reset and the spindle stops. The position is kept.'}" Command="{Binding StopCommand}" IsEnabled="{Binding IsJobActive}" />
                            </WrapPanel>
                            <ProgressBar Height="12" Margin="0,4" Maximum="100" Value="{Binding Progress}" ToolTip="{l:Tr 'Прогресс выполнения программы', En='Program progress'}" />
                            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding JobMessage}" TextWrapping="Wrap" Foreground="DarkOrange" FontWeight="SemiBold" Margin="0,2" />
                            <Grid Margin="0,4,0,0" IsEnabled="{Binding IsConnected}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'Подача', En='Feed'}" VerticalAlignment="Center" />
                                <Button Grid.Row="0" Grid.Column="1" Content="−10 %" ToolTip="{l:Tr 'Уменьшить подачу на 10 % прямо во время работы (визг, вибрация, подгорание).', En='Reduce the feed by 10 % while running (screeching, vibration, burning).'}" Command="{Binding FeedOverrideCommand}" CommandParameter="-" />
                                <Button Grid.Row="0" Grid.Column="2" Content="100 %" ToolTip="{l:Tr 'Вернуть подачу из программы (100 %).', En='Back to the programmed feed (100 %).'}" Command="{Binding FeedOverrideCommand}" CommandParameter="0" />
                                <Button Grid.Row="0" Grid.Column="3" Content="+10 %" ToolTip="{l:Tr 'Увеличить подачу на 10 % прямо во время работы.', En='Increase the feed by 10 % while running.'}" Command="{Binding FeedOverrideCommand}" CommandParameter="+" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Шпиндель', En='Spindle'}" VerticalAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="1" Content="−10 %" ToolTip="{l:Tr 'Уменьшить обороты шпинделя (или мощность лазера) на 10 %.', En='Reduce the spindle speed (or laser power) by 10 %.'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="-" />
                                <Button Grid.Row="1" Grid.Column="2" Content="100 %" ToolTip="{l:Tr 'Вернуть обороты (мощность) из программы (100 %).', En='Back to the programmed speed (power) (100 %).'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="0" />
                                <Button Grid.Row="1" Grid.Column="3" Content="+10 %" ToolTip="{l:Tr 'Увеличить обороты шпинделя (или мощность лазера) на 10 %.', En='Increase the spindle speed (or laser power) by 10 %.'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="+" />
                            </Grid>
                            <TextBlock Text="{Binding OverridesText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Консоль', En='Console'}" />
                            <DockPanel IsEnabled="{Binding IsConnected}">
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Отправить', En='Send'}" ToolTip="{l:Tr 'Отправить команду из строки консоли в GRBL (Enter). Например: $$ — настройки, $G — режимы, $I — версия.', En='Send the console line to GRBL (Enter). For example: $$ — settings, $G — modes, $I — version.'}" Command="{Binding SendConsoleCommand}" />
                                <TextBox Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                         ToolTip="{l:Tr 'Команда GRBL, например $$ (настройки), $G (режимы), $I (версия)', En='GRBL command, e.g. $$ (settings), $G (modes), $I (version)'}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendConsoleCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <ListBox Height="200" Margin="0,4,0,0" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11" ToolTip="{l:Tr 'Журнал команд и ответов GRBL', En='Log of GRBL commands and replies'}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:Tr 'Инструменты', En='Tools'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Добавить', En='Add'}" ToolTip="{l:Tr 'Добавить в проект инструмент из выбранного пресета: диаметр, обороты, подачи и шаг по глубине для 3018.', En='Add a tool from the selected preset to the project: diameter, speed, feeds and step-down for a 3018.'}" Command="{Binding AddToolFromPresetCommand}" />
                                <ComboBox ItemsSource="{Binding ToolPresetOptions}" SelectedValue="{Binding SelectedToolPreset}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="{l:Tr 'Пресеты для CNC 3018 (шпиндель ~10 000 об/мин)', En='Presets for a CNC 3018 (spindle ~10,000 rpm)'}" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="{l:Tr '+ Пустой', En='+ Empty'}" ToolTip="{l:Tr 'Добавить пустой инструмент и заполнить его данные вручную.', En='Add an empty tool and fill in its data by hand.'}" Command="{Binding AddToolCommand}" />
                                <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранный инструмент. Инструмент, который используют операции, удалить нельзя.', En='Delete the selected tool. A tool used by operations cannot be deleted.'}" Command="{Binding RemoveToolCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" DisplayMemberPath="Display" ToolTip="{l:Tr 'Инструменты проекта: клик открывает настройки', En='Project tools: a click opens the settings'}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedTool}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:Tr 'Станок', En='Machine'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,4" Text="{l:Tr 'Профиль станка', En='Machine profile'}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="4,3,0,3" Content="{l:Tr 'Применить', En='Apply'}" ToolTip="{l:Tr 'Применить выбранный профиль станка: формат G-code, обороты, подачи, рабочее поле, лазерный режим. Свои строки в начале и конце программы сохраняются.', En='Apply the selected machine profile: G-code format, spindle speed, feeds, work area, laser mode. Custom start and end lines are kept.'}" Command="{Binding ApplyProfileCommand}" />
                                <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile}" ToolTip="{l:Tr 'Готовый профиль станка: рабочее поле, обороты, подачи и формат G-code', En='A ready machine profile: work area, speeds, feeds and G-code format'}" />
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedProfile.Description}" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"><Run Text="{l:Tr 'Сейчас:', En='Current:'}" /> <Run Text="{Binding Machine.ProfileName, Mode=OneWay}" /></TextBlock>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Заготовка и ноль', En='Stock and zero'}" />
                            <Grid DataContext="{Binding Stock}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Толщина заготовки, мм', En='Stock thickness, mm'}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Thickness}" ToolTip="{l:Tr 'Толщина материала: от неё считаются глубина и безопасная высота', En='Material thickness: the depth and safe height are calculated from it'}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ноль X/Y', En='Zero X/Y'}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.Origins}" ToolTip="{l:Tr 'Где у чертежа точка X0 Y0: угол или центр', En='Where the drawing X0 Y0 sits: a corner or the centre'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Origin}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ноль Z', En='Zero Z'}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.ZeroLevels}" ToolTip="{l:Tr 'Z0 на верхней или на нижней грани заготовки', En='Z0 on the top or on the bottom face of the stock'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ZeroAtBottom}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{l:Tr 'Ноль X/Y берётся от габарита всего чертежа. На станке выставьте ноль фрезы в эту точку.', En='Zero X/Y is taken from the bounds of the whole drawing. Set the tool zero at this point on the machine.'}" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Станок и G-code', En='Machine and G-code'}" />
                            <Grid DataContext="{Binding Machine}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Формат G-code', En='G-code format'}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.Dialects}" ToolTip="{l:Tr 'Формат G-code: GRBL, Marlin и другие', En='G-code dialect: GRBL, Marlin and others'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dialect}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Макс. обороты, об/мин', En='Max spindle speed, rpm'}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpindleMaxRpm}" ToolTip="{l:Tr 'Максимальные обороты шпинделя: S в G-code пишется как доля от них', En='Maximum spindle speed: the G-code S is written as a fraction of it'}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'S при макс. оборотах', En='S at max speed'}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpindleMaxS}"
                                         ToolTip="{l:Tr 'GRBL: значение $30 (обычно 1000). 0 — писать обороты как есть.', En='GRBL: the $30 value (usually 1000). 0 — write the speed as is.'}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Макс. подача, мм/мин', En='Max feed, mm/min'}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxFeedRate}" ToolTip="{l:Tr '0 — не проверять', En='0 — do not check'}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Рабочее поле X, мм', En='Work area X, mm'}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WorkAreaX}" ToolTip="{l:Tr '0 — не проверять', En='0 — do not check'}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Рабочее поле Y, мм', En='Work area Y, mm'}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WorkAreaY}" ToolTip="{l:Tr 'Рабочее поле по Y, мм; 0 — не проверять', En='Work area along Y, mm; 0 — do not check'}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ход Z, мм', En='Z travel, mm'}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WorkAreaZ}" ToolTip="{l:Tr 'Ход по Z, мм; 0 — не проверять', En='Z travel, mm; 0 — do not check'}" />
                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Безопасная высота, мм', En='Safe height, mm'}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SafeZ}" ToolTip="{l:Tr 'Над верхом заготовки', En='Above the stock top'}" />
                                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Подход к заготовке, мм', En='Approach clearance, mm'}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ApproachClearance}" ToolTip="{l:Tr 'Зазор над заготовкой при подходе на рабочей подаче', En='Clearance above the stock when approaching at cutting feed'}" />
                                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Холостой ход, мм/мин', En='Rapid rate, mm/min'}" />
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RapidRate}" ToolTip="{l:Tr 'Только для оценки времени', En='Only for the time estimate'}" />
                                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Знаков после запятой', En='Decimal places'}" />
                                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding DecimalPlaces}" ToolTip="{l:Tr 'Точность координат в файле; 3–4 обычно достаточно', En='Coordinate precision in the file; 3–4 is usually enough'}" />
                                <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Пауза после M3, с', En='Dwell after M3, s'}" />
                                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding SpindleDelaySeconds}" ToolTip="{l:Tr 'Пауза после включения шпинделя, чтобы он набрал обороты', En='Dwell after the spindle starts so it can spin up'}" />
                                <CheckBox Grid.Row="12" Grid.Column="1" Content="{l:Tr 'Автосмена инструмента (Tn M6)', En='Automatic tool change (Tn M6)'}" IsChecked="{Binding UseToolChange}"
                                          ToolTip="{l:Tr 'Не для GRBL: там смена инструмента — пауза M0', En='Not for GRBL: there a tool change is an M0 pause'}" />
                                <StackPanel Grid.Row="13" Grid.Column="1">
                                    <CheckBox Content="{l:Tr 'В конце вернуться в X0 Y0', En='Return to X0 Y0 at the end'}" IsChecked="{Binding ReturnToOrigin}" ToolTip="{l:Tr 'В конце программы фреза вернётся в X0 Y0', En='At the end of the program the tool returns to X0 Y0'}" />
                                    <CheckBox Content="{l:Tr 'Дуги G2/G3 вместо коротких отрезков', En='G2/G3 arcs instead of short segments'}" IsChecked="{Binding UseArcs}"
                                              ToolTip="{l:Tr 'Файл короче, движение плавнее. Нужны 3 знака после запятой.', En='Shorter file, smoother motion. Needs 3 decimal places.'}" />
                                </StackPanel>
                                <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="{l:Tr 'Свои строки в начале программы', En='Custom lines at the program start'}" />
                                <TextBox Grid.Row="15" Grid.ColumnSpan="2" Height="70" AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding Header}" ToolTip="{l:Tr 'Эти строки пишутся в начало файла G-code (например, настройка станка)', En='These lines are written at the start of the G-code file (e.g. machine setup)'}" />
                                <TextBlock Grid.Row="16" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="{l:Tr 'Свои строки в конце программы', En='Custom lines at the program end'}" />
                                <TextBox Grid.Row="17" Grid.ColumnSpan="2" Height="70" AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding Footer}" ToolTip="{l:Tr 'Эти строки пишутся в конец файла G-code (например, M30)', En='These lines are written at the end of the G-code file (e.g. M30)'}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushLight}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="200" MinHeight="80" />
                </Grid.RowDefinitions>
                <TabControl Grid.Row="0" Padding="0">
                    <TabItem Header="{l:Tr 'Чертёж (2D)', En='Drawing (2D)'}">
                        <Grid>
                            <controls:CamViewport x:Name="Viewport"
                                                  Scene="{Binding Scene}"
                                                  MachinePosition="{Binding Control.ToolPosition}"
                                                  ContourClickCommand="{Binding ContourClickedCommand}"
                                                  CursorText="{Binding CursorText, Mode=OneWayToSource}" />
                            <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#8A939E" IsHitTestVisible="False"
                                       Text="{l:Tr 'Колесо — масштаб · перетаскивание — сдвиг · клик — выбор контура (Ctrl — добавить) · Home — показать всё · крестик — ноль X0 Y0', En='Wheel — zoom · drag — pan · click — select a contour (Ctrl — add) · Home — fit all · cross — zero X0 Y0'}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{l:Tr '3D-симуляция', En='3D simulation'}" IsSelected="{Binding Simulation.IsActive, Mode=TwoWay}">
                        <DockPanel DataContext="{Binding Simulation}">
                            <Border DockPanel.Dock="Bottom" Padding="6,4" Background="{DynamicResource PanelBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="⏮" ToolTip="{l:Tr 'Перемотать симуляцию в начало: заготовка ещё не обработана.', En='Rewind the simulation to the start: the stock is untouched.'}" Command="{Binding ToStartCommand}" />
                                        <Button DockPanel.Dock="Left" MinWidth="80" Content="{Binding PlayLabel}" ToolTip="{l:Tr 'Запустить или приостановить воспроизведение обработки с выбранной скоростью.', En='Play or pause the machining at the selected speed.'}" Command="{Binding PlayPauseCommand}" />
                                        <Button DockPanel.Dock="Left" Content="⏭" ToolTip="{l:Tr 'Показать готовую деталь — результат всей программы.', En='Show the finished part — the result of the whole program.'}" Command="{Binding ToEndCommand}" />
                                        <ComboBox DockPanel.Dock="Left" Width="140" Margin="4,0" ItemsSource="{Binding Speeds}"
                                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedSpeed}" ToolTip="{l:Tr 'Скорость воспроизведения', En='Playback speed'}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding TimeText}" />
                                        <Slider Minimum="0" Maximum="1000" VerticalAlignment="Center" Value="{Binding Position}"
                                                ToolTip="{l:Tr 'Перетащите, чтобы посмотреть заготовку в любой момент обработки', En='Drag to see the stock at any moment of machining'}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="{l:Tr 'Пересчитать', En='Recalculate'}" ToolTip="{l:Tr 'Пересчитать симуляцию заново, например после смены точности сетки.', En='Recalculate the simulation, for example after changing the grid accuracy.'}" Command="{Binding RebuildCommand}" />
                                        <ComboBox DockPanel.Dock="Right" Width="150" Margin="4,0" ItemsSource="{Binding Qualities}"
                                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedQuality}" ToolTip="{l:Tr 'Точность сетки', En='Grid accuracy'}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding OperationText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatsText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="DarkOrange" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <controls:SimulationView Frame="{Binding Frame}" />
                                <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#8A939E" IsHitTestVisible="False"
                                           Text="{l:Tr 'Левая кнопка — вращение · правая — сдвиг · колесо — масштаб · двойной клик — исходный вид', En='Left button — rotate · right — pan · wheel — zoom · double click — default view'}" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushLight}" />
                <TabControl Grid.Row="2">
                    <TabItem Header="G-code">
                        <TextBox Text="{Binding Gcode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0" ToolTip="{l:Tr 'Готовый G-code всех включённых операций', En='Generated G-code of all enabled operations'}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    </TabItem>
                    <TabItem Header="{l:Tr 'Сообщения', En='Messages'}">
                        <ListBox ItemsSource="{Binding Messages}" ToolTip="{l:Tr 'Сообщения программы', En='Program messages'}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
