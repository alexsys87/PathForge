                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Обороты, об/мин', En='Spindle speed, rpm'}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SpindleRpm}" ToolTip="{l:Tr 'Обороты шпинделя, об/мин', En='Spindle speed, rpm'}" />
                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Подача, мм/мин', En='Feed, mm/min'}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FeedRate}" ToolTip="{l:Tr 'Рабочая подача, мм/мин', En='Working feed, mm/min'}" />
                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Врезание, мм/мин', En='Plunge, mm/min'}" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PlungeRate}" ToolTip="{l:Tr 'Скорость вертикального врезания, мм/мин', En='Vertical plunge feed, mm/min'}" />
                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг по глубине, мм', En='Step-down, mm'}" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding StepDown}" ToolTip="{l:Tr 'На сколько опускаться за один проход по Z', En='How far to go down per Z pass'}" />
                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Перекрытие, % Ø', En='Step-over, % Ø'}" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding StepOverPercent}" ToolTip="{l:Tr 'Перекрытие соседних проходов, % от диаметра', En='Overlap between adjacent passes, % of the diameter'}" />
                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Гравёр: кончик, мм', En='V-bit: tip, mm'}" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TipDiameter}" IsEnabled="{Binding IsVBit}" ToolTip="{l:Tr 'Ширина кончика гравёра, мм: от неё зависит глубина V-реза', En='V-bit tip width, mm: the V-cut depth depends on it'}" />
                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Гравёр: угол, °', En='V-bit: angle, °'}" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TipAngle}" IsEnabled="{Binding IsVBit}" ToolTip="{l:Tr 'Угол заточки гравёра, ° (обычно 20–90)', En='V-bit included angle, ° (usually 20–90)'}" />
                <TextBlock Grid.Row="11" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CutWidthHint}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Tr '_Файл', En='_File'}">
                <MenuItem Header="{l:Tr '_Новый проект', En='_New project'}" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="{l:Tr '_Открыть проект…', En='_Open project…'}" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="{l:Tr '_Сохранить', En='_Save'}" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="{l:Tr 'Сохранить _как…', En='Save _as…'}" Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Импорт чертежа (DXF, SVG)…', En='_Import drawing (DXF, SVG)…'}" InputGestureText="Ctrl+I" Command="{Binding ImportDrawingCommand}" />
                <MenuItem Header="{l:Tr '_Добавить чертёж (DXF, SVG)…', En='A_dd drawing (DXF, SVG)…'}" Command="{Binding AddDrawingCommand}" />
                <MenuItem Header="{l:Tr '3D-_рельеф', En='3D _relief'}">
                    <MenuItem Header="{l:Tr 'Импорт STL…', En='Import STL…'}" Command="{Binding ImportStlCommand}" />
                    <MenuItem Header="{l:Tr 'Рельеф из картинки…', En='Relief from a picture…'}" Command="{Binding AddImageReliefCommand}" />
                </MenuItem>
                <MenuItem Header="{l:Tr 'Печатная _плата', En='_PCB'}">
                    <MenuItem Header="{l:Tr 'Добавить файлы платы (несколько сразу)…', En='Add PCB files (several at once)…'}" Command="{Binding ImportPcbFilesCommand}"
                              ToolTip="{l:Tr 'Выберите сразу все файлы платы (Gerber и сверловку) или плату Eagle (.brd): медь, контур и отверстия определятся сами по атрибутам X2 или по именам файлов. Паста, маска и шелкография добавятся скрытыми слоями — для трафарета и маски лазером. Каждый файл станет отдельным слоем.', En='Select all the board files at once (Gerber and drills) or an Eagle board (.brd): copper, outline and holes are recognised by the X2 attributes or by the file names. Paste, solder mask and silk screen are added as hidden layers — for the stencil and the mask by laser. Each file becomes its own layer.'}" />
                    <MenuItem Header="{l:Tr 'Добавить Gerber: медь…', En='Add Gerber: copper…'}" Command="{Binding ImportGerberCopperCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить Gerber: контур платы…', En='Add Gerber: board outline…'}" Command="{Binding ImportGerberOutlineCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить сверловку (Excellon)…', En='Add drill file (Excellon)…'}" Command="{Binding ImportExcellonCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить плату Eagle (.brd)…', En='Add Eagle board (.brd)…'}" Command="{Binding ImportEagleBoardCommand}"
                              ToolTip="{l:Tr 'Плата Eagle 6 и новее или Fusion Electronics (XML) целиком: медь сверху и снизу с рассчитанными полигонами, контур, отверстия по диаметрам, а также паста, маска и шелкография скрытыми слоями. Надписи не переносятся.', En='A whole Eagle 6+ or Fusion Electronics board (XML): top and bottom copper with the polygon pours computed, the outline, holes by diameter, and paste, solder mask and silk screen as hidden layers. Texts are not imported.'}" />
                    <Separator />
                    <MenuItem Header="{l:Tr 'Зеркалить по X (нижний слой)', En='Mirror X (bottom layer)'}" Command="{Binding MirrorXCommand}" />
                    <MenuItem Header="{l:Tr 'Добавить базовые отверстия (двусторонняя плата)', En='Add alignment holes (double-sided board)'}" Command="{Binding AddAlignmentHolesCommand}" ToolTip="{l:Tr 'Двусторонняя плата: два отверстия под штифты слева и справа от контура платы, на одной горизонтали и симметрично. Сверлятся насквозь в жертвенный стол; плату переворачивают слева направо на штифты, «Зеркалить по X» — и вторая сторона совпадает с первой без перестановки нуля. Диаметр и отступ — на вкладке «Операции», «Двусторонняя плата».', En='Double-sided board: two pin holes left and right of the board outline, on one horizontal line and symmetric. Drilled through into the spoil board; the board is turned over left to right onto the pins, “Mirror X” — and the second side matches the first without moving the zero. Diameter and distance are on the “Operations” tab, “Double-sided board”.'}" />
                    <Separator />
                    <MenuItem Header="{l:Tr '+ Изоляция фрезой (гравёром)', En='+ Isolation by milling (engraver)'}" Command="{Binding AddIsolationCommand}" />
                    <MenuItem Header="{l:Tr '+ Удаление лишней меди фрезой', En='+ Remove excess copper by milling'}" Command="{Binding AddCopperClearingCommand}" ToolTip="{l:Tr 'Удаление лишней меди: выделите медь (и контур платы). Гравёр обходит дорожки изоляцией, концевая фреза Ø1–2 мм снимает всю остальную медь внутри контура платы. Если изоляции ещё нет, она добавится.', En='Removing excess copper: select the copper (and the board outline). The engraver isolates the tracks, an Ø1–2 mm end mill removes all the other copper inside the board outline. An isolation is added if there is none yet.'}" />
                    <MenuItem Header="{l:Tr '+ Сверловка по диаметрам', En='+ Drilling by diameter'}" Command="{Binding AddDrillsByDiameterCommand}" ToolTip="{l:Tr 'Отверстия группируются по диаметру, каждой группе подбирается ближайшее сверло из инструментов, на каждое сверло — своя операция, от тонкого к толстому, с паузой на смену сверла. Берутся выделенные отверстия, а без выделения — все слои сверловки.', En='The holes are grouped by diameter, each group gets the nearest drill among the tools, one operation per drill, thinnest first, with a pause for the drill change. The selected holes are used, or without a selection all the drill layers.'}" />
                    <MenuItem Header="{l:Tr '+ Плата лазером (краска и травление)', En='+ Laser PCB (paint and etching)'}" Command="{Binding AddLaserPcbCommand}" ToolTip="{l:Tr 'Добавить операцию «Плата лазером»: медь покрыта краской, лазер выжигает краску вокруг дорожек (полосой или со всей платы), затем плата травится. Выделите медь (и контур платы) перед нажатием.', En='Add a “Laser PCB” operation: the copper is painted, the laser burns the paint around the tracks (a strip or the whole board), then the board is etched. Select the copper (and the board outline) first.'}" />
                    <Separator />
                    <MenuItem Header="{l:Tr '+ Трафарет для паяльной пасты (лазер)', En='+ Solder paste stencil (laser)'}" Command="{Binding AddPasteStencilCommand}" ToolTip="{l:Tr 'Трафарет для паяльной пасты из плёнки: окна по слою пасты (Paste), уменьшенные с каждой стороны, и рамка листа. Ширина реза учитывается — окна выйдут в размер. Берутся выделенные контуры или слой пасты.', En='A solder paste stencil from film: windows from the paste layer, shrunk on each side, and the sheet frame. The kerf is compensated — the windows come out to size. The selected contours or the paste layer are used.'}" />
                    <MenuItem Header="{l:Tr '+ Окна паяльной маски (лазер)', En='+ Solder mask openings (laser)'}" Command="{Binding AddLaserMaskCommand}" ToolTip="{l:Tr 'Плата покрыта отверждённой УФ-маской: лазер выжигает маску в окнах над площадками (слой маски, Soldermask), край — точно по контуру. Берутся выделенные контуры или слой маски.', En='The board is covered with cured UV solder mask: the laser burns the mask away in the openings over the pads (the solder mask layer), the edge right on the contour. The selected contours or the mask layer are used.'}" />
                    <MenuItem Header="{l:Tr '+ Шелкография (лазер)', En='+ Silk screen (laser)'}" Command="{Binding AddLaserSilkscreenCommand}" ToolTip="{l:Tr 'Надписи и контуры компонентов по слою шелкографии (Silkscreen, Legend) выжигаются по маске на малой мощности. Берутся выделенные контуры или слой шелкографии.', En='The markings and component outlines of the silk screen layer (Legend) are burned into the mask at low power. The selected contours or the silk screen layer are used.'}" />
                </MenuItem>
                <MenuItem Header="{l:Tr '_Экспорт G-code…', En='_Export G-code…'}" InputGestureText="Ctrl+E" Command="{Binding ExportGcodeCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Выход', En='E_xit'}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Правка', En='_Edit'}">
                <MenuItem Header="{l:Tr '_Отменить', En='_Undo'}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="{l:Tr '_Повторить', En='_Redo'}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Выделение', En='_Selection'}">
                <MenuItem Header="{l:Tr 'Выделить всё', En='Select all'}" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="{l:Tr 'Выделить окружности', En='Select circles'}" Command="{Binding SelectCirclesCommand}" />
                <MenuItem Header="{l:Tr 'Выделить отверстия того же диаметра', En='Select holes of the same diameter'}" Command="{Binding SelectSameDiameterCommand}" />
                <MenuItem Header="{l:Tr 'Снять выделение', En='Clear selection'}" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Вид', En='_View'}">
                <MenuItem Header="{l:Tr 'Показать всё', En='Zoom to fit'}" InputGestureText="Home" Command="{Binding ZoomToFitCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Язык', En='_Language'}">
                    <!-- Language names are always shown in their own language -->
                    <MenuItem Header="Русский" IsChecked="{Binding IsRussian, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuItem Header="English" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                </MenuItem>
                <MenuItem Header="{l:Tr '_Тема', En='_Theme'}">
                    <MenuItem Header="{l:Tr 'Светлая', En='Light'}" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="{l:Tr 'Тёмная', En='Dark'}" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Импорт DXF/SVG', En='Import DXF/SVG'}" ToolTip="{l:Tr 'Открыть чертёж DXF или SVG (Ctrl+I). Текущий чертёж заменяется, контуры операций нужно будет выбрать заново. Файл можно и просто перетащить в окно.', En='Open a DXF or SVG drawing (Ctrl+I). It replaces the current drawing; the contours of the operations have to be selected again. You can also drop the file onto the window.'}" Command="{Binding ImportDrawingCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="STL" ToolTip="{l:Tr 'Загрузить 3D-модель STL и создать операцию «Рельеф 3D»: обработка поверхности строками сферической фрезой с черновыми проходами.', En='Load an STL 3D model and create a “3D relief” operation: surface machining in lines with a ball nose, with roughing passes.'}" Command="{Binding ImportStlCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Открыть', En='Open'}" ToolTip="{l:Tr 'Открыть сохранённый проект PathForge (*.pfproj, Ctrl+O): чертёж, инструменты, операции, настройки станка и карту высот.', En='Open a saved PathForge project (*.pfproj, Ctrl+O): drawing, tools, operations, machine settings and height map.'}" Command="{Binding OpenProjectCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Сохранить', En='Save'}" ToolTip="{l:Tr 'Сохранить проект (Ctrl+S). Сохраняется всё: чертёж, тексты, инструменты, операции, настройки станка и карта высот.', En='Save the project (Ctrl+S). Everything is saved: drawing, texts, tools, operations, machine settings and height map.'}" Command="{Binding SaveProjectCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="↶" FontSize="15" ToolTip="{l:Tr 'Отменить последнее изменение проекта (Ctrl+Z).', En='Undo the last change to the project (Ctrl+Z).'}" Command="{Binding UndoCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="↷" FontSize="15" ToolTip="{l:Tr 'Повторить отменённое изменение (Ctrl+Y или Ctrl+Shift+Z).', En='Redo the undone change (Ctrl+Y or Ctrl+Shift+Z).'}" Command="{Binding RedoCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Контур', En='+ Profile'}" ToolTip="{l:Tr 'Добавить операцию «Контур»: фреза идёт вдоль выделенных контуров снаружи, внутри или по линии, в несколько проходов по глубине, с перемычками. Для вырезания деталей и отверстий.', En='Add a “Profile” operation: the tool follows the selected contours outside, inside or on the line, in several depth passes, with tabs. For cutting out parts and holes.'}" Command="{Binding AddProfileCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Карман', En='+ Pocket'}" ToolTip="{l:Tr 'Добавить операцию «Карман»: выборка материала внутри выделенных замкнутых контуров на заданную глубину. Вложенные контуры остаются островами.', En='Add a “Pocket” operation: clears the material inside the selected closed contours to the given depth. Nested contours stay as islands.'}" Command="{Binding AddPocketCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Торцовка', En='+ Facing'}" ToolTip="{l:Tr 'Добавить операцию «Торцовка»: прямоугольная область фрезеруется зигзагом в размер — выравнивание жертвенного стола или верха заготовки. Область — выделенные контуры с полями, а без выделения — чертёж или всё поле станка.', En='Add a “Facing” operation: a rectangular area is milled flat in a zigzag — spoil board surfacing or the top of the stock. The area is the selected contours with a margin, or without a selection the drawing or the whole machine area.'}" Command="{Binding AddFacingCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Сверление', En='+ Drill'}" ToolTip="{l:Tr 'Добавить операцию «Сверление»: сверлится центр каждой выделенной окружности, сразу или с шагом (выводом стружки).', En='Add a “Drilling” operation: drills the centre of every selected circle, at once or with pecking.'}" Command="{Binding AddDrillCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Изоляция', En='+ Isolation'}" ToolTip="{l:Tr 'Добавить операцию «Изоляция» для печатных плат: гравёр обходит контуры меди в несколько проходов, отделяя дорожки друг от друга.', En='Add an “Isolation” operation for PCBs: the engraver goes around the copper contours in several passes, separating the tracks.'}" Command="{Binding AddIsolationCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Текст', En='+ Text'}" ToolTip="{l:Tr 'Добавить надпись любым установленным шрифтом. Буквы становятся контурами, к ним можно применить контур, карман, V-карвинг или лазер.', En='Add text in any installed font. The letters become contours that can be profiled, pocketed, V-carved or lasered.'}" Command="{Binding AddTextCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Лазер', En='+ Laser'}" ToolTip="{l:Tr 'Добавить лазерную операцию по выделенным контурам: резка или обводка по линии, заливка штриховкой или и то и другое. Нужен профиль станка с лазером.', En='Add a laser operation on the selected contours: cutting or outlining on the line, hatch fill, or both. Needs a machine profile with a laser.'}" Command="{Binding AddLaserVectorCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Плата лазером', En='+ Laser PCB'}" ToolTip="{l:Tr 'Добавить операцию «Плата лазером»: медь покрыта краской, лазер выжигает краску вокруг дорожек (полосой или со всей платы), затем плата травится. Выделите медь (и контур платы) перед нажатием.', En='Add a “Laser PCB” operation: the copper is painted, the laser burns the paint around the tracks (a strip or the whole board), then the board is etched. Select the copper (and the board outline) first.'}" Command="{Binding AddLaserPcbCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr '+ Картинка', En='+ Picture'}" ToolTip="{l:Tr 'Добавить лазерную гравировку картинки (PNG, JPG, BMP…): оттенки серого, дизеринг или порог, строка за строкой.', En='Add a laser engraving of a picture (PNG, JPG, BMP…): grayscale, dithering or threshold, line by line.'}" Command="{Binding AddLaserRasterCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Выделить всё', En='Select all'}" ToolTip="{l:Tr 'Выделить все контуры на видимых слоях (Ctrl+A; то же — меню «Выделение» и правая кнопка мыши на чертеже). Снять выделение — Esc.', En='Select all contours on visible layers (Ctrl+A; also the “Selection” menu and a right click on the drawing). Clear the selection with Esc.'}" Command="{Binding SelectAllCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Выбрать окружности', En='Select circles'}" ToolTip="{l:Tr 'Выделить все окружности на видимых слоях — например, все отверстия под сверление.', En='Select all circles on visible layers — for example, all holes to drill.'}" Command="{Binding SelectCirclesCommand}" />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Показать всё', En='Zoom to fit'}" ToolTip="{l:Tr 'Показать весь чертёж и траектории в окне (Home).', En='Fit the whole drawing and toolpaths in the view (Home).'}" Command="{Binding ZoomToFitCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}" Content="{l:Tr 'Экспорт G-code', En='Export G-code'}" FontWeight="SemiBold" ToolTip="{l:Tr 'Сохранить G-code всех включённых операций в файл .nc (Ctrl+E) для запуска в Candle, GRBLControl или на другом станке.', En='Save the G-code of all enabled operations to an .nc file (Ctrl+E) to run it in Candle, GRBLControl or on another machine.'}" Command="{Binding ExportGcodeCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Width="190">
                <TextBlock Text="{Binding CursorText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Statistics}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="360" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="LeftTabs" Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <TabItem Header="{l:Tr 'Операции', En='Operations'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <WrapPanel>
                            <Button Content="{l:Tr '+ Контур', En='+ Profile'}" ToolTip="{l:Tr 'Добавить операцию «Контур»: фреза идёт вдоль выделенных контуров снаружи, внутри или по линии, в несколько проходов по глубине, с перемычками. Для вырезания деталей и отверстий.', En='Add a “Profile” operation: the tool follows the selected contours outside, inside or on the line, in several depth passes, with tabs. For cutting out parts and holes.'}" Command="{Binding AddProfileCommand}" />
                            <Button Content="{l:Tr '+ Карман', En='+ Pocket'}" ToolTip="{l:Tr 'Добавить операцию «Карман»: выборка материала внутри выделенных замкнутых контуров на заданную глубину. Вложенные контуры остаются островами.', En='Add a “Pocket” operation: clears the material inside the selected closed contours to the given depth. Nested contours stay as islands.'}" Command="{Binding AddPocketCommand}" />
                            <Button Content="{l:Tr '+ Торцовка', En='+ Facing'}" ToolTip="{l:Tr 'Добавить операцию «Торцовка»: прямоугольная область фрезеруется зигзагом в размер — выравнивание жертвенного стола или верха заготовки. Область — выделенные контуры с полями, а без выделения — чертёж или всё поле станка.', En='Add a “Facing” operation: a rectangular area is milled flat in a zigzag — spoil board surfacing or the top of the stock. The area is the selected contours with a margin, or without a selection the drawing or the whole machine area.'}" Command="{Binding AddFacingCommand}" />
                            <Button Content="{l:Tr '+ Сверление', En='+ Drill'}" ToolTip="{l:Tr 'Добавить операцию «Сверление»: сверлится центр каждой выделенной окружности, сразу или с шагом (выводом стружки).', En='Add a “Drilling” operation: drills the centre of every selected circle, at once or with pecking.'}" Command="{Binding AddDrillCommand}" />
                            <Button Content="{l:Tr '+ Изоляция', En='+ Isolation'}" ToolTip="{l:Tr 'Добавить операцию «Изоляция» для печатных плат: гравёр обходит контуры меди в несколько проходов, отделяя дорожки друг от друга.', En='Add an “Isolation” operation for PCBs: the engraver goes around the copper contours in several passes, separating the tracks.'}" Command="{Binding AddIsolationCommand}" />
                            <Button Content="{l:Tr '+ Удаление меди', En='+ Copper clearing'}" ToolTip="{l:Tr 'Удаление лишней меди: выделите медь (и контур платы). Гравёр обходит дорожки изоляцией, концевая фреза Ø1–2 мм снимает всю остальную медь внутри контура платы. Если изоляции ещё нет, она добавится.', En='Removing excess copper: select the copper (and the board outline). The engraver isolates the tracks, an Ø1–2 mm end mill removes all the other copper inside the board outline. An isolation is added if there is none yet.'}" Command="{Binding AddCopperClearingCommand}" />
                            <Button Content="{l:Tr '+ Сверловка по Ø', En='+ Drilling by Ø'}" ToolTip="{l:Tr 'Отверстия группируются по диаметру, каждой группе подбирается ближайшее сверло из инструментов, на каждое сверло — своя операция, от тонкого к толстому, с паузой на смену сверла. Берутся выделенные отверстия, а без выделения — все слои сверловки.', En='The holes are grouped by diameter, each group gets the nearest drill among the tools, one operation per drill, thinnest first, with a pause for the drill change. The selected holes are used, or without a selection all the drill layers.'}" Command="{Binding AddDrillsByDiameterCommand}" />
                            <Button Content="{l:Tr '+ Фаска', En='+ Chamfer'}" ToolTip="{l:Tr 'Добавить фаску V-фрезой по выделенным контурам: кромка панели (снаружи) или потай под винт (внутри отверстия). Ширина фаски задаётся, глубина считается из угла фрезы.', En='Add a V-bit chamfer along the selected contours: the panel edge (outside) or a countersink for a screw (inside a hole). The chamfer width is set, the depth follows from the bit angle.'}" Command="{Binding AddChamferCommand}" />
                            <Button Content="{l:Tr '+ Отверстия по спирали', En='+ Helical holes'}" ToolTip="{l:Tr 'Круглые отверстия больше фрезы — по спирали, с цековкой под головку винта: быстрее и точнее кармана. Выделите окружности.', En='Round holes larger than the cutter — along a helix, with a counterbore for the screw head: faster and more accurate than a pocket. Select the circles.'}" Command="{Binding AddHelixHolesCommand}" />
                            <Button Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                            <Button Content="{l:Tr '+ Лазер', En='+ Laser'}" ToolTip="{l:Tr 'Добавить лазерную операцию по выделенным контурам: резка или обводка по линии, заливка штриховкой или и то и другое. Нужен профиль станка с лазером.', En='Add a laser operation on the selected contours: cutting or outlining on the line, hatch fill, or both. Needs a machine profile with a laser.'}" Command="{Binding AddLaserVectorCommand}" />
                            <Button Content="{l:Tr '+ Плата лазером', En='+ Laser PCB'}" ToolTip="{l:Tr 'Добавить операцию «Плата лазером»: медь покрыта краской, лазер выжигает краску вокруг дорожек (полосой или со всей платы), затем плата травится. Выделите медь (и контур платы) перед нажатием.', En='Add a “Laser PCB” operation: the copper is painted, the laser burns the paint around the tracks (a strip or the whole board), then the board is etched. Select the copper (and the board outline) first.'}" Command="{Binding AddLaserPcbCommand}" />
                            <Button Content="{l:Tr '+ Картинка', En='+ Picture'}" ToolTip="{l:Tr 'Добавить лазерную гравировку картинки (PNG, JPG, BMP…): оттенки серого, дизеринг или порог, строка за строкой.', En='Add a laser engraving of a picture (PNG, JPG, BMP…): grayscale, dithering or threshold, line by line.'}" Command="{Binding AddLaserRasterCommand}" />
                            <Button Content="{l:Tr '+ Рельеф (картинка)', En='+ Relief (picture)'}" ToolTip="{l:Tr 'Создать 3D-рельеф из картинки: светлое — выше, тёмное — глубже (можно инвертировать). Обработка сферической фрезой.', En='Create a 3D relief from a picture: light is high, dark is deep (can be inverted). Machined with a ball nose.'}" Command="{Binding AddImageReliefCommand}" />
                            <Button Content="{l:Tr '+ Рельеф (STL)', En='+ Relief (STL)'}" ToolTip="{l:Tr 'Загрузить 3D-модель STL и создать операцию «Рельеф 3D»: обработка поверхности строками сферической фрезой с черновыми проходами.', En='Load an STL 3D model and create a “3D relief” operation: surface machining in lines with a ball nose, with roughing passes.'}" Command="{Binding ImportStlCommand}" />
                        </WrapPanel>
                        <Expander Header="{l:Tr 'Раскладка деталей на листе', En='Lay out parts on a sheet'}" Margin="0,2,0,0" DataContext="{Binding Nesting}"
                                  ToolTip="{l:Tr 'Разложить детали по листу заготовки плотно, с зазором между ними. Деталь — замкнутый наружный контур вместе со всем, что внутри (отверстия, гравировка, текст).', En='Lay the parts out on the stock sheet tightly, with a gap between them. A part is a closed outer contour together with everything inside it (holes, engraving, text).'}">
                            <StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{l:Tr 'Лист X × Y, мм', En='Sheet X × Y, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SheetWidth}" ToolTip="{l:Tr 'Ширина листа (по X). Лист начинается в нуле чертежа.', En='Sheet width (along X). The sheet starts at the drawing origin.'}" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SheetHeight}" ToolTip="{l:Tr 'Высота листа (по Y)', En='Sheet height (along Y)'}" />
                                    <TextBlock Grid.Row="1" Text="{l:Tr 'Зазор, мм', En='Gap, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Spacing}" ToolTip="{l:Tr 'Расстояние между деталями: не меньше диаметра фрезы (лучше +1–2 мм), для лазера — 1–2 мм', En='Distance between the parts: at least the cutter diameter (better +1–2 mm), 1–2 mm for a laser'}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Tr 'от края', En='edge'}" VerticalAlignment="Center" Margin="6,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Margin}" ToolTip="{l:Tr 'Отступ от краёв листа (крепёж, неровный край)', En='Distance from the sheet edges (clamps, a rough edge)'}" />
                                    <TextBlock Grid.Row="2" Text="{l:Tr 'Копий', En='Copies'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Copies}" ToolTip="{l:Tr 'Сколько экземпляров каждой детали разложить; операции получат все копии', En='How many copies of each part to lay out; the operations get all copies'}" />
                                    <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="6,0,0,0" VerticalAlignment="Center" Content="{l:Tr 'Поворачивать', En='Rotate'}" IsChecked="{Binding AllowRotation}"
                                              ToolTip="{l:Tr 'Разрешить поворот деталей для плотной раскладки, с шагом из поля «Шаг поворота» (выключите для фанеры с волокнами или рисунка). Детали с текстом не поворачиваются.', En='Allow turning the parts for a tighter layout, in steps of “Turn step” (turn off for wood grain or a pattern). Parts with text are not turned.'}" />
                                    <TextBlock Grid.Row="3" Text="{l:Tr 'Шаг поворота, °', En='Turn step, °'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RotationStep}" IsEnabled="{Binding AllowRotation}"
                                             ToolTip="{l:Tr 'Через сколько градусов пробовать повороты: 90 — только 0°, 90°, 180°, 270°; 45, 15, 5 — любой угол с этим шагом. Мельче шаг — плотнее раскладка деталей сложной формы и тех, что нарисованы наклонно, но дольше расчёт.', En='How many degrees apart the tried turns are: 90 — only 0°, 90°, 180°, 270°; 45, 15, 5 — any angle in that step. A smaller step lays out odd shapes and parts drawn at an angle tighter but takes longer.'}" />
                                </Grid>
                                <CheckBox Margin="0,3,0,0" Content="{l:Tr 'Детали в отверстиях других деталей', En='Parts in holes of other parts'}" IsChecked="{Binding UseHoles}"
                                          ToolTip="{l:Tr 'Мелкие детали ставятся в вырезаемые насквозь отверстия крупных (с тем же зазором) — материал внутри рамок и колец не пропадает. Все замкнутые контуры внутри детали, кроме текста, считаются сквозными отверстиями, а замкнутый контур внутри отверстия — отдельной деталью. Не включайте, если внутри деталей есть карманы с островами.', En='Small parts are placed in the through holes of large ones (with the same gap) — the material inside frames and rings is not wasted. All closed contours inside a part except text are taken as through holes, and a closed contour inside a hole as a part of its own. Do not turn on if the parts contain pockets with islands.'}" />
                                <WrapPanel Margin="0,3,0,0">
                                    <Button Content="{l:Tr 'Разложить', En='Lay out'}"
                                            ToolTip="{l:Tr 'Разложить выделенные детали (или все, если ничего не выделено). Отменить — Ctrl+Z.', En='Lay out the selected parts (or all when nothing is selected). Undo with Ctrl+Z.'}"
                                            Command="{Binding DataContext.NestPartsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Content="{l:Tr 'Размер со станка', En='Size from the machine'}"
                                            ToolTip="{l:Tr 'Взять размер листа из рабочего поля станка, а зазор — по самой большой фрезе + 2 мм.', En='Take the sheet size from the machine work area and the gap from the largest cutter + 2 mm.'}"
                                            Command="{Binding DataContext.SuggestNestingSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr 'Двусторонняя плата: базовые отверстия', En='Double-sided board: alignment holes'}" Margin="0,2,0,0" DataContext="{Binding AlignmentHoles}"
                                  ToolTip="{l:Tr 'Двусторонняя плата: два отверстия под штифты слева и справа от контура платы, на одной горизонтали и симметрично. Сверлятся насквозь в жертвенный стол; плату переворачивают слева направо на штифты, «Зеркалить по X» — и вторая сторона совпадает с первой без перестановки нуля. Диаметр и отступ — на вкладке «Операции», «Двусторонняя плата».', En='Double-sided board: two pin holes left and right of the board outline, on one horizontal line and symmetric. Drilled through into the spoil board; the board is turned over left to right onto the pins, “Mirror X” — and the second side matches the first without moving the zero. Diameter and distance are on the “Operations” tab, “Double-sided board”.'}">
                            <StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ø, мм', En='Ø, mm'}" />
                                    <TextBox Grid.Column="1" Text="{Binding Diameter}" ToolTip="{l:Tr 'Диаметр отверстий и штифтов. Удобно 3 мм: сверло Ø3 из пресетов и штифт — отрезок стальной проволоки или хвостовик сломанного сверла 3 мм.', En='Diameter of the holes and pins. 3 mm is handy: the Ø3 drill from the presets and a pin cut from steel wire or the shank of a broken 3 mm drill.'}" />
                                    <TextBlock Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Отступ, мм', En='Gap, mm'}" />
                                    <TextBox Grid.Column="3" Text="{Binding Margin}" ToolTip="{l:Tr 'Расстояние от контура платы до края отверстия. Заготовка должна быть шире платы на 2 × (отступ + Ø) + запас.', En='Distance from the board outline to the hole edge. The blank must be wider than the board by 2 × (gap + Ø) plus some spare.'}" />
                                </Grid>
                                <Button HorizontalAlignment="Left" Margin="0,3,0,0" Content="{l:Tr '+ Базовые отверстия', En='+ Alignment holes'}"
                                        ToolTip="{l:Tr 'Двусторонняя плата: два отверстия под штифты слева и справа от контура платы, на одной горизонтали и симметрично. Сверлятся насквозь в жертвенный стол; плату переворачивают слева направо на штифты, «Зеркалить по X» — и вторая сторона совпадает с первой без перестановки нуля. Диаметр и отступ — на вкладке «Операции», «Двусторонняя плата».', En='Double-sided board: two pin holes left and right of the board outline, on one horizontal line and symmetric. Drilled through into the spoil board; the board is turned over left to right onto the pins, “Mirror X” — and the second side matches the first without moving the zero. Diameter and distance are on the “Operations” tab, “Double-sided board”.'}"
                                        Command="{Binding DataContext.AddAlignmentHolesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr 'Плата лазером: трафарет, маска, шелкография', En='PCB by laser: stencil, mask, silk screen'}" Margin="0,2,0,0" DataContext="{Binding PasteStencil}"
                                  ToolTip="{l:Tr 'Трафарет для паяльной пасты из плёнки по слою пасты; окна паяльной маски и шелкография на плате с УФ-маской. Слои пасты, маски и шелкографии добавляются скрытыми при «Добавить файлы платы».', En='A solder paste stencil from film by the paste layer; solder mask openings and silk screen on a board with UV solder mask. The paste, mask and silk screen layers are added hidden by “Add PCB files”.'}">
                            <StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Уменьшение окон, мм', En='Window reduction, mm'}" />
                                    <TextBox Grid.Column="1" Text="{Binding Reduction}" ToolTip="{l:Tr 'На сколько уменьшить каждое окно трафарета с каждой стороны: меньше пасты, нет перемычек между выводами с малым шагом. 0,03–0,08 мм; 0 — как в слое пасты.', En='How much to shrink every stencil window on each side: less paste, no bridges between fine-pitch leads. 0.03–0.08 mm; 0 — as in the paste layer.'}" />
                                    <TextBlock Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Поля листа, мм', En='Sheet margin, mm'}" />
                                    <TextBox Grid.Column="3" Text="{Binding FrameMargin}" ToolTip="{l:Tr 'Лист трафарета вырезается с этими полями вокруг окон; 0 — вырезать только окна (лист отрежете ножницами).', En='The stencil sheet is cut out with this margin around the windows; 0 — cut the windows only (trim the sheet with scissors).'}" />
                                </Grid>
                                <WrapPanel Margin="0,3,0,0">
                                    <Button Content="{l:Tr '+ Трафарет пасты', En='+ Paste stencil'}" ToolTip="{l:Tr 'Трафарет для паяльной пасты из плёнки: окна по слою пасты (Paste), уменьшенные с каждой стороны, и рамка листа. Ширина реза учитывается — окна выйдут в размер. Берутся выделенные контуры или слой пасты.', En='A solder paste stencil from film: windows from the paste layer, shrunk on each side, and the sheet frame. The kerf is compensated — the windows come out to size. The selected contours or the paste layer are used.'}"
                                            Command="{Binding DataContext.AddPasteStencilCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Margin="4,0,0,0" Content="{l:Tr '+ Окна маски', En='+ Mask openings'}" ToolTip="{l:Tr 'Плата покрыта отверждённой УФ-маской: лазер выжигает маску в окнах над площадками (слой маски, Soldermask), край — точно по контуру. Берутся выделенные контуры или слой маски.', En='The board is covered with cured UV solder mask: the laser burns the mask away in the openings over the pads (the solder mask layer), the edge right on the contour. The selected contours or the mask layer are used.'}"
                                            Command="{Binding DataContext.AddLaserMaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Margin="4,0,0,0" Content="{l:Tr '+ Шелкография', En='+ Silk screen'}" ToolTip="{l:Tr 'Надписи и контуры компонентов по слою шелкографии (Silkscreen, Legend) выжигаются по маске на малой мощности. Берутся выделенные контуры или слой шелкографии.', En='The markings and component outlines of the silk screen layer (Legend) are burned into the mask at low power. The selected contours or the silk screen layer are used.'}"
                                            Command="{Binding DataContext.AddLaserSilkscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr 'Тест лазера: мощность × скорость', En='Laser test: power × speed'}" Margin="0,2,0,0" DataContext="{Binding LaserTest}"
                                  ToolTip="{l:Tr 'Сетка квадратов, выжженных с разной мощностью (ряды снизу вверх) и скоростью (столбцы слева направо), с подписями значений. Вырежьте её на обрезке своего материала и выберите лучший квадрат.', En='A grid of squares burned with different power (rows, bottom to top) and speed (columns, left to right), with the values burned next to them. Burn it on a scrap of your material and pick the best square.'}">
                            <StackPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:Tr 'от', En='from'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Tr 'до', En='to'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{l:Tr 'шагов', En='steps'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Мощность, %', En='Power, %'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PowerMinPercent}" ToolTip="{l:Tr 'Мощность нижнего ряда', En='Power of the bottom row'}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PowerMaxPercent}" ToolTip="{l:Tr 'Мощность верхнего ряда', En='Power of the top row'}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PowerSteps}" ToolTip="{l:Tr 'Сколько рядов', En='How many rows'}" />
                                <TextBlock Grid.Row="2" Text="{l:Tr 'Скорость, мм/мин', En='Speed, mm/min'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpeedMin}" ToolTip="{l:Tr 'Скорость левого столбца', En='Speed of the left column'}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpeedMax}" ToolTip="{l:Tr 'Скорость правого столбца', En='Speed of the right column'}" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SpeedSteps}" ToolTip="{l:Tr 'Сколько столбцов', En='How many columns'}" />
                                <TextBlock Grid.Row="3" Text="{l:Tr 'Квадрат, мм', En='Square, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CellSize}" ToolTip="{l:Tr 'Сторона квадрата', En='Side of a square'}" />
                                <CheckBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="{l:Tr 'Рез (контур)', En='Cut (outline)'}" IsChecked="{Binding Cutting}" VerticalAlignment="Center"
                                          ToolTip="{l:Tr 'Выключено — квадраты заливаются (тест гравировки). Включено — квадраты вырезаются по контуру (тест резки: прорезало ли насквозь).', En='Off — the squares are filled (engraving test). On — the squares are cut along their outline (cutting test: did it cut through).'}" />
                            </Grid>
                            <Button HorizontalAlignment="Left" Content="{l:Tr '+ Тест-сетка лазера', En='+ Laser test card'}" Margin="0,3,0,0"
                                    ToolTip="{l:Tr 'Добавить тест-сетку с этими настройками справа от чертежа: каждый квадрат — своя операция с подписью мощности и скорости.', En='Add the test card with these settings to the right of the drawing: each square is its own operation, labelled with its power and speed.'}"
                                    Command="{Binding DataContext.AddLaserTestGridCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr 'Тест фокуса лазера', En='Laser focus test'}" Margin="0,2,0,0" DataContext="{Binding LaserFocus}"
                                  ToolTip="{l:Tr 'Ряд линий, выжженных на разной высоте Z, с подписями высоты. Самая тонкая линия — в фокусе: сдвиньте лазер по Z на её значение и выставьте там Z0. Лазер должен стоять на оси Z.', En='A row of lines burned at different Z heights, labelled with the height. The thinnest line is in focus: jog the laser in Z by its value and set Z0 there. The laser must sit on the Z axis.'}">
                            <StackPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:Tr 'от', En='from'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Tr 'до', En='to'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{l:Tr 'линий', En='lines'}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Высота Z, мм', En='Height Z, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ZFrom}" ToolTip="{l:Tr 'Z нижней линии относительно текущего Z0 (минус — лазер ниже)', En='Z of the bottom line relative to the current Z0 (minus — the laser lower)'}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ZTo}" ToolTip="{l:Tr 'Z верхней линии (плюс — лазер выше)', En='Z of the top line (plus — the laser higher)'}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Steps}" ToolTip="{l:Tr 'Сколько линий: шаг по Z = (до − от) / (линий − 1)', En='How many lines: the Z step = (to − from) / (lines − 1)'}" />
                                <TextBlock Grid.Row="2" Text="{l:Tr 'Мощность, %', En='Power, %'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PowerPercent}" ToolTip="{l:Tr 'Мощность линий: чтобы только оставить след (20–40 %)', En='Power of the lines: just enough to leave a mark (20–40 %)'}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{l:Tr 'мм/мин', En='mm/min'}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Speed}" ToolTip="{l:Tr 'Скорость линий: быстро, чтобы линия была тонкой (800–1500 мм/мин)', En='Speed of the lines: fast, so that the line is thin (800–1500 mm/min)'}" />
                            </Grid>
                            <Button HorizontalAlignment="Left" Content="{l:Tr '+ Тест фокуса', En='+ Focus test'}" Margin="0,3,0,0"
                                    ToolTip="{l:Tr 'Добавить линии теста справа от чертежа: каждая — своя операция со своей высотой «Фокус Z», плюс подписи. Сфокусируйте лазер на поверхности (Z0) и запустите.', En='Add the test lines to the right of the drawing: each is its own operation with its own “Focus Z”, plus the labels. Focus the laser on the surface (Z0) and run.'}"
                                    Command="{Binding DataContext.AddLaserFocusTestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr 'Гибкий шарнир (living hinge)', En='Living hinge'}" Margin="0,2,0,0" DataContext="{Binding LivingHinge}"
                                  ToolTip="{l:Tr 'Прорези в шахматном порядке: фанера 3 мм в этой области гнётся, как ткань, — для коробок со скруглёнными углами, обложек, браслетов.', En='Staggered slots: 3 mm plywood bends like fabric in this area — for boxes with rounded corners, covers, bracelets.'}">
                            <StackPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'X, мм', En='X, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X}" ToolTip="{l:Tr 'Левый нижний угол области шарнира на чертеже', En='Lower-left corner of the hinge area on the drawing'}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Tr 'Y, мм', En='Y, mm'}" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Y}" ToolTip="{l:Tr 'Левый нижний угол области шарнира на чертеже', En='Lower-left corner of the hinge area on the drawing'}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Ширина', En='Width'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Width}" ToolTip="{l:Tr 'Размер области по X, мм', En='Size of the area along X, mm'}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Tr 'Высота', En='Height'}" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Height}" ToolTip="{l:Tr 'Размер области по Y, мм', En='Size of the area along Y, mm'}" />
                                <TextBlock Grid.Row="2" Text="{l:Tr 'Прорези', En='Slots'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{x:Static vm:Choices.RasterAxes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Along}"
                                          ToolTip="{l:Tr 'Вдоль Y — панель гнётся вокруг вертикальной оси (стенка коробки со скруглёнными углами), вдоль X — вокруг горизонтальной.', En='Along Y — the panel bends around a vertical axis (the wall of a box with rounded corners), along X — around a horizontal one.'}" />
                                <TextBlock Grid.Row="3" Text="{l:Tr 'Длина, мм', En='Length, mm'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SlotLength}" ToolTip="{l:Tr 'Длина прорези (подгоняется, чтобы прорези ровно уложились в область): длиннее — мягче. 10–25 мм.', En='Slot length (adjusted so that whole slots fit the area): longer is softer. 10–25 mm.'}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{l:Tr 'Перемычка', En='Bridge'}" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Bridge}" ToolTip="{l:Tr 'Целый материал между прорезями одной линии, мм: 2–4 мм.', En='Uncut material between the slots of one line, mm: 2–4 mm.'}" />
                                <TextBlock Grid.Row="4" Text="{l:Tr 'Шаг линий', En='Line spacing'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Spacing}" ToolTip="{l:Tr 'Расстояние между соседними линиями прорезей, мм: меньше — гнётся круче, но ломче. Фанера 3 мм: 1,2–2 мм.', En='Distance between neighbouring lines of slots, mm: smaller bends tighter but is more fragile. 3 mm plywood: 1.2–2 mm.'}" />
                                <CheckBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Margin="6,0,0,0" VerticalAlignment="Center" Content="{l:Tr 'До края', En='To the edge'}" IsChecked="{Binding ToEdge}"
                                          ToolTip="{l:Tr 'Каждая вторая линия прорезается до края области — так гибче, если шарнир идёт через всю панель от края до края. Выключите, если область внутри панели: тогда все прорези остаются внутри.', En='Every second line is cut through to the edge of the area — more flexible when the hinge runs across the whole panel from edge to edge. Turn off when the area is inside a panel: then all slots stay inside.'}" />
                            </Grid>
                            <WrapPanel Margin="0,3,0,0">
                                <Button Content="{l:Tr 'По выделению', En='From selection'}"
                                        ToolTip="{l:Tr 'Взять область из габарита выделенных контуров (например, нарисованного прямоугольника зоны изгиба).', En='Take the area from the bounds of the selected contours (e.g. a rectangle drawn for the bending zone).'}"
                                        Command="{Binding DataContext.LivingHingeFromSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Margin="4,0,0,0" Content="{l:Tr '+ Гибкий шарнир', En='+ Living hinge'}"
                                        ToolTip="{l:Tr 'Добавить прорези на слой «Living hinge» и лазерную операцию резки по линии. Она ставится перед первой лазерной резкой, чтобы шарнир прорезался, пока панель ещё держится в листе; мощность и скорость берутся из этой резки.', En='Add the slots on the “Living hinge” layer and a laser cutting operation on the line. It is placed before the first laser cut so that the hinge is cut while the panel is still held by the sheet; power and speed are taken from that cut.'}"
                                        Command="{Binding DataContext.AddLivingHingeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </WrapPanel>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" ToolTip="{l:Tr 'Список операций: галочка включает/выключает операцию, клик открывает её настройки', En='List of operations: the check box enables or disables an operation, a click opens its settings'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OperationViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,6,0" ToolTip="{l:Tr 'Включить/выключить операцию', En='Enable or disable the operation'}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                            <Button Content="▲" ToolTip="{l:Tr 'Переместить операцию выше: она выполнится раньше. Обычно сначала карманы и отверстия, наружный контур — последним.', En='Move the operation up: it runs earlier. Usually pockets and holes first, the outer profile last.'}" Command="{Binding MoveOperationUpCommand}" />
                            <Button Content="▼" ToolTip="{l:Tr 'Переместить операцию ниже: она выполнится позже.', En='Move the operation down: it runs later.'}" Command="{Binding MoveOperationDownCommand}" />
                            <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранную операцию. Чертёж и инструменты не меняются; отменить — Ctrl+Z.', En='Delete the selected operation. The drawing and tools stay; undo with Ctrl+Z.'}" Command="{Binding RemoveOperationCommand}" />
                        </WrapPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedOperation}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:Tr 'Слои', En='Layers'}">
                    <DockPanel Margin="6">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Content="{l:Tr 'Показать все', En='Show all'}" ToolTip="{l:Tr 'Сделать видимыми все слои чертежа.', En='Make all drawing layers visible.'}" Command="{Binding ShowAllLayersCommand}" />
                            <Button Content="{l:Tr 'Добавить чертёж…', En='Add drawing…'}" ToolTip="{l:Tr 'Добавить ещё один чертёж DXF или SVG к текущему, не удаляя его (например, логотип к детали). Новые контуры сразу выделяются.', En='Add another DXF or SVG drawing to the current one without removing it (for example, a logo on a part). The new contours are selected right away.'}" Command="{Binding AddDrawingCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{l:Tr 'Скрытые слои не показываются и не выделяются. «Выделить» заменяет выделение, «+» добавляет к нему.', En='Hidden layers are neither shown nor selected. “Select” replaces the selection, “+” adds to it.'}" />
                        <ListBox ItemsSource="{Binding Layers}" HorizontalContentAlignment="Stretch" ToolTip="{l:Tr 'Слои чертежа: галочка показывает/скрывает слой', En='Drawing layers: the check box shows or hides a layer'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="+"
                                                ToolTip="{l:Tr 'Добавить все контуры этого слоя к текущему выделению.', En='Add all contours of this layer to the current selection.'}"
                                                Command="{Binding DataContext.AddLayerToSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="{l:Tr 'Выделить', En='Select'}"
                                                ToolTip="{l:Tr 'Выделить все контуры этого слоя (предыдущее выделение снимается). Скрытый слой станет видимым.', En='Select all contours of this layer (the previous selection is cleared). A hidden layer becomes visible.'}"
                                                Command="{Binding DataContext.SelectLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:Tr 'Видимость', En='Visibility'}" />
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Конструктор', En='Design'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{l:Tr 'Правка выделенных контуров и генераторы для коробок и приборных панелей. Выделение рамкой — Shift + протянуть на чертеже. Подробно — docs/boxes-panels.md.', En='Editing of the selected contours and generators for boxes and front panels. Box selection — Shift + drag on the drawing. Details: docs/boxes-panels.md.'}" />

                            <Expander Header="{l:Tr 'Изменить выделенное', En='Edit the selection'}" Margin="0,4,0,0" IsExpanded="True" DataContext="{Binding DrawingEdit}">
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Сдвиг X / Y, мм', En='Move X / Y, mm'}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MoveX}" />
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MoveY}" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="{l:Tr 'Сдвинуть', En='Move'}" ToolTip="{l:Tr 'Сдвинуть выделенные контуры. Текст, выделенный целиком, едет вместе с буквами.', En='Move the selected contours. A text selected as a whole moves with its letters.'}"
                                            Command="{Binding DataContext.MoveSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Поворот, °', En='Turn, °'}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Angle}" ToolTip="{l:Tr 'Против часовой стрелки вокруг центра выделения; минус — по часовой.', En='Counter-clockwise around the centre of the selection; minus — clockwise.'}" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="{l:Tr 'Повернуть', En='Turn'}" ToolTip="{l:Tr 'Повернуть выделенное вокруг его центра. Повёрнутые буквы текста становятся обычными контурами.', En='Turn the selection around its centre. Turned text letters become plain contours.'}"
                                            Command="{Binding DataContext.RotateSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Масштаб', En='Scale'}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ScaleFactor}" ToolTip="{l:Tr '1 — без изменений, 2 — вдвое больше, 0,5 — вдвое меньше; вокруг центра выделения.', En='1 — unchanged, 2 — twice as large, 0.5 — half; around the centre of the selection.'}" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="{l:Tr 'Масштаб', En='Scale'}" ToolTip="{l:Tr 'Изменить размер выделенного во столько раз (одинаково по X и Y).', En='Resize the selection by this factor (the same in X and Y).'}"
                                            Command="{Binding DataContext.ScaleSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Массив: столбцы × ряды', En='Array: columns × rows'}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Columns}" ToolTip="{l:Tr 'Сколько штук по X (вместе с исходным)', En='How many along X (the original included)'}" />
                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Rows}" ToolTip="{l:Tr 'Сколько штук по Y (вместе с исходным)', En='How many along Y (the original included)'}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг X / Y, мм', En='Step X / Y, mm'}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StepX}" />
                                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding StepY}" />
                                    <Button Grid.Row="4" Grid.Column="3" Content="{l:Tr 'Массив', En='Array'}" ToolTip="{l:Tr 'Копии выделенного сеткой. Операции, где был исходный контур, получают и копии.', En='Copies of the selection in a grid. Operations that had the original get the copies too.'}"
                                            Command="{Binding DataContext.ArrayRectangularCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'По кругу: штук, угол °', En='Circular: count, angle °'}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CircularCount}" ToolTip="{l:Tr 'Сколько штук вместе с исходным', En='How many, the original included'}" />
                                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding CircularSweep}" ToolTip="{l:Tr '360 — по всему кругу равномерно; меньше — дуга от исходного до последнего', En='360 — evenly around the full circle; less — an arc from the original to the last one'}" />
                                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Центр X / Y, мм', En='Centre X / Y, mm'}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CenterX}" />
                                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding CenterY}" />
                                    <Button Grid.Row="6" Grid.Column="3" Content="{l:Tr 'По выделению', En='From selection'}" ToolTip="{l:Tr 'Взять центр из выделенного (например, окружности).', En='Take the centre from the selection (e.g. a circle).'}"
                                            Command="{Binding DataContext.ArrayCenterFromSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:Tr 'Поворачивать копии', En='Turn the copies'}" IsChecked="{Binding RotateCopies}" />
                                    <Button Grid.Row="7" Grid.Column="3" Content="{l:Tr 'По кругу', En='Circular'}" ToolTip="{l:Tr 'Копии выделенного по кругу вокруг центра: крепёжные отверстия, вентиляция, риски.', En='Copies of the selection around the centre: mounting holes, vents, marks.'}"
                                            Command="{Binding DataContext.ArrayCircularCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Grid.Row="8" Grid.Column="3" Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выделенные контуры из чертежа и из операций (Del на чертеже). Отменяется Ctrl+Z.', En='Delete the selected contours from the drawing and the operations (Del on the drawing). Undo with Ctrl+Z.'}"
                                            Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </Expander>

                            <Expander Header="{l:Tr 'Коробка с шипами', En='Finger-joint box'}" Margin="0,4,0,0" DataContext="{Binding Box}"
                                      ToolTip="{l:Tr 'Коробка из листа: дно, четыре стенки и крышка с соединением «шип-паз». Детали раскладываются справа от чертежа, операции резки добавляются сами.', En='A box from sheet material: bottom, four walls and a lid with finger joints. The parts are laid out to the right of the drawing, the cutting operations are added by themselves.'}">
                                <StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ш × Г × В, мм', En='W × D × H, mm'}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Width}" ToolTip="{l:Tr 'Ширина (по X)', En='Width (along X)'}" />
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Depth}" ToolTip="{l:Tr 'Глубина (по Y)', En='Depth (along Y)'}" />
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Height}" ToolTip="{l:Tr 'Высота', En='Height'}" />
                                        <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Content="{l:Tr 'Внутренние размеры', En='Inner sizes'}" IsChecked="{Binding InnerDimensions}"
                                                  ToolTip="{l:Tr 'Включено — размеры внутри коробки (что в неё должно поместиться), выключено — снаружи.', En='On — the sizes inside the box (what must fit in), off — outside.'}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Толщина, шип, мм', En='Thickness, finger, mm'}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Thickness}" ToolTip="{l:Tr 'Толщина листа — измерьте штангенциркулем: «фанера 3 мм» бывает 2,7–3,2.', En='Sheet thickness — measure it with calipers: “3 mm plywood” is 2.7–3.2.'}" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FingerWidth}" ToolTip="{l:Tr 'Желаемая ширина шипа; подгоняется, чтобы на каждой кромке было нечётное число шипов. Обычно 2–4 толщины.', En='Wanted finger width; adjusted so that every edge has an odd number of fingers. Usually 2–4 thicknesses.'}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Крышка', En='Lid'}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{x:Static vm:Choices.BoxLids}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Lid}"
                                                  ToolTip="{l:Tr 'Накладная — пластина сверху и вкладыш под ней (приклеить), чтобы крышка не съезжала. Сдвижная — едет в пазах боковых и задней стенок, передняя стенка ниже.', En='Lift-off — a plate on top and an insert under it (glue it) so that the lid does not slip. Sliding — runs in grooves of the side and back walls, the front wall is lower.'}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Посадка, мм', En='Fit, mm'}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Fit}" ToolTip="{l:Tr 'Зазор в каждом соединении: плюс — свободно (под клей), минус — натяг. Начните с 0 и вырежьте пробный угол.', En='Play in every joint: plus — loose (for glue), minus — press fit. Start with 0 and cut a test corner.'}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Зазор, мм', En='Gap, mm'}" />
                                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Gap}" ToolTip="{l:Tr 'Расстояние между деталями на листе: для фрезы — больше её диаметра.', En='Distance between the parts on the sheet: for a mill — more than its diameter.'}" />
                                    </Grid>
                                    <Button HorizontalAlignment="Left" Margin="0,3,0,0" Content="{l:Tr '+ Коробка', En='+ Box'}"
                                            ToolTip="{l:Tr 'Добавить детали коробки справа от чертежа (ряды по ширине поля станка) и операции: лазер — резка с учётом ширины реза; фреза — контур снаружи с подрезкой углов (dogbone), глубина = толщина + 0,2.', En='Add the box parts to the right of the drawing (rows across the machine width) and the operations: laser — a cut with the kerf compensated; mill — an outside profile with dog-bone corners, depth = thickness + 0.2.'}"
                                            Command="{Binding DataContext.AddFingerBoxCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="{l:Tr 'Вырезы для панели', En='Panel cutouts'}" Margin="0,4,0,0" DataContext="{Binding Cutout}"
                                      ToolTip="{l:Tr 'Готовые вырезы для приборных панелей: отверстия под кнопки, тумблеры и потенциометры (с лыской), D-Sub, USB, XLR, разъём питания, окна дисплеев, вентиляция, крепёж по углам. Размеры типовые — сверьте со своей деталью.', En='Ready cutouts for front panels: holes for buttons, toggles and pots (with a flat), D-Sub, USB, XLR, power jack, display windows, vents, corner mounting holes. Typical sizes — check them against your part.'}">
                                <StackPanel>
                                    <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Cutouts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCutout}" />
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Центр X / Y, поворот °', En='Centre X / Y, turn °'}" />
                                        <TextBox Grid.Column="1" Text="{Binding CenterX}" />
                                        <TextBox Grid.Column="2" Text="{Binding CenterY}" />
                                        <TextBox Grid.Column="3" Text="{Binding Angle}" />
                                    </Grid>
                                    <WrapPanel Margin="0,3,0,0">
                                        <Button Content="{l:Tr 'По выделению', En='From selection'}" ToolTip="{l:Tr 'Центр выреза — центр выделенного (например, нарисованной метки или контура панели для крепежа по углам).', En='The cutout centre is the centre of the selection (e.g. a drawn mark, or the panel outline for corner holes).'}"
                                                Command="{Binding DataContext.CutoutCenterFromSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Margin="4,0,0,0" Content="{l:Tr '+ Вырез', En='+ Cutout'}" ToolTip="{l:Tr 'Добавить вырез на слой «Вырезы»; контуры будут выделены — добавьте операцию (контур внутри, отверстия по спирали, лазер).', En='Add the cutout on the “Cutouts” layer; the contours are selected — add an operation (inside profile, helical holes, laser).'}"
                                                Command="{Binding DataContext.AddPanelCutoutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="{l:Tr 'Шкала для ручки', En='Dial scale'}" Margin="0,4,0,0" DataContext="{Binding Dial}"
                                      ToolTip="{l:Tr 'Дуга с рисками и цифрами вокруг потенциометра или переключателя — для гравировки, лазера или V-карвинга.', En='An arc of ticks and numbers around a pot or a switch — for engraving, laser or V-carving.'}">
                                <StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Центр X / Y, мм', En='Centre X / Y, mm'}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X}" />
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Y}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Радиус рисок, мм', En='Tick radius, mm'}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Radius}" ToolTip="{l:Tr 'Откуда начинаются риски: чуть больше радиуса ручки.', En='Where the ticks start: a little more than the knob radius.'}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Начало °, охват °', En='Start °, sweep °'}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StartAngle}" ToolTip="{l:Tr 'Угол первой риски от оси X против часовой: 225 — слева внизу.', En='Angle of the first tick from the X axis counter-clockwise: 225 — lower left.'}" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Sweep}" ToolTip="{l:Tr 'Сколько градусов по часовой стрелке занимает шкала: потенциометр — 270–300.', En='How many degrees clockwise the scale covers: a pot — 270–300.'}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Делений, длинная каждая', En='Divisions, long every'}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Divisions}" ToolTip="{l:Tr 'Число промежутков между рисками (рисок на одну больше). Переключатель на 6 положений — 5.', En='Number of steps between the ticks (one tick more). A 6-position switch — 5.'}" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding MajorEvery}" ToolTip="{l:Tr 'Каждая N-я риска длинная и с цифрой; 1 — все.', En='Every Nth tick is long and numbered; 1 — all.'}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Длина рисок, мм', En='Tick length, mm'}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinorLength}" ToolTip="{l:Tr 'Короткая риска', En='Short tick'}" />
                                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding MajorLength}" ToolTip="{l:Tr 'Длинная риска', En='Long tick'}" />
                                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Цифры от, до', En='Numbers from, to'}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LabelFrom}" />
                                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding LabelTo}" />
                                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Высота цифр, толщина линий', En='Digit height, line width'}" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LabelHeight}" ToolTip="{l:Tr 'Высота цифр, мм; 0 — без цифр.', En='Digit height, mm; 0 — no numbers.'}" />
                                        <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding StrokeWidth}" ToolTip="{l:Tr '0 — линии (гравировка «Контуром» по линии, лазер). Больше 0 — замкнутые контуры такой ширины (V-карвинг, карман).', En='0 — lines (engraving with a Profile on the line, laser). Above 0 — closed outlines of this width (V-carving, pocket).'}" />
                                        <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:Tr 'Дуга по началу рисок', En='Arc along the ticks'}" IsChecked="{Binding Arc}" />
                                    </Grid>
                                    <WrapPanel Margin="0,3,0,0">
                                        <Button Content="{l:Tr 'По выделению', En='From selection'}" ToolTip="{l:Tr 'Центр шкалы — центр выделенного отверстия под вал.', En='The dial centre is the centre of the selected shaft hole.'}"
                                                Command="{Binding DataContext.DialCenterFromSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Margin="4,0,0,0" Content="{l:Tr '+ Шкала', En='+ Scale'}" ToolTip="{l:Tr 'Добавить риски и цифры на слой «Шкала»; контуры будут выделены.', En='Add the ticks and numbers on the “Scale” layer; the contours are selected.'}"
                                                Command="{Binding DataContext.AddDialScaleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{l:Tr 'Текст', En='Text'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="110" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <Button Content="{l:Tr '+ Текст', En='+ Text'}" ToolTip="{l:Tr 'Добавить надпись любым установленным шрифтом. Буквы становятся контурами, к ним можно применить контур, карман, V-карвинг или лазер.', En='Add text in any installed font. The letters become contours that can be profiled, pocketed, V-carved or lasered.'}" Command="{Binding AddTextCommand}" />
                            <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранную надпись вместе с её буквами-контурами.', En='Delete the selected text together with its letter contours.'}" Command="{Binding RemoveTextCommand}" />
                            <Button Content="{l:Tr 'Выделить буквы', En='Select letters'}" ToolTip="{l:Tr 'Выделить на чертеже все буквы выбранной надписи, чтобы добавить для них операцию.', En='Select all letters of the chosen text on the drawing to add an operation for them.'}" Command="{Binding SelectTextContoursCommand}" />
                            <Button Content="{l:Tr '+ V-карвинг', En='+ V-carve'}" ToolTip="{l:Tr 'Добавить операцию «V-карвинг»: V-фреза режет внутри выделенных контуров (обычно букв), глубина зависит от ширины — острые углы и красивые надписи.', En='Add a “V-carving” operation: a V-bit cuts inside the selected contours (usually letters), the depth follows the width — sharp corners and nice lettering.'}" Command="{Binding AddVCarveCommand}" />
                        </WrapPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Texts}" SelectedItem="{Binding SelectedText}" DisplayMemberPath="Display" ToolTip="{l:Tr 'Список надписей: клик открывает настройки', En='List of texts: a click opens the settings'}" />
                        <TextBlock Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding FontScanStatus}" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedText}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ControlTab" Header="{l:Tr 'Пульт', En='Control'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,6,12,6" DataContext="{Binding Control}">
                            <StackPanel.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                            </StackPanel.Resources>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Подключение (GRBL)', En='Connection (GRBL)'}" Margin="0,0,0,4" />
                            <ComboBox Margin="0,0,0,3" IsEnabled="{Binding IsDisconnected}" ItemsSource="{Binding ConnectionKinds}"
                                      SelectedValuePath="Kind" DisplayMemberPath="Name" SelectedValue="{Binding ConnectionKind}"
                                      ToolTip="{l:Tr 'Как подключаться к станку. USB — кабелем через COM-порт. Telnet — по сети к плате Grbl_Esp32 (MKS DLC32), порт 23. WebSocket (MKS DLC32, Grbl_Esp32) — через веб-интерфейс платы: ответы по WebSocket на порту 81, команды по HTTP на порт 80; плата отдаёт ответы пачками раз в 0,5 с, поэтому для работы лучше telnet. WebSocket-мост — ESP8266 для LaserGRBL или FluidNC: команды прямо в WebSocket.', En='How to connect to the machine. USB — by cable through a COM port. Telnet — over the network to a Grbl_Esp32 board (MKS DLC32), port 23. WebSocket (MKS DLC32, Grbl_Esp32) — through the board web interface: answers over the WebSocket on port 81, commands over HTTP to port 80; the board sends answers in batches every 0.5 s, so telnet is better for work. WebSocket bridge — an ESP8266 for LaserGRBL or FluidNC: commands go into the WebSocket directly.'}" />
                            <DockPanel Margin="0,0,0,3" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Content="↻" Padding="8,0"
                                        ToolTip="{l:Tr 'Заново найти COM-порты — после подключения станка по USB.', En='Look for COM ports again — after plugging the machine in by USB.'}"
                                        Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding IsDisconnected}" />
                                <ComboBox Width="90" DockPanel.Dock="Right" Margin="4,0" ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding BaudRate}" IsEnabled="{Binding IsDisconnected}" ToolTip="{l:Tr 'Скорость порта (обычно 115200)', En='Port speed (usually 115200)'}" />
                                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding IsDisconnected}" ToolTip="{l:Tr 'COM-порт станка; появляется после подключения USB', En='The machine COM port; it appears after plugging in the USB'}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,3" Visibility="{Binding IsNetwork, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsDisconnected}">
                                <TextBox Width="60" DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding NetworkPort}"
                                         ToolTip="{l:Tr 'Порт платы. MKS DLC32 / Grbl_Esp32: telnet — 23 ($ESP131), WebSocket — 81 (порт веб-интерфейса $ESP121 + 1).', En='The board port. MKS DLC32 / Grbl_Esp32: telnet 23 ($ESP131), WebSocket 81 (web interface port $ESP121 + 1).'}" />
                                <TextBlock DockPanel.Dock="Right" Text="{l:Tr 'порт', En='port'}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{l:Tr 'IP-адрес платы. MKS DLC32 в режиме точки доступа (сеть MKS_DLC) — 192.168.4.1; подключённая к роутеру — адрес, показанный на её экране или в списке устройств роутера.', En='IP address of the board. An MKS DLC32 in access point mode (network MKS_DLC) is 192.168.4.1; when joined to a router, use the address shown on its screen or in the router device list.'}" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="{l:Tr 'Подключить', En='Connect'}" ToolTip="{l:Tr 'Открыть выбранный COM-порт или сетевое подключение и связаться с GRBL. Плата по USB обычно перезагружается и отвечает версией прошивки. Закройте другие программы, которые держат порт: плата по сети принимает только одного telnet-клиента. При обрыве связь восстанавливается автоматически.', En='Open the selected COM port or network connection and talk to GRBL. A USB board usually restarts and answers with its firmware version. Close other programs that hold the port: a network board accepts a single telnet client. A dropped connection is restored automatically.'}" Command="{Binding ConnectCommand}" IsEnabled="{Binding IsDisconnected}" />
                                <Button Content="{l:Tr 'Отключить', En='Disconnect'}" ToolTip="{l:Tr 'Закрыть соединение со станком или отменить автоматическое восстановление связи. Если программа выполняется, станок доработает уже принятые команды.', En='Close the connection to the machine or cancel automatic reconnection. If a program is running, the machine finishes the commands it has already received.'}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Состояние', En='State'}" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                <Setter Property="Foreground" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" Foreground="IndianRed" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkX}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" Foreground="MediumSeaGreen" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkY}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Z" Foreground="SteelBlue" FontWeight="Bold" />
                                    <TextBlock Text="{Binding WorkZ}" FontSize="18" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MachineText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding FeedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr 'Разблокировать', En='Unlock'}"
                                        ToolTip="{l:Tr '$X — снять аварию (Alarm) и разрешить движения. Сначала убедитесь, что станок ни во что не упёрся.', En='$X — clear the alarm and allow motion. First make sure the machine is not jammed against anything.'}"
                                        Command="{Binding UnlockCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Домой', En='Home'}"
                                        ToolTip="{l:Tr '$H — поиск дома по концевикам. Работает только если концевики установлены и включены ($22=1).', En='$H — homing on the limit switches. Works only if limit switches are installed and enabled ($22=1).'}"
                                        Command="{Binding HomeCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Сброс', En='Reset'}"
                                        ToolTip="{l:Tr 'Ctrl-X — немедленный сброс контроллера: движение и шпиндель останавливаются. Во время движения положение может сбиться — заново выставьте ноль.', En='Ctrl-X — immediate controller reset: motion and spindle stop. Resetting while moving may lose the position — set zero again.'}"
                                        Command="{Binding SoftResetCommand}" IsEnabled="{Binding IsConnected}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Перемещение', En='Jog'}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Tr 'Шаг, мм', En='Step, mm'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding JogSteps}" SelectedItem="{Binding JogStep}" ToolTip="{l:Tr 'На сколько миллиметров сдвигает одна команда перемещения', En='How many millimetres one jog command moves'}" />
                                <TextBlock Grid.Column="2" Text="{l:Tr 'Подача XY / Z', En='Feed XY / Z'}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="50" Text="{Binding JogFeed}" ToolTip="{l:Tr 'Подача перемещения по XY, мм/мин', En='Jog feed on XY, mm/min'}" />
                                    <TextBox Width="45" Margin="2,0,0,0" Text="{Binding JogFeedZ}" ToolTip="{l:Tr 'Подача перемещения по Z, мм/мин', En='Jog feed on Z, mm/min'}" />
                                </StackPanel>
                            </Grid>
                            <Grid HorizontalAlignment="Left" IsEnabled="{Binding CanControl}">
                                <Grid.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Width" Value="52" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Content="Y+" ToolTip="{l:Tr 'Переместить фрезу назад (Y+) на выбранный шаг: на 3018 стол едет к вам.', En='Move the tool back (Y+) by the selected step: on a 3018 the table moves towards you.'}" Command="{Binding JogCommand}" CommandParameter="Y+" />
                                <Button Grid.Row="1" Grid.Column="0" Content="X−" ToolTip="{l:Tr 'Переместить фрезу влево (X−) на выбранный шаг.', En='Move the tool left (X−) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="X-" />
                                <Button Grid.Row="1" Grid.Column="1" Content="■" ToolTip="{l:Tr 'Остановить перемещение кнопками сразу, не дожидаясь конца шага.', En='Stop jogging immediately without waiting for the end of the step.'}" Command="{Binding JogCancelCommand}" />
                                <Button Grid.Row="1" Grid.Column="2" Content="X+" ToolTip="{l:Tr 'Переместить фрезу вправо (X+) на выбранный шаг.', En='Move the tool right (X+) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="X+" />
                                <Button Grid.Row="2" Grid.Column="1" Content="Y−" ToolTip="{l:Tr 'Переместить фрезу вперёд (Y−) на выбранный шаг: на 3018 стол едет от вас.', En='Move the tool forward (Y−) by the selected step: on a 3018 the table moves away from you.'}" Command="{Binding JogCommand}" CommandParameter="Y-" />
                                <Button Grid.Row="0" Grid.Column="4" Content="Z+" ToolTip="{l:Tr 'Поднять фрезу (Z+) на выбранный шаг.', En='Raise the tool (Z+) by the selected step.'}" Command="{Binding JogCommand}" CommandParameter="Z+" />
                                <Button Grid.Row="2" Grid.Column="4" Content="Z−" ToolTip="{l:Tr 'Опустить фрезу (Z−) на выбранный шаг. Возле заготовки берите шаг 0,1 или 0,01 мм.', En='Lower the tool (Z−) by the selected step. Near the stock use a 0.1 or 0.01 mm step.'}" Command="{Binding JogCommand}" CommandParameter="Z-" />
                            </Grid>

                            <Border Margin="0,6,0,0" Padding="6,4" BorderThickness="1" CornerRadius="3" IsEnabled="{Binding IsConnected}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJogInputEnabled}" Value="True">
                                                <Setter Property="BorderBrush" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <WrapPanel>
                                        <ToggleButton IsChecked="{Binding IsJogInputEnabled}" Padding="8,2"
                                                      ToolTip="{l:Tr 'Включить перемещение станка с клавиатуры и джойстика. Включается только этой кнопкой — случайное нажатие клавиши станок не сдвинет. Работает, пока окно PathForge активно и открыта вкладка «Пульт»; выключается само при отключении станка и запуске программы. Клавиши: стрелки — X/Y, PgUp/PgDn — Z (или цифровой блок 4/6, 8/2, 9/3), Esc или пробел — стоп, +/− — шаг. Джойстик: левая ручка или крестовина — X/Y (скорость зависит от наклона), кнопки 5/6 (LB/RB) — Z вниз/вверх.', En='Turn on jogging with the keyboard and a joystick. Only this button turns it on — a key pressed by accident does not move the machine. Works while the PathForge window is active and the “Control” tab is open; turns itself off on disconnect and when a program starts. Keys: arrows — X/Y, PgUp/PgDn — Z (or the keypad 4/6, 8/2, 9/3), Esc or Space — stop, +/− — step. Joystick: left stick or D-pad — X/Y (speed follows the deflection), buttons 5/6 (LB/RB) — Z down/up.'}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                    <Setter Property="Content" Value="{l:Tr '⌨ Клавиатура и джойстик: выкл.', En='⌨ Keyboard and joystick: off'}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="{l:Tr '⌨ Клавиатура и джойстик: ВКЛЮЧЕНО', En='⌨ Keyboard and joystick: ON'}" />
                                                            <Setter Property="Foreground" Value="IndianRed" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" Content="{l:Tr 'Удержание', En='Hold to move'}" IsChecked="{Binding JogHoldToMove}"
                                                  ToolTip="{l:Tr 'Включено: станок едет, пока клавиша нажата, и останавливается, как только её отпустите (скорость — подача XY / Z). Выключено: каждое нажатие сдвигает на выбранный шаг.', En='On: the machine moves while the key is held and stops as soon as it is released (speed — feed XY / Z). Off: each press moves by the selected step.'}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                               Text="{l:Tr 'Стрелки — X/Y, PgUp/PgDn — Z, Esc/пробел — стоп, +/− — шаг.', En='Arrows — X/Y, PgUp/PgDn — Z, Esc/Space — stop, +/− — step.'}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding JoystickText}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Ноль заготовки', En='Work zero'}" />
                            <WrapPanel IsEnabled="{Binding CanControl}">
                                <Button Content="X0" ToolTip="{l:Tr 'Принять текущее положение фрезы за X0 заготовки (G10 L20).', En='Set the current tool position as work X0 (G10 L20).'}" Command="{Binding ZeroCommand}" CommandParameter="X" />
                                <Button Content="Y0" ToolTip="{l:Tr 'Принять текущее положение фрезы за Y0 заготовки (G10 L20).', En='Set the current tool position as work Y0 (G10 L20).'}" Command="{Binding ZeroCommand}" CommandParameter="Y" />
                                <Button Content="Z0" ToolTip="{l:Tr 'Принять текущую высоту фрезы за Z0. Обычно фреза касается верха заготовки (проверка бумажкой).', En='Set the current tool height as Z0. Usually the tool just touches the stock top (paper test).'}" Command="{Binding ZeroCommand}" CommandParameter="Z" />
                                <Button Content="X0 Y0" ToolTip="{l:Tr 'Принять текущее положение фрезы за X0 Y0 — угол или центр заготовки, выбранный на вкладке «Станок».', En='Set the current tool position as X0 Y0 — the stock corner or centre chosen on the “Machine” tab.'}" Command="{Binding ZeroCommand}" CommandParameter="XY" />
                                <Button Content="{l:Tr 'Все', En='All'}" ToolTip="{l:Tr 'Принять текущее положение фрезы за ноль по всем осям: X0 Y0 Z0.', En='Set the current tool position as zero on all axes: X0 Y0 Z0.'}" Command="{Binding ZeroCommand}" CommandParameter="XYZ" />
                                <Button Content="{l:Tr 'К нулю X Y', En='Go to X0 Y0'}" ToolTip="{l:Tr 'Поднять фрезу на безопасную высоту и переехать в X0 Y0 — проверить, где у заготовки ноль.', En='Raise the tool to the safe height and move to X0 Y0 — to check where the work zero is.'}" Command="{Binding GoToZeroCommand}" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0" IsEnabled="{Binding CanControl}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'Щуп: толщина пластины, мм', En='Probe: plate thickness, mm'}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Width="60" Text="{Binding ProbePlate}" ToolTip="{l:Tr 'Толщина пластины щупа: вычтется при установке Z0', En='Probe plate thickness: subtracted when Z0 is set'}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Ход вниз, мм / подача, мм/мин', En='Travel down, mm / feed, mm/min'}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="40" Text="{Binding ProbeTravel}" ToolTip="{l:Tr 'На сколько фреза может опуститься в поисках касания', En='How far the tool may go down while searching for contact'}" />
                                    <TextBox Width="40" Margin="2,0,0,0" Text="{Binding ProbeFeed}" ToolTip="{l:Tr 'Скорость опускания при поиске касания, мм/мин', En='Feed while probing down, mm/min'}" />
                                </StackPanel>
                                <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="{l:Tr 'Найти Z щупом', En='Probe Z'}" ToolTip="{l:Tr 'G38.2: фреза опускается до касания пластины щупа, затем Z0 ставится на поверхность заготовки с учётом толщины пластины. Зажим щупа — на фрезе.', En='G38.2: the tool goes down until it touches the probe plate, then Z0 is set on the stock surface, taking the plate thickness into account. Probe clip on the tool.'}" Command="{Binding ProbeZCommand}" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Карта высот (платы)', En='Height map (PCB)'}" />
                            <Grid IsEnabled="{Binding IsConnected}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'X от / до', En='X from / to'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LevelMinX}" ToolTip="{l:Tr 'Левый край сетки карты высот', En='Left edge of the height map grid'}" />
                                <TextBox Grid.Row="0" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelMaxX}" ToolTip="{l:Tr 'Правый край сетки карты высот', En='Right edge of the height map grid'}" />
                                <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Margin="4,0,0,0" Content="{l:Tr 'Из программы', En='From program'}" ToolTip="{l:Tr 'Взять область карты высот из траекторий проекта (все резы + 1 мм).', En='Take the height map area from the project toolpaths (all cuts + 1 mm).'}" Command="{Binding LevelAreaFromProgramCommand}" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Y от / до', En='Y from / to'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LevelMinY}" ToolTip="{l:Tr 'Нижний край сетки карты высот', En='Bottom edge of the height map grid'}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelMaxY}" ToolTip="{l:Tr 'Верхний край сетки карты высот', En='Top edge of the height map grid'}" />
                                <TextBlock Grid.Row="2" Text="{l:Tr 'Шаг / подача', En='Step / feed'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LevelStep}" ToolTip="{l:Tr 'Расстояние между точками, мм (5–15)', En='Distance between points, mm (5–15)'}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelFeed}" ToolTip="{l:Tr 'Скорость щупа, мм/мин', En='Probe speed, mm/min'}" />
                                <TextBlock Grid.Row="3" Text="{l:Tr 'Подъём / глубина', En='Clearance / depth'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LevelClearance}" ToolTip="{l:Tr 'Высота переездов между точками, мм', En='Travel height between points, mm'}" />
                                <TextBox Grid.Row="3" Grid.Column="2" Margin="2,0,0,0" Text="{Binding LevelDepth}" ToolTip="{l:Tr 'Насколько ниже Z0 искать поверхность, мм', En='How far below Z0 to search for the surface, mm'}" />
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr 'Снять карту', En='Probe map'}" ToolTip="{l:Tr 'Снять карту высот: щуп обходит сетку точек змейкой и измеряет неровность платы. В первой точке ставится Z0.', En='Probe the height map: the probe visits a grid of points and measures how uneven the board is. Z0 is set at the first point.'}" Command="{Binding ProbeMapCommand}" IsEnabled="{Binding CanControl}" />
                                <Button Content="{l:Tr 'Удалить карту', En='Delete map'}" ToolTip="{l:Tr 'Удалить снятую карту высот из проекта.', En='Delete the measured height map from the project.'}" Command="{Binding ClearMapCommand}" IsEnabled="{Binding HasLevelingMap}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LevelingText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding LevelingTable}" FontFamily="Consolas" FontSize="11" Margin="0,2" />
                            <CheckBox Content="{l:Tr 'Учитывать карту высот при запуске', En='Apply the height map when running'}" IsChecked="{Binding UseLeveling}" IsEnabled="{Binding HasLevelingMap}"
                                      ToolTip="{l:Tr 'Каждая линия делится на отрезки по 1 мм, к Z добавляется высота платы в этой точке', En='Every line is split into 1 mm segments, the board height at that point is added to Z'}" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Программа', En='Program'}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Файл…', En='File…'}" ToolTip="{l:Tr 'Выбрать готовый файл G-code (.nc, .gcode, .tap…) и запускать его вместо G-code проекта.', En='Choose an existing G-code file (.nc, .gcode, .tap…) to run instead of the project G-code.'}" Command="{Binding LoadFileCommand}" />
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Проект', En='Project'}" ToolTip="{l:Tr 'Снова запускать G-code текущего проекта вместо выбранного файла.', En='Run the G-code of the current project again instead of the chosen file.'}" Command="{Binding UseProjectCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding ProgramSource}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr '⬚ Обвести рамку', En='⬚ Trace frame'}" Command="{Binding FrameCommand}" IsEnabled="{Binding CanStartJob}"
                                        ToolTip="{l:Tr 'Проехать по прямоугольнику вокруг всех рабочих ходов программы и вернуться в начальный угол — видно, где будет резка и помещается ли задание на заготовку. Лазер (профиль с $32=1) светит на малой мощности: по точке видны края. Фрезер едет на безопасной высоте, шпиндель не включается.', En='Run along the rectangle around all work moves of the program and return to the start corner — you see where the cut will be and whether the job fits the stock. A laser (profile with $32=1) shines at low power: the dot shows the edges. A milling machine moves at the safe height, the spindle stays off.'}" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" Text="{l:Tr 'мощность, %', En='power, %'}" />
                                <TextBox Width="45" Text="{Binding FramePowerPercent}"
                                         ToolTip="{l:Tr 'Мощность лазера при обводке: 1–2 % — точку видно, но материал не горит. 0 — луч не включать (только движение).', En='Laser power while tracing: at 1–2 % the dot is visible but the material does not burn. 0 — keep the beam off (motion only).'}" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" Text="{l:Tr 'скорость, мм/мин', En='speed, mm/min'}" />
                                <TextBox Width="55" Text="{Binding FrameFeed}" ToolTip="{l:Tr 'Скорость обхода рамки', En='Speed along the frame'}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{l:Tr '▶ Старт', En='▶ Start'}" FontWeight="SemiBold" ToolTip="{l:Tr 'Запустить программу на станке. Перед стартом проверьте: заготовка закреплена, ноль X/Y/Z выставлен, в шпинделе нужная фреза.', En='Start the program on the machine. Before starting check: the stock is clamped, X/Y/Z zero is set, the right tool is in the spindle.'}" Command="{Binding StartJobCommand}" IsEnabled="{Binding CanStartJob}" />
                                <Button Content="{l:Tr 'Проверить ($C)', En='Check ($C)'}" Command="{Binding CheckProgramCommand}" IsEnabled="{Binding CanStartJob}"
                                        ToolTip="{l:Tr 'Прогнать программу через режим проверки GRBL ($C): плата разбирает каждую строку со своими настройками (мягкие пределы, поддерживаемые команды), но станок не двигается и шпиндель не включается. Ошибочные строки появятся в журнале, итог — в сообщениях. В конце GRBL выходит из режима и перезапускается.', En='Run the program through GRBL check mode ($C): the board parses every line with its own settings (soft limits, supported commands), but the machine does not move and the spindle stays off. Faulty lines appear in the log, the summary in the messages. At the end GRBL leaves the mode and restarts.'}" />
                                <Button Content="{l:Tr '❚❚ Пауза', En='❚❚ Pause'}" ToolTip="{l:Tr 'Плавно остановить подачу (feed hold). Положение сохраняется, «Продолжить» — ехать дальше.', En='Stop the feed smoothly (feed hold). The position is kept; “Resume” continues.'}" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" />
                                <Button Content="{l:Tr 'Продолжить', En='Resume'}" ToolTip="{l:Tr 'Продолжить программу после паузы, смены инструмента (M0) или ошибки в строке (ошибочная строка пропускается).', En='Continue the program after a pause, a tool change (M0) or a line error (the failed line is skipped).'}" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" />
                                <Button Content="{l:Tr '■ Стоп', En='■ Stop'}" ToolTip="{l:Tr 'Прервать программу: станок плавно тормозит, затем GRBL сбрасывается и шпиндель останавливается. Положение не теряется.', En='Abort the program: the machine decelerates, then GRBL is reset and the spindle stops. The position is kept.'}" Command="{Binding StopCommand}" IsEnabled="{Binding IsJobActive}" />
                            </WrapPanel>
                            <ProgressBar Height="12" Margin="0,4" Maximum="100" Value="{Binding Progress}" ToolTip="{l:Tr 'Прогресс выполнения программы', En='Program progress'}" />
                            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding JobMessage}" TextWrapping="Wrap" Foreground="DarkOrange" FontWeight="SemiBold" Margin="0,2" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{l:Tr 'Со строки', En='From line'}" />
                                <Button DockPanel.Dock="Right" Content="{l:Tr '▶ С этой строки', En='▶ From this line'}" Command="{Binding StartFromLineCommand}" IsEnabled="{Binding CanStartJob}"
                                        ToolTip="{l:Tr 'Продолжить программу с указанной строки — после сломанной фрезы, пропадания питания или остановки. PathForge восстановит режимы всех строк до неё (единицы, система координат, подача, шпиндель), поднимет фрезу на безопасную высоту, переедет к началу строки, включит шпиндель и опустится с подачей врезания. После остановки номер подставляется сам — на ~20 строк раньше последней принятой GRBL: плата принимает строки с опережением. После пропадания питания сначала выставьте ноль X/Y/Z точно там же, где он был.', En='Continue the program from the given line — after a broken cutter, a power cut or a stop. PathForge restores the modes of all lines before it (units, coordinate system, feed, spindle), lifts the tool to the safe height, moves over the start of the line, starts the spindle and goes down with the plunge feed. After a stop the number is filled in — ~20 lines before the last one GRBL accepted: the board takes lines ahead of the machine. After a power cut first set the X/Y/Z zero exactly where it was.'}" />
                                <TextBox Margin="6,0" Text="{Binding ResumeLine}" ToolTip="{l:Tr 'Номер строки программы (как в журнале и в сообщениях об ошибках).', En='Program line number (as in the log and in error messages).'}" />
                            </DockPanel>
                            <Grid Margin="0,4,0,0" IsEnabled="{Binding IsConnected}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'Подача', En='Feed'}" VerticalAlignment="Center" />
                                <Button Grid.Row="0" Grid.Column="1" Content="−10 %" ToolTip="{l:Tr 'Уменьшить подачу на 10 % прямо во время работы (визг, вибрация, подгорание).', En='Reduce the feed by 10 % while running (screeching, vibration, burning).'}" Command="{Binding FeedOverrideCommand}" CommandParameter="-" />
                                <Button Grid.Row="0" Grid.Column="2" Content="100 %" ToolTip="{l:Tr 'Вернуть подачу из программы (100 %).', En='Back to the programmed feed (100 %).'}" Command="{Binding FeedOverrideCommand}" CommandParameter="0" />
                                <Button Grid.Row="0" Grid.Column="3" Content="+10 %" ToolTip="{l:Tr 'Увеличить подачу на 10 % прямо во время работы.', En='Increase the feed by 10 % while running.'}" Command="{Binding FeedOverrideCommand}" CommandParameter="+" />
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Шпиндель', En='Spindle'}" VerticalAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="1" Content="−10 %" ToolTip="{l:Tr 'Уменьшить обороты шпинделя (или мощность лазера) на 10 %.', En='Reduce the spindle speed (or laser power) by 10 %.'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="-" />
                                <Button Grid.Row="1" Grid.Column="2" Content="100 %" ToolTip="{l:Tr 'Вернуть обороты (мощность) из программы (100 %).', En='Back to the programmed speed (power) (100 %).'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="0" />
                                <Button Grid.Row="1" Grid.Column="3" Content="+10 %" ToolTip="{l:Tr 'Увеличить обороты шпинделя (или мощность лазера) на 10 %.', En='Increase the spindle speed (or laser power) by 10 %.'}" Command="{Binding SpindleOverrideCommand}" CommandParameter="+" />
                            </Grid>
                            <TextBlock Text="{Binding OverridesText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Консоль', En='Console'}" />
                            <DockPanel IsEnabled="{Binding IsConnected}">
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Отправить', En='Send'}" ToolTip="{l:Tr 'Отправить команду из строки консоли в GRBL (Enter). Например: $$ — настройки, $G — режимы, $I — версия.', En='Send the console line to GRBL (Enter). For example: $$ — settings, $G — modes, $I — version.'}" Command="{Binding SendConsoleCommand}" />
                                <TextBox Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                         ToolTip="{l:Tr 'Команда GRBL, например $$ (настройки), $G (режимы), $I (версия)', En='GRBL command, e.g. $$ (settings), $G (modes), $I (version)'}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendConsoleCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <ListBox Height="200" Margin="0,4,0,0" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11" ToolTip="{l:Tr 'Журнал команд и ответов GRBL', En='Log of GRBL commands and replies'}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:Tr 'Инструменты', En='Tools'}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{l:Tr 'Добавить', En='Add'}" ToolTip="{l:Tr 'Добавить в проект инструмент из выбранного пресета: диаметр, обороты, подачи и шаг по глубине для 3018.', En='Add a tool from the selected preset to the project: diameter, speed, feeds and step-down for a 3018.'}" Command="{Binding AddToolFromPresetCommand}" />
                                <ComboBox ItemsSource="{Binding ToolPresetOptions}" SelectedValue="{Binding SelectedToolPreset}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="{l:Tr 'Пресеты для CNC 3018 (шпиндель ~10 000 об/мин)', En='Presets for a CNC 3018 (spindle ~10,000 rpm)'}" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="{l:Tr '+ Вся группа', En='+ Whole group'}" ToolTip="{l:Tr 'Добавить все пресеты той же группы, что выбранный в списке (например, все свёрла для плат или все фрезы по дереву). Уже добавленные не повторяются.', En='Add all presets of the same group as the one chosen in the list (e.g. all PCB drills or all wood cutters). Ones already added are not repeated.'}" Command="{Binding AddToolPresetGroupCommand}" />
                                <Button Content="{l:Tr '+ Все пресеты', En='+ All presets'}" ToolTip="{l:Tr 'Добавить в проект всю библиотеку популярных фрез и свёрл под цангу ER11 для 3018 (лазеры — только при профиле лазера). Уже добавленные не повторяются; лишние можно удалить.', En='Add the whole library of popular ER11 cutters and drills for a 3018 to the project (lasers only with a laser profile). Ones already added are not repeated; remove the ones you do not need.'}" Command="{Binding AddAllToolPresetsCommand}" />
                                <Button Content="{l:Tr '+ Пустой', En='+ Empty'}" ToolTip="{l:Tr 'Добавить пустой инструмент и заполнить его данные вручную.', En='Add an empty tool and fill in its data by hand.'}" Command="{Binding AddToolCommand}" />
                                <Button Content="{l:Tr 'Удалить', En='Delete'}" ToolTip="{l:Tr 'Удалить выбранный инструмент. Инструмент, который используют операции, удалить нельзя.', En='Delete the selected tool. A tool used by operations cannot be deleted.'}" Command="{Binding RemoveToolCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" DisplayMemberPath="Display" ToolTip="{l:Tr 'Инструменты проекта: клик открывает настройки', En='Project tools: a click opens the settings'}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ContentControl Content="{Binding SelectedTool}" Margin="0,0,6,0" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:Tr 'Станок', En='Machine'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,4" Text="{l:Tr 'Профиль станка', En='Machine profile'}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="4,3,0,3" Content="{l:Tr 'Применить', En='Apply'}" ToolTip="{l:Tr 'Применить выбранный профиль станка: формат G-code, обороты, подачи, рабочее поле, лазерный режим. Свои строки в начале и конце программы сохраняются.', En='Apply the selected machine profile: G-code format, spindle speed, feeds, work area, laser mode. Custom start and end lines are kept.'}" Command="{Binding ApplyProfileCommand}" />
                                <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile}" ToolTip="{l:Tr 'Готовый профиль станка: рабочее поле, обороты, подачи и формат G-code', En='A ready machine profile: work area, speeds, feeds and G-code format'}" />
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedProfile.Description}" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"><Run Text="{l:Tr 'Сейчас:', En='Current:'}" /> <Run Text="{Binding Machine.ProfileName, Mode=OneWay}" /></TextBlock>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Заготовка и ноль', En='Stock and zero'}" />
                            <Grid DataContext="{Binding Stock}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Толщина заготовки, мм', En='Stock thickness, mm'}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Thickness}" ToolTip="{l:Tr 'Толщина материала: от неё считаются глубина и безопасная высота', En='Material thickness: the depth and safe height are calculated from it'}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ноль X/Y', En='Zero X/Y'}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:Choices.Origins}" ToolTip="{l:Tr 'Где у чертежа точка X0 Y0: угол или центр', En='Where the drawing X0 Y0 sits: a corner or the centre'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Origin}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ноль Z', En='Zero Z'}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:Choices.ZeroLevels}" ToolTip="{l:Tr 'Z0 на верхней или на нижней грани заготовки', En='Z0 on the top or on the bottom face of the stock'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ZeroAtBottom}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{l:Tr 'Ноль X/Y берётся от габарита всего чертежа. На станке выставьте ноль фрезы в эту точку.', En='Zero X/Y is taken from the bounds of the whole drawing. Set the tool zero at this point on the machine.'}" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr 'Станок и G-code', En='Machine and G-code'}" />
                            <Grid DataContext="{Binding Machine}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Формат G-code', En='G-code format'}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:Choices.Dialects}" ToolTip="{l:Tr 'Формат G-code: GRBL, Marlin и другие', En='G-code dialect: GRBL, Marlin and others'}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dialect}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Макс. обороты, об/мин', En='Max spindle speed, rpm'}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpindleMaxRpm}" ToolTip="{l:Tr 'Максимальные обороты шпинделя: S в G-code пишется как доля от них', En='Maximum spindle speed: the G-code S is written as a fraction of it'}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:Tr 'S при макс. оборотах', En='S at max speed'}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpindleMaxS}"
                                         ToolTip="{l:Tr 'GRBL: значение $30 (обычно 1000). 0 — писать обороты как есть.', En='GRBL: the $30 value (usually 1000). 0 — write the speed as is.'}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Макс. подача, мм/мин', En='Max feed, mm/min'}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxFeedRate}" ToolTip="{l:Tr '0 — не проверять', En='0 — do not check'}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Рабочее поле X, мм', En='Work area X, mm'}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WorkAreaX}" ToolTip="{l:Tr '0 — не проверять', En='0 — do not check'}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Рабочее поле Y, мм', En='Work area Y, mm'}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WorkAreaY}" ToolTip="{l:Tr 'Рабочее поле по Y, мм; 0 — не проверять', En='Work area along Y, mm; 0 — do not check'}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ход Z, мм', En='Z travel, mm'}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WorkAreaZ}" ToolTip="{l:Tr 'Ход по Z, мм; 0 — не проверять', En='Z travel, mm; 0 — do not check'}" />
                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Безопасная высота, мм', En='Safe height, mm'}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SafeZ}" ToolTip="{l:Tr 'Над верхом заготовки', En='Above the stock top'}" />
                                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Подход к заготовке, мм', En='Approach clearance, mm'}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ApproachClearance}" ToolTip="{l:Tr 'Зазор над заготовкой при подходе на рабочей подаче', En='Clearance above the stock when approaching at cutting feed'}" />
                                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Холостой ход, мм/мин', En='Rapid rate, mm/min'}" />
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RapidRate}" ToolTip="{l:Tr 'Только для оценки времени', En='Only for the time estimate'}" />
                                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Знаков после запятой', En='Decimal places'}" />
                                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding DecimalPlaces}" ToolTip="{l:Tr 'Точность координат в файле; 3–4 обычно достаточно', En='Coordinate precision in the file; 3–4 is usually enough'}" />
                                <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Пауза после M3, с', En='Dwell after M3, s'}" />
                                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding SpindleDelaySeconds}" ToolTip="{l:Tr 'Пауза после включения шпинделя, чтобы он набрал обороты', En='Dwell after the spindle starts so it can spin up'}" />
                                <TextBlock Grid.Row="12" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Обдув лазера', En='Laser air assist'}" />
                                <ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{x:Static vm:Choices.CoolantCommands}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AirAssistCommand}"
                                          ToolTip="{l:Tr 'Какой командой включать обдув в операциях с галочкой «Обдув»; выключается всегда M9. M8 (Flood) — выход охлаждения, он есть у GRBL всегда, к нему обычно и подключают компрессор. M7 (Mist) GRBL понимает, только если собран с ENABLE_M7.', En='Which command switches the air on in operations with “Air assist” ticked; it is always switched off with M9. M8 (Flood) is the coolant output GRBL always has, the pump is usually connected to it. GRBL understands M7 (Mist) only when built with ENABLE_M7.'}" />
                                <CheckBox Grid.Row="13" Grid.Column="1" Content="{l:Tr 'Автосмена инструмента (Tn M6)', En='Automatic tool change (Tn M6)'}" IsChecked="{Binding UseToolChange}"
                                          ToolTip="{l:Tr 'Не для GRBL: там смена инструмента — пауза M0', En='Not for GRBL: there a tool change is an M0 pause'}" />
                                <StackPanel Grid.Row="14" Grid.Column="1">
                                    <CheckBox Content="{l:Tr 'В конце вернуться в X0 Y0', En='Return to X0 Y0 at the end'}" IsChecked="{Binding ReturnToOrigin}" ToolTip="{l:Tr 'В конце программы фреза вернётся в X0 Y0', En='At the end of the program the tool returns to X0 Y0'}" />
                                    <CheckBox Content="{l:Tr 'Дуги G2/G3 вместо коротких отрезков', En='G2/G3 arcs instead of short segments'}" IsChecked="{Binding UseArcs}"
                                              ToolTip="{l:Tr 'Файл короче, движение плавнее. Нужны 3 знака после запятой.', En='Shorter file, smoother motion. Needs 3 decimal places.'}" />
                                </StackPanel>
                                <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="{l:Tr 'Свои строки в начале программы', En='Custom lines at the program start'}" />
                                <TextBox Grid.Row="16" Grid.ColumnSpan="2" Height="70" AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding Header}" ToolTip="{l:Tr 'Эти строки пишутся в начало файла G-code (например, настройка станка)', En='These lines are written at the start of the G-code file (e.g. machine setup)'}" />
                                <TextBlock Grid.Row="17" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="{l:Tr 'Свои строки в конце программы', En='Custom lines at the program end'}" />
                                <TextBox Grid.Row="18" Grid.ColumnSpan="2" Height="70" AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding Footer}" ToolTip="{l:Tr 'Эти строки пишутся в конец файла G-code (например, M30)', En='These lines are written at the end of the G-code file (e.g. M30)'}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushLight}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="5" />
                    <RowDefinition x:Name="BottomPanelRow" Height="200" MinHeight="80" />
                </Grid.RowDefinitions>
                <TabControl x:Name="ViewTabs" Grid.Row="0" Padding="0">
                    <TabItem Header="{l:Tr 'Чертёж (2D)', En='Drawing (2D)'}">
                        <Grid>
                            <controls:CamViewport x:Name="Viewport"
                                                  Scene="{Binding Scene}"
                                                  MachinePosition="{Binding Control.ToolPosition}"
                                                  ContourClickCommand="{Binding ContourClickedCommand}"
                                                  BoxSelectCommand="{Binding BoxSelectCommand}"
                                                  CursorText="{Binding CursorText, Mode=OneWayToSource}">
                                <controls:CamViewport.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                                </controls:CamViewport.InputBindings>
                                <controls:CamViewport.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Tr 'Выделить всё', En='Select all'}" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                                        <MenuItem Header="{l:Tr 'Выделить окружности', En='Select circles'}" Command="{Binding SelectCirclesCommand}" />
                                        <MenuItem Header="{l:Tr 'Выделить отверстия того же диаметра', En='Select holes of the same diameter'}" Command="{Binding SelectSameDiameterCommand}" />
                                        <MenuItem Header="{l:Tr 'Снять выделение', En='Clear selection'}" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" />
                                        <MenuItem Header="{l:Tr 'Удалить выделенное', En='Delete selected'}" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
                                        <Separator />
                                        <MenuItem Header="{l:Tr 'Показать всё', En='Zoom to fit'}" InputGestureText="Home" Command="{Binding ZoomToFitCommand}" />
                                    </ContextMenu>
                                </controls:CamViewport.ContextMenu>
                            </controls:CamViewport>
                            <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#8A939E" IsHitTestVisible="False"
                                       Text="{l:Tr 'Колесо — масштаб · перетаскивание — сдвиг · клик — выбор контура (Ctrl — добавить) · Shift+протянуть — рамкой (вправо — целиком внутри, влево — задетые) · Ctrl+A — выделить всё · Esc — снять · Del — удалить · правая кнопка — меню · Home — показать всё', En='Wheel — zoom · drag — pan · click — select a contour (Ctrl — add) · Shift+drag — by a box (to the right — wholly inside, to the left — touched) · Ctrl+A — select all · Esc — clear · Del — delete · right click — menu · Home — fit all'}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{l:Tr '3D-симуляция', En='3D simulation'}" IsSelected="{Binding Simulation.IsActive, Mode=TwoWay}">
                        <DockPanel DataContext="{Binding Simulation}">
                            <Border DockPanel.Dock="Bottom" Padding="6,4" Background="{DynamicResource PanelBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="⏮" ToolTip="{l:Tr 'Перемотать симуляцию в начало: заготовка ещё не обработана.', En='Rewind the simulation to the start: the stock is untouched.'}" Command="{Binding ToStartCommand}" />
                                        <Button DockPanel.Dock="Left" MinWidth="80" Content="{Binding PlayLabel}" ToolTip="{l:Tr 'Запустить или приостановить воспроизведение обработки с выбранной скоростью.', En='Play or pause the machining at the selected speed.'}" Command="{Binding PlayPauseCommand}" />
                                        <Button DockPanel.Dock="Left" Content="⏭" ToolTip="{l:Tr 'Показать готовую деталь — результат всей программы.', En='Show the finished part — the result of the whole program.'}" Command="{Binding ToEndCommand}" />
                                        <ComboBox DockPanel.Dock="Left" Width="140" Margin="4,0" ItemsSource="{Binding Speeds}"
                                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedSpeed}" ToolTip="{l:Tr 'Скорость воспроизведения', En='Playback speed'}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding TimeText}" />
                                        <Slider Minimum="0" Maximum="1000" VerticalAlignment="Center" Value="{Binding Position}"
                                                ToolTip="{l:Tr 'Перетащите, чтобы посмотреть заготовку в любой момент обработки', En='Drag to see the stock at any moment of machining'}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="{l:Tr 'Пересчитать', En='Recalculate'}" ToolTip="{l:Tr 'Пересчитать симуляцию заново, например после смены точности сетки.', En='Recalculate the simulation, for example after changing the grid accuracy.'}" Command="{Binding RebuildCommand}" />
                                        <ComboBox DockPanel.Dock="Right" Width="150" Margin="4,0" ItemsSource="{Binding Qualities}"
                                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedQuality}" ToolTip="{l:Tr 'Точность сетки', En='Grid accuracy'}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding OperationText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatsText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Content="{l:Tr 'Траектория текущей операции', En='Path of the current operation'}" IsChecked="{Binding ShowPath}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  ToolTip="{l:Tr 'Показать поверх заготовки траекторию операции, которая сейчас выполняется (голубые линии): видно, куда фреза пойдёт дальше.', En='Show the toolpath of the operation being machined over the stock (light blue lines): you see where the tool goes next.'}" />
                                        <CheckBox Content="{l:Tr 'Сравнить с моделью, допуск, мм', En='Compare with the model, tolerance, mm'}" IsChecked="{Binding ShowComparison}" IsEnabled="{Binding HasModel}" VerticalAlignment="Center"
                                                  ToolTip="{l:Tr 'Раскрасить заготовку по отличию от 3D-модели рельефа (картинка или STL): зелёный — в допуске, синий — остался материал (недорез: фреза не достала или крупный шаг), красный — срезано лишнее (зарез). Доступно, если в проекте есть рельеф.', En='Colour the stock by its difference from the relief 3D model (picture or STL): green — within tolerance, blue — material left (the tool could not reach or the step is large), red — cut too deep (gouge). Available when the project has a relief.'}" />
                                        <TextBox Width="50" Margin="4,0,0,0" Text="{Binding ComparisonTolerance}" IsEnabled="{Binding ShowComparison}" ToolTip="{l:Tr 'Отклонение, которое считается допустимым', En='Deviation counted as acceptable'}" />
                                        <Button Margin="8,0,0,0" Content="{l:Tr '+ Дообработка остатков', En='+ Rest machining'}" IsEnabled="{Binding HasModel}"
                                                ToolTip="{l:Tr 'Добавить после рельефа операцию дообработки: копию рельефа меньшей фрезой (сферической или гравёром из инструментов проекта), которая проходит только там, где по результату симуляции над моделью остался материал (синие места при сравнении).', En='Add a rest machining operation after the relief: a copy of the relief with a smaller tool (a ball nose or V-bit from the project tools) that goes only where the simulation leaves material above the model (the blue areas of the comparison).'}"
                                                Command="{Binding DataContext.AddReliefRestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <CheckBox Content="{l:Tr 'Карта высот, увеличение ×', En='Height map, exaggeration ×'}" IsChecked="{Binding ShowHeightMap}" IsEnabled="{Binding HasHeightMap}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                  ToolTip="{l:Tr 'Показать снятую щупом карту высот платы (вкладка «Пульт» → «Карта высот») цветной полупрозрачной поверхностью над заготовкой: синее — ниже, красное — выше. Неровности в сотые доли миллиметра растянуты по высоте в заданное число раз.', En='Show the height map probed on the board (“Control” tab → “Height map”) as a coloured see-through surface over the stock: blue is lower, red is higher. Unevenness of hundredths of a millimetre is stretched vertically by the given factor.'}" />
                                        <TextBox Width="50" Margin="4,0,0,0" Text="{Binding HeightMapScale}" IsEnabled="{Binding ShowHeightMap}" ToolTip="{l:Tr 'Во сколько раз растянуть высоты карты', En='How many times to stretch the map heights'}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding HeightMapText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ComparisonText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="DarkOrange" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <controls:SimulationView Frame="{Binding Frame}" />
                                <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#8A939E" IsHitTestVisible="False"
                                           Text="{l:Tr 'Левая кнопка — вращение · правая — сдвиг · колесо — масштаб · двойной клик — исходный вид', En='Left button — rotate · right — pan · wheel — zoom · double click — default view'}" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushLight}" />
                <TabControl x:Name="BottomTabs" Grid.Row="2">
                    <TabItem Header="G-code">
                        <ListBox x:Name="GcodeList" ItemsSource="{Binding GcodeLines}" FontFamily="Consolas" Margin="0" SelectionMode="Extended"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ToolTip="{l:Tr 'Готовый G-code всех включённых операций (во время работы станка — выполняемая программа). Подсвечена строка, которую сейчас выполняет станок или 3D-симуляция. Ctrl+C — копировать выделенные строки (без выделения — всю программу).', En='Generated G-code of all enabled operations (while the machine works — the running program). The line the machine or the 3D simulation is executing now is highlighted. Ctrl+C copies the selected lines (with nothing selected — the whole program).'}">
                            <ListBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyGcode" />
                            </ListBox.CommandBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Tr 'Копировать', En='Copy'}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="{l:Tr 'Копировать всю программу', En='Copy the whole program'}" Click="OnCopyAllGcode" />
                                    <MenuItem Header="{l:Tr 'К текущей строке', En='Go to the current line'}" Click="OnShowCurrentGcodeLine" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Line" Padding="2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Number" MinWidth="56" Margin="0,0,10,0" TextAlignment="Right" Opacity="0.55" Text="{Binding Number}" />
                                            <TextBlock x:Name="Code" Text="{Binding Text}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="White" />
                                            <Setter TargetName="Code" Property="Foreground" Value="White" />
                                            <Setter TargetName="Code" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="{l:Tr 'Сообщения', En='Messages'}">
                        <ListBox ItemsSource="{Binding Messages}" ToolTip="{l:Tr 'Сообщения программы', En='Program messages'}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
