                                ToolTip="{l:Tr 'Загрузить другой источник рельефа: картинку (яркость → глубина) или 3D-модель STL, в зависимости от типа операции. Размеры и режимы останутся прежними.', En='Load another relief source: a picture (brightness → depth) or an STL 3D model, depending on the operation. Size and settings stay as they are.'}"
                                Command="{Binding DataContext.ReplaceReliefSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SourceInfo}" />
                    </DockPanel>
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:Tr 'X, мм (левый край)', En='X, mm (left edge)'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding X}" ToolTip="{l:Tr 'Положение левого края в чертеже, мм', En='Position of the left edge in the drawing, mm'}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Y, мм (нижний край)', En='Y, mm (bottom edge)'}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Y}" ToolTip="{l:Tr 'Положение нижнего края в чертеже, мм', En='Position of the bottom edge in the drawing, mm'}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ширина, мм', En='Width, mm'}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WidthMm}" ToolTip="{l:Tr 'Ширина в чертеже, мм; высота подстроится по пропорциям', En='Width in the drawing, mm; the height follows the aspect ratio'}" />
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Длина, мм', En='Length, mm'}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="{Binding HeightMm, StringFormat='{}{0:0.#}'}" />
                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Глубина, мм', En='Depth, mm'}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Depth}" ToolTip="{l:Tr 'Глубина в самых тёмных местах рельефа', En='Depth at the darkest spots of the relief'}" />
                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Начало (Z), мм', En='Start (Z), mm'}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding StartZ}" ToolTip="{l:Tr 'Высота начала обработки: 0 — верх заготовки', En='Height where machining starts: 0 — stock top'}" />
                    <CheckBox Grid.Row="10" Grid.Column="1" Content="{l:Tr 'Инверсия (светлое — глубже)', En='Invert (light is deeper)'}" IsChecked="{Binding Invert}" IsEnabled="{Binding IsImage}" ToolTip="{l:Tr 'Инвертировать картинку: светлое станет глубже тёмного', En='Invert the picture: light areas become deeper than dark ones'}" />
                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг сетки, мм', En='Grid step, mm'}" />
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Resolution}" ToolTip="{l:Tr 'Точность модели: меньше — точнее, но дольше расчёт', En='Model accuracy: smaller is more accurate but slower to compute'}" />
                    <TextBlock Grid.Row="12" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Шаг строк, мм', En='Line interval, mm'}" />
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding StepOverMm}" ToolTip="{l:Tr 'Чистовой проход: 10–20 % диаметра сферической фрезы', En='Finishing pass: 10–20 % of the ball nose diameter'}" />
                    <TextBlock Grid.Row="13" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Направление строк', En='Line direction'}" />
                    <ComboBox Grid.Row="13" Grid.Column="1" ItemsSource="{x:Static vm:Choices.RasterAxes}" ToolTip="{l:Tr 'Направление строк обработки: вдоль X или вдоль Y', En='Direction of the machining lines: along X or along Y'}"
