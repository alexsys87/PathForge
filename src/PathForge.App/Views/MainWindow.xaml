                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Мощность мин., %', En='Min power, %'}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PowerMinPercent}" ToolTip="{l:Tr 'Мощность для самых светлых выжигаемых точек (обычно 0–20 %)', En='Power for the lightest burnt spots (usually 0–20 %)'}" />
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Мощность макс., %', En='Max power, %'}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PowerMaxPercent}" ToolTip="{l:Tr 'Мощность для самых тёмных точек (обычно 40–100 %)', En='Power for the darkest spots (usually 40–100 %)'}" />
                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Скорость, мм/мин', En='Speed, mm/min'}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Speed}" ToolTip="{l:Tr 'Скорость строк гравировки, мм/мин', En='Speed of the engraving lines, mm/min'}" />
                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Перебег, мм', En='Overscan, mm'}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Overscan}" ToolTip="{l:Tr 'Заезд за края картинки: там лазер разгоняется и выключается', En='Travel past the picture edges: the laser accelerates and switches off there'}" />
                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Оттенки', En='Shades'}" />
                    <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{x:Static vm:Choices.RasterModulations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Modulation}"
                              ToolTip="{l:Tr 'Мощностью — тёмное выжигается сильнее при постоянной скорости. Скоростью — мощность постоянная (макс.), тёмное идёт медленнее: для диодных лазеров, у которых мощность плохо следует за S (на малых значениях не жжёт, потом сразу сильно).', En='By power — dark areas get more power at constant speed. By speed — the power is constant (max), dark areas go slower: for diode lasers whose power follows S poorly (nothing at low values, then suddenly too much).'}" />
                    <TextBlock Grid.Row="12" Style="{StaticResource FieldLabel}" Text="{l:Tr 'Скорость мин., мм/мин', En='Min speed, mm/min'}" />
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SpeedMin}"
                             ToolTip="{l:Tr 'Только для оттенков скоростью: скорость самых тёмных точек. «Скорость» выше — для самых светлых выжигаемых.', En='Only for shades by speed: the speed of the darkest spots. “Speed” above is for the lightest burnt ones.'}" />
                    <StackPanel Grid.Row="10" Grid.Column="1">
                        <CheckBox Content="{l:Tr 'Инверсия (выжигать светлое)', En='Invert (burn light areas)'}" IsChecked="{Binding Invert}" ToolTip="{l:Tr 'Выжигать светлые места вместо тёмных', En='Burn the light areas instead of the dark ones'}" />
                        <CheckBox Content="{l:Tr 'В обе стороны', En='Bidirectional'}" IsChecked="{Binding Bidirectional}" ToolTip="{l:Tr 'Гравировать в обе стороны: вдвое быстрее, но возможен сдвиг строк', En='Engrave in both directions: twice as fast, but the lines may shift'}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReliefOperationViewModel}">
            <StackPanel>
