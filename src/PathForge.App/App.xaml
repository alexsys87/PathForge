<Application x:Class="PathForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Colour theme: replaced at run time (see WpfAppearanceService), must stay first -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock" x:Key="FieldLabel">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3,8,3" />
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="SectionHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>
            <Style TargetType="Button" x:Key="ToolBarButton" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
