<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- PathForge demo: an LED with a resistor and a decoupling capacitor, GND pour on the bottom. -->
<eagle version="9.6.2">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
</settings>
<grid distance="0.05" unitdist="inch" unit="inch" style="lines" multiple="1" display="no" altdistance="0.025" altunitdist="inch" altunit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="29" name="tStop" color="7" fill="3" visible="no" active="yes"/>
<layer number="30" name="bStop" color="7" fill="6" visible="no" active="yes"/>
<layer number="31" name="tCream" color="7" fill="4" visible="no" active="yes"/>
<layer number="32" name="bCream" color="7" fill="5" visible="no" active="yes"/>
<layer number="44" name="Drills" color="7" fill="1" visible="no" active="yes"/>
<layer number="45" name="Holes" color="7" fill="1" visible="no" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="30" y2="0" width="0" layer="20"/>
<wire x1="30" y1="0" x2="30" y2="17" width="0" layer="20"/>
<wire x1="30" y1="17" x2="27" y2="20" width="0" layer="20" curve="90"/>
<wire x1="27" y1="20" x2="0" y2="20" width="0" layer="20"/>
<wire x1="0" y1="20" x2="0" y2="0" width="0" layer="20"/>
<hole x="3" y="3" drill="3.2"/>
<hole x="27" y="3" drill="3.2"/>
<text x="8" y="17" size="1.5" layer="21">PathForge</text>
</plain>
<libraries>
<library name="pathforge-demo">
<packages>
<package name="R0805">
<smd name="1" x="-0.95" y="0" dx="1" dy="1.3" layer="1"/>
<smd name="2" x="0.95" y="0" dx="1" dy="1.3" layer="1"/>
<text x="-1" y="1" size="0.8" layer="25">&gt;NAME</text>
</package>
<package name="C0603">
<smd name="1" x="-0.75" y="0" dx="0.8" dy="0.9" layer="1"/>
<smd name="2" x="0.75" y="0" dx="0.8" dy="0.9" layer="1"/>
</package>
<package name="LED5MM">
<pad name="1" x="-1.27" y="0" drill="0.8" shape="square"/>
<pad name="2" x="1.27" y="0" drill="0.8"/>
<circle x="0" y="0" radius="2.8" width="0.2" layer="21"/>
</package>
<package name="PINHEAD2">
<pad name="1" x="0" y="-1.27" drill="1" shape="long"/>
<pad name="2" x="0" y="1.27" drill="1" shape="long"/>
<wire x1="-1.27" y1="-2.54" x2="1.27" y2="-2.54" width="0.2" layer="21"/>
<wire x1="1.27" y1="-2.54" x2="1.27" y2="2.54" width="0.2" layer="21"/>
<wire x1="1.27" y1="2.54" x2="-1.27" y2="2.54" width="0.2" layer="21"/>
<wire x1="-1.27" y1="2.54" x2="-1.27" y2="-2.54" width="0.2" layer="21"/>
</package>
</packages>
</library>
</libraries>
<designrules name="default">
<param name="mdWireWire" value="8mil"/>
<param name="mdWirePad" value="8mil"/>
<param name="mdWireVia" value="8mil"/>
<param name="mdCopperDimension" value="40mil"/>
<param name="rvPadTop" value="0.25"/>
<param name="rlMinPadTop" value="10mil"/>
<param name="rlMaxPadTop" value="20mil"/>
<param name="rvPadBottom" value="0.25"/>
<param name="rlMinPadBottom" value="10mil"/>
<param name="rlMaxPadBottom" value="20mil"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rlMinViaOuter" value="8mil"/>
<param name="rlMaxViaOuter" value="20mil"/>
<param name="mvStopFrame" value="1"/>
<param name="mlMinStopFrame" value="4mil"/>
<param name="mlMaxStopFrame" value="4mil"/>
<param name="mlViaStopLimit" value="100mil"/>
</designrules>
<elements>
<element name="J1" library="pathforge-demo" package="PINHEAD2" value="" x="4" y="10"/>
<element name="R1" library="pathforge-demo" package="R0805" value="330" x="12" y="10"/>
<element name="LED1" library="pathforge-demo" package="LED5MM" value="red" x="21" y="10" rot="R90"/>
<element name="C1" library="pathforge-demo" package="C0603" value="100n" x="12" y="5" rot="MR90"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="J1" pad="1"/>
<contactref element="R1" pad="1"/>
<contactref element="C1" pad="1"/>
<wire x1="4" y1="8.73" x2="8" y2="8.73" width="0.4" layer="1"/>
<wire x1="8" y1="8.73" x2="11.05" y2="10" width="0.4" layer="1"/>
<wire x1="8" y1="8.73" x2="9" y2="7" width="0.4" layer="1"/>
<via x="9" y="7" extent="1-16" drill="0.6"/>
<wire x1="9" y1="7" x2="12" y2="4.25" width="0.4" layer="16"/>
</signal>
<signal name="N$1">
<contactref element="R1" pad="2"/>
<contactref element="LED1" pad="1"/>
<wire x1="12.95" y1="10" x2="19" y2="10" width="0.4" layer="1"/>
<wire x1="19" y1="10" x2="21" y2="8.73" width="0.4" layer="1"/>
</signal>
<signal name="GND">
<contactref element="J1" pad="2"/>
<contactref element="LED1" pad="2"/>
<contactref element="C1" pad="2"/>
<wire x1="12" y1="5.75" x2="14" y2="7" width="0.4" layer="16"/>
<via x="14" y="7" extent="1-16" drill="0.6"/>
<polygon width="0.3" layer="16" isolate="0.4">
<vertex x="1" y="1"/>
<vertex x="29" y="1"/>
<vertex x="29" y="19"/>
<vertex x="1" y="19"/>
</polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
